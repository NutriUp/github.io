					<Item class="Script" referent="RBX5872754A03F64FDE97CAED87168D6EE4">
						<Properties>
							<ProtectedString name="Source">local on = false 

function check() 
	local n = tonumber(string.sub(game.Lighting.TimeOfDay,1,2)) 
	if ((n &gt; 6) and (n &lt; 18)) then 
		if (on) then 
			on = false 
			wait(math.random()*5) 
			for i = 1,5 do 
				script.Parent.Light.Transparency = script.Parent.Light.Transparency + 0.1 
				wait() 
			end 
			script.Parent.Light.Transparency = 1 
		end 
	elseif not (on) then 
		on = true 
		wait(math.random()*5) 
		for i = 1,5 do 
			script.Parent.Light.Transparency = script.Parent.Light.Transparency - 0.1 
			wait() 
		end 
		script.Parent.Light.Transparency = 0.5 
	end 
end 

game.Lighting.LightingChanged:connect(check) 
check() </ProtectedString>
