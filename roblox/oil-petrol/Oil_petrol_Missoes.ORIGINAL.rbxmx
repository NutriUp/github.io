Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><Color3uint8 name="Color3uint8">4294902015</Color3uint8><token name="Material">272</token><string name="Name">CrateSpawn_4</string><float name="Transparency">1</float><Vector3 name="size"><X>2.0000</X><Y>1.0000</Y><Z>2.0000</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX53EF1392BED245D49FA4AC95DF10B9D9"><Properties><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-1157.0000</X><Y>78.2063</Y><Z>1268.0000</Z><R00>-0.739940</R00><R01>0.000000</R01><R02>-0.672673</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.672673</R20><R21>0.000000</R21><R22>-0.739940</R22></CoordinateFrame><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><Color3uint8 name="Color3uint8">4281809988</Color3uint8><token name="Material">1088</token><string name="Name">HeliConsole</string><float name="Transparency">0</float><Vector3 name="size"><X>3.4000</X><Y>3.0000</Y><Z>1.0000</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX6AAFCDBDF59449128404AE42AED9BAAA"><Properties><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-1157.0000</X><Y>76.5063</Y><Z>1268.0000</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><Color3uint8 name="Color3uint8">4282137665</Color3uint8><token name="Material">1088</token><string name="Name">HeliConsoleLeg</string><float name="Transparency">0</float><Vector3 name="size"><X>0.6000</X><Y>1.0000</Y><Z>0.6000</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBXF8BE23974BAE4EE1B4EA08CD78B8AB4E"><Properties><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-1140.4000</X><Y>157.2000</Y><Z>1291.5000</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><Color3uint8 name="Color3uint8">4294902015</Color3uint8><token name="Material">272</token><string name="Name">FlareTip</string><float name="Transparency">1</float><Vector3 name="size"><X>1.0000</X><Y>1.0000</Y><Z>1.0000</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item></Item><Item class="Folder" referent="RBX2F7228C9E4084A569D30DAC4963E677E"><Properties><string name="Name">OilRig</string></Properties><Item class="Script" referent="RBX3CCCD79EBAE44B7A898B70D834953140"><Properties><bool name="Disabled">false</bool><string name="Name">Core</string><token name="RunContext">0</token><ProtectedString name="Source">-- OIL RIG • Núcleo. Inicializa remotes, sistemas, missões e instala o HUD em cada jogador.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local rig = script.Parent                 -- pasta OilRig
local model = rig.Parent                  -- modelo da plataforma
local objects = model:WaitForChild("RigObjects")
local modules = rig:WaitForChild("Modules")

local Config = require(modules.Config)
local Bus = require(modules.Bus)
local State = require(modules.State)
local Util = require(modules.Util)

-- Remotes
local remotes = RS:FindFirstChild("OilRigRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "OilRigRemotes"
	remotes.Parent = RS
end
local function remote(name)
	local r = remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotes
	end
	return r
end

local cf, size = model:GetBoundingBox()
local ctx = {
	Rig = rig, Model = model, Objects = objects,
	Config = Config, Bus = Bus, State = State, Util = Util,
	Remotes = { Notify = remote("Notify"), Radio = remote("Radio"), Shake = remote("Shake") },
	Systems = {}, Center = cf.Position,
}

State.Set("RigCenter", cf.Position)
State.Set("RigRadius", math.max(size.X, size.Z) / 2 + Config.Hud.ExtraRadius)
State.Set("Power", true)
State.Set("Alarm", false)
State.Set("Pressure", Config.Pressure.Start)

-- Sistemas (ordem importa para Init)
local order = { "Radio", "Alarm", "Pressure", "Power", "Fire", "Cargo", "Crane", "Helicopter", "Inspection" }
local folder = modules.Systems
for _, name in ipairs(order) do
	local ms = folder:FindFirstChild(name)
	if ms then
		local ok, mod = pcall(require, ms)
		if ok then ctx.Systems[name] = mod else warn("[OilRig] falha ao carregar " .. name .. ": " .. tostring(mod)) end
	end
end
for _, name in ipairs(order) do
	local mod = ctx.Systems[name]
	if mod and mod.Init then
		local ok, err = pcall(mod.Init, ctx)
		if not ok then warn("[OilRig] erro em " .. name .. ".Init: " .. tostring(err)) end
	end
end

local Missions = require(modules.Missions)
ctx.Missions = Missions
Missions.Init(ctx)

-- HUD do cliente
local template = rig.Client:FindFirstChild("RigHUD")
local function install(player)
	task.spawn(function()
		local pg = player:WaitForChild("PlayerGui", 30)
		if not pg or pg:FindFirstChild("OilRigHUD") then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "OilRigHUD"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 6
		template:Clone().Parent = gui
		gui.Parent = pg
	end)
end
Players.PlayerAdded:Connect(install)
for _, p in ipairs(Players:GetPlayers()) do install(p) end

print("[OilRig] sistemas ativos: pressão, energia, fogo, carga, guindaste, helicóptero, inspeção, missões")
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX7EA95612884D47DA8E55101CEFC0AAC1"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX7DEAAC7391B345B98EBF717BC5E3F4A8"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- OIL RIG • Configuração central. Ajuste tudo aqui sem mexer nos sistemas.
local Config = {}

Config.Director = {
	AutoStart = true,      -- sorteia missões automaticamente
	FirstDelay = 25,       -- segundos até a 1a missão
	MinGap = 30,           -- intervalo mínimo entre missões
	MaxGap = 70,           -- intervalo máximo entre missões
}

Config.Pressure = {
	Min = 0, Max = 130, Start = 40,
	Safe = 60, Warn = 85, Critical = 108,
	DriftPerSec = 0.22,    -- subida natural (só com jogadores no servidor)
	ValveRelease = 14,     -- quanto cada válvula alivia
	ValveCooldown = 6,
	ExplosionHold = 9,     -- segundos acima do crítico até estourar
	OverloadDamage = 45,
}

Config.Power = {
	BreakerHold = 2,
	GeneratorHold = 3,
	LampRange = 30,
	LampBrightness = 1.6,
}

Config.Fire = {
	Damage = 6,            -- dano/seg a quem fica perto do fogo
	DamageRadius = 6,
	ExtinguishRange = 17,
	HitPower = 30,         -- por acionamento do extintor
}

Config.Cargo = {
	CarrySpeed = 11,
	NormalSpeed = 16,
}

Config.Rewards = { FireOut = 10, Valve = 4, Inspect = 12, Barrel = 15, Supply = 25 }

Config.Heli = {
	Distance = 520,        -- distância de onde o helicóptero vem
	Altitude = 70,
	Dwell = 55,            -- segundos pousado
	CrateCount = 3,
}

Config.Crane = {
	Pivot = Vector3.new(-1102.4, 58.5, 1247.5), -- eixo da base giratória
	MaxAngle = 35,
	Step = 10,
	TweenTime = 1.4,
}

Config.Hud = { ExtraRadius = 260 }

-- Cole aqui IDs de som (ex.: rbxassetid://123). Vazio = sem som.
Config.Sounds = {
	Alarm = "", Explosion = "", Valve = "", Generator = "", Blackout = "",
	Heli = "", Complete = "", Fail = "", Extinguisher = "", Radio = "",
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD8B01A9B7B744E6C9A7BD76250670134"><Properties><string name="Name">Bus</string><ProtectedString name="Source">-- Barramento de eventos interno. Missões e sistemas conversam por aqui.
local Bus = {}
local handlers = {}

function Bus.On(name, fn)
	handlers[name] = handlers[name] or {}
	table.insert(handlers[name], fn)
	return {
		Disconnect = function()
			local t = handlers[name]
			local i = t and table.find(t, fn)
			if i then table.remove(t, i) end
		end,
	}
end

function Bus.Fire(name, ...)
	local t = handlers[name]
	if not t then return end
	for _, fn in ipairs(table.clone(t)) do
		task.spawn(fn, ...)
	end
end

return Bus
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0663974D25C24BE295621C3106BAE8DD"><Properties><string name="Name">State</string><ProtectedString name="Source">-- Estado replicado (atributos) lido pelo HUD dos jogadores.
local RS = game:GetService("ReplicatedStorage")
local folder = RS:FindFirstChild("OilRigState")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "OilRigState"
	folder.Parent = RS
end

local State = { Folder = folder }
function State.Set(k, v)
	if folder:GetAttribute(k) ~= v then folder:SetAttribute(k, v) end
end
function State.Get(k) return folder:GetAttribute(k) end
return State
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23ADE15A62574829B90C6A6CD5D465F4"><Properties><string name="Name">Util</string><ProtectedString name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Util = {}

function Util.PlaySound(parent, id, opts)
	if not id or id == "" then return nil end
	opts = opts or {}
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = opts.Volume or 0.6
	s.Looped = opts.Looped or false
	s.RollOffMaxDistance = opts.Range or 140
	s.PlaybackSpeed = opts.Pitch or 1
	s.Parent = parent
	s:Play()
	if not s.Looped then Debris:AddItem(s, 20) end
	return s
end

function Util.Pay(player, amount)
	if not player or not player.Parent or amount &lt;= 0 then return end
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local cash = ls:FindFirstChild("Dinheiro")
	if not cash then
		cash = Instance.new("IntValue")
		cash.Name = "Dinheiro"
		cash.Parent = ls
	end
	cash.Value += math.floor(amount)
end

function Util.Tween(inst, time, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function Util.Root(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

function Util.Humanoid(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

function Util.PlayersNear(pos, radius)
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local r = Util.Root(p)
		if r and (r.Position - pos).Magnitude &lt;= radius then table.insert(out, p) end
	end
	return out
end

function Util.Prompt(parent, action, object, hold, key)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	if key then pp.KeyboardKeyCode = key end
	pp.Parent = parent
	return pp
end

-- Cria um painel (SurfaceGui + 2 textos) numa face de uma peça
function Util.Screen(part, face, title)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Screen"
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.AlwaysOnTop = false
	sg.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(8, 14, 18)
	bg.BorderSizePixel = 0
	bg.Parent = sg
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 0.24)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(255, 150, 30)
	t.Text = title or ""
	t.Parent = bg
	local v = Instance.new("TextLabel")
	v.Name = "Value"
	v.BackgroundTransparency = 1
	v.Position = UDim2.fromScale(0, 0.24)
	v.Size = UDim2.fromScale(1, 0.76)
	v.Font = Enum.Font.GothamBlack
	v.TextScaled = true
	v.TextColor3 = Color3.fromRGB(90, 255, 140)
	v.Text = "--"
	v.Parent = bg
	return v
end

return Util
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBB5683FE26BA405E8B79FCD038695D6F"><Properties><string name="Name">Missions</string><ProtectedString name="Source">-- Motor de missões + diretor. Novas missões = novos ModuleScripts em Modules/MissionDefs.
local Players = game:GetService("Players")
local Missions = {}
local ctx
local defs = {}
local active
local lastId
local seq = 0

local Mission = {}
Mission.__index = Mission

function Mission:Connect(conn) table.insert(self._conns, conn) return conn end
function Mission:Contribute(player) if player then self.Contributors[player] = true end end
function Mission:SetGoal(g)
	self.Goal = g
	ctx.State.Set("MissionGoal", g)
end
function Mission:SetDescription(text) ctx.State.Set("MissionDesc", text) end
function Mission:Set(p)
	if self.Ended then return end
	self.Progress = math.clamp(p, 0, self.Goal)
	ctx.State.Set("MissionProgress", self.Progress)
	if self.Progress &gt;= self.Goal then self:Complete() end
end
function Mission:Add(n) self:Set(self.Progress + (n or 1)) end

local function finish(self, ok, reason)
	if self.Ended then return end
	self.Ended = true
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self.Def.Cleanup then pcall(self.Def.Cleanup, ctx, self) end
	if not ok and self.Def.OnFail then pcall(self.Def.OnFail, ctx, self, reason) end
	if ok then
		local reward = self.Def.Reward or 0
		if self.Def.Duration then
			local left = self.EndsAt - workspace:GetServerTimeNow()
			if left &gt; self.Def.Duration * 0.5 then reward = math.floor(reward * 1.25) end
		end
		local n = 0
		for p in pairs(self.Contributors) do
			if p.Parent then
				ctx.Util.Pay(p, reward)
				n += 1
			end
		end
		ctx.Systems.Radio.Notify("success", "MISSÃO CUMPRIDA: " .. self.Def.Title .. " (+" .. reward .. ")")
		ctx.Systems.Radio.Say("CONTROLE", "Excelente trabalho, equipe. Situação sob controle.")
		ctx.Util.PlaySound(workspace, ctx.Config.Sounds.Complete, { Volume = 0.6 })
		ctx.Bus.Fire("MissionComplete", self.Def.Id)
	else
		ctx.Systems.Radio.Notify("danger", "MISSÃO FALHOU: " .. self.Def.Title)
		ctx.Systems.Radio.Say("CONTROLE", "Perdemos o controle da situação... (" .. tostring(reason) .. ")")
		ctx.Util.PlaySound(workspace, ctx.Config.Sounds.Fail, { Volume = 0.6 })
		ctx.Bus.Fire("MissionFailed", self.Def.Id, reason)
	end
	if active == self then
		active = nil
		for _, k in ipairs({ "MissionId", "MissionTitle", "MissionDesc", "MissionReward" }) do ctx.State.Set(k, "") end
		ctx.State.Set("MissionProgress", 0)
		ctx.State.Set("MissionGoal", 0)
		ctx.State.Set("MissionEndsAt", 0)
	end
end

function Mission:Complete() finish(self, true) end
function Mission:Fail(reason) finish(self, false, reason or "tempo esgotado") end

function Missions.Active() return active end

function Missions.Start(id)
	if active then return false end
	local def = defs[id]
	if not def then return false end
	if def.CanStart and not def.CanStart(ctx) then return false end
	seq += 1
	local m = setmetatable({
		Def = def, Progress = 0, Goal = 1, Contributors = {}, Ended = false, _conns = {}, _seq = seq,
	}, Mission)
	active = m
	lastId = id
	m.EndsAt = def.Duration and (workspace:GetServerTimeNow() + def.Duration) or 0
	ctx.State.Set("MissionId", def.Id)
	ctx.State.Set("MissionTitle", def.Title)
	ctx.State.Set("MissionDesc", def.Description or "")
	ctx.State.Set("MissionReward", def.Reward or 0)
	ctx.State.Set("MissionProgress", 0)
	ctx.State.Set("MissionGoal", 1)
	ctx.State.Set("MissionEndsAt", m.EndsAt)
	ctx.Systems.Radio.Notify("warn", "NOVA MISSÃO: " .. def.Title)
	local ok, err = pcall(def.Start, ctx, m)
	if not ok then
		warn("[OilRig] erro ao iniciar missão " .. id .. ": " .. tostring(err))
		finish(m, false, "erro interno")
		return false
	end
	if def.Duration then
		task.spawn(function()
			while not m.Ended do
				if workspace:GetServerTimeNow() &gt;= m.EndsAt then m:Fail("tempo esgotado") break end
				task.wait(0.5)
			end
		end)
	end
	return true
end

local function pick()
	local pool, total = {}, 0
	for id, def in pairs(defs) do
		if id ~= lastId and (not def.CanStart or def.CanStart(ctx)) then
			local w = def.Weight or 1
			table.insert(pool, { id, w })
			total += w
		end
	end
	if total == 0 then return nil end
	local r = math.random() * total
	for _, e in ipairs(pool) do
		r -= e[2]
		if r &lt;= 0 then return e[1] end
	end
	return pool[1][1]
end

function Missions.StartRandom()
	local id = pick()
	if id then return Missions.Start(id) end
	return false
end

local function loadDefs(folder)
	for _, ms in ipairs(folder:GetChildren()) do
		if ms:IsA("ModuleScript") and not ms.Name:match("^_") then
			local ok, def = pcall(require, ms)
			if ok and type(def) == "table" and def.Id and def.Start then
				defs[def.Id] = def
			else
				warn("[OilRig] definição inválida: " .. ms.Name .. " " .. tostring(def))
			end
		end
	end
end

function Missions.Init(c)
	ctx = c
	local folder = ctx.Rig.MissionDefs
	loadDefs(folder)
	folder.ChildAdded:Connect(function() task.wait(); loadDefs(folder) end)
	ctx.State.Set("MissionId", "")

	-- comando de desenvolvedor: ReplicatedStorage.OilRigState:SetAttribute("ForceMission","fires")
	ctx.State.Folder:GetAttributeChangedSignal("ForceMission"):Connect(function()
		local id = ctx.State.Get("ForceMission")
		if id and id ~= "" then
			if active then active:Fail("cancelada") end
			task.wait(0.2)
			Missions.Start(id)
			ctx.State.Set("ForceMission", "")
		end
	end)

	-- quadro de missões
	local board = ctx.Objects:FindFirstChild("MissionBoard")
	local label
	if board then
		label = ctx.Util.Screen(board, Enum.NormalId.Front, "QUADRO DE MISSÕES")
		local pp = ctx.Util.Prompt(board, "Pedir missão", "Quadro de missões", 0.5)
		pp.Triggered:Connect(function(player)
			if active then
				ctx.Systems.Radio.Notify("warn", "Já existe uma missão em andamento.", player)
			elseif not Missions.StartRandom() then
				ctx.Systems.Radio.Notify("info", "Nenhuma missão disponível agora.", player)
			end
		end)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			if label then
				if active then
					local left = active.EndsAt &gt; 0 and math.max(0, math.floor(active.EndsAt - workspace:GetServerTimeNow())) or nil
					label.Text = active.Def.Title .. "\n" .. math.floor(active.Progress) .. "/" .. active.Goal .. (left and ("  •  " .. left .. "s") or "")
					label.TextColor3 = Color3.fromRGB(255, 190, 60)
				else
					label.Text = "SEM MISSÃO\nSolicite no quadro"
					label.TextColor3 = Color3.fromRGB(90, 255, 140)
				end
			end
		end
	end)

	-- diretor
	local d = ctx.Config.Director
	task.spawn(function()
		task.wait(d.FirstDelay)
		while true do
			if d.AutoStart and not active and #ctx.Util.PlayersNear(ctx.Center, ctx.State.Get("RigRadius") or 400) &gt; 0 then
				Missions.StartRandom()
			end
			while active do task.wait(1) end
			task.wait(math.random(d.MinGap, d.MaxGap))
		end
	end)
end

return Missions
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXF1D8C65F0C964FB4906DC4A12240285C"><Properties><string name="Name">Systems</string></Properties><Item class="ModuleScript" referent="RBXC656C6DB7F884CF899092C3935253D68"><Properties><string name="Name">Radio</string><ProtectedString name="Source">-- Comunicação: rádio do CONTROLE, avisos (toast) e tremor de câmera.
local Radio = {}
local ctx

function Radio.Init(c) ctx = c end

function Radio.Say(speaker, text, player)
	if player then
		ctx.Remotes.Radio:FireClient(player, speaker, text)
	else
		ctx.Remotes.Radio:FireAllClients(speaker, text)
	end
end

-- kind: "info" | "success" | "warn" | "danger"
function Radio.Notify(kind, text, player)
	if player then
		ctx.Remotes.Notify:FireClient(player, kind, text)
	else
		ctx.Remotes.Notify:FireAllClients(kind, text)
	end
end

function Radio.Shake(intensity, duration, position)
	ctx.Remotes.Shake:FireAllClients(intensity, duration, position)
end

return Radio
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9C30A69A9EA74E0EB821F0AD20FA4D99"><Properties><string name="Name">Alarm</string><ProtectedString name="Source">-- Alarme geral: várias razões podem ativá-lo; sirenes piscam até todas cessarem.
local Alarm = {}
local ctx
local reasons = {}
local beacons = {}
local siren

local function anyActive() return next(reasons) ~= nil end

function Alarm.Init(c)
	ctx = c
	for _, m in ipairs(ctx.Objects:GetChildren()) do
		if m.Name:match("^Beacon_") then
			local lamp = m:FindFirstChild("Lamp")
			if lamp then
				local l = Instance.new("PointLight")
				l.Name = "BeaconLight"
				l.Color = Color3.fromRGB(255, 40, 30)
				l.Range = 26
				l.Brightness = 0
				l.Shadows = false
				l.Parent = lamp
				table.insert(beacons, lamp)
			end
		end
	end
	task.spawn(function()
		local on = false
		while true do
			if anyActive() then
				on = not on
				for _, lamp in ipairs(beacons) do
					lamp.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
					lamp.Color = on and Color3.fromRGB(255, 50, 40) or Color3.fromRGB(90, 15, 15)
					lamp.BeaconLight.Brightness = on and 3 or 0
				end
				task.wait(0.35)
			else
				if on or beacons[1] and beacons[1].BeaconLight.Brightness ~= 0 then
					on = false
					for _, lamp in ipairs(beacons) do
						lamp.Material = Enum.Material.SmoothPlastic
						lamp.Color = Color3.fromRGB(90, 15, 15)
						lamp.BeaconLight.Brightness = 0
					end
				end
				task.wait(0.5)
			end
		end
	end)
end

function Alarm.Set(reason, on)
	local was = anyActive()
	reasons[reason] = on and true or nil
	local now = anyActive()
	ctx.State.Set("Alarm", now)
	if now and not was then
		if beacons[1] then siren = ctx.Util.PlaySound(beacons[1], ctx.Config.Sounds.Alarm, { Looped = true, Volume = 0.8, Range = 260 }) end
	elseif was and not now and siren then
		siren:Destroy()
		siren = nil
	end
end

function Alarm.Active() return anyActive() end

return Alarm
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXB61FDC5B461B4C7BBEF090EB88D5C71C"><Properties><string name="Name">Pressure</string><ProtectedString name="Source">-- Pressão do duto principal, válvulas, manômetro e chama do flare.
local Pressure = {}
local ctx, cfg
local value = 0
local valves = {}
local gaugeLabel
local flare, flareFire, flareLight
local overTimer = 0

local function colorFor(v)
	if v &gt;= cfg.Critical then return Color3.fromRGB(255, 60, 50)
	elseif v &gt;= cfg.Warn then return Color3.fromRGB(255, 190, 40)
	end
	return Color3.fromRGB(90, 255, 140)
end

function Pressure.Get() return value end

function Pressure.Set(v)
	value = math.clamp(v, cfg.Min, cfg.Max)
	ctx.State.Set("Pressure", math.floor(value * 10) / 10)
	if gaugeLabel then
		gaugeLabel.Text = string.format("%d PSI", math.floor(value + 0.5))
		gaugeLabel.TextColor3 = colorFor(value)
	end
	if flareFire then
		flareFire.Size = 6 + value / 5
		flareFire.Heat = 8 + value / 10
		flareLight.Brightness = 1 + value / 20
	end
	ctx.Bus.Fire("PressureChanged", value)
end

function Pressure.Add(d) Pressure.Set(value + d) end

-- Estouro: explosão visual + dano em volta dos vazamentos, e alivia a pressão.
function Pressure.Overload()
	local radio = ctx.Systems.Radio
	local points = {}
	for _, o in ipairs(ctx.Objects:GetChildren()) do
		if o.Name:match("^Valve_") and o:FindFirstChild("Wheel") then table.insert(points, o.Wheel) end
	end
	local src = points[math.random(1, math.max(#points, 1))]
	if src then
		local ex = Instance.new("Explosion")
		ex.Position = src.Position + Vector3.new(0, 3, 0)
		ex.BlastPressure = 0
		ex.BlastRadius = 14
		ex.DestroyJointRadiusPercent = 0
		ex.Hit:Connect(function(part)
			local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health &gt; 0 and not ex:GetAttribute("hit_" .. hum:GetFullName()) then
				ex:SetAttribute("hit_" .. hum:GetFullName(), true)
				hum:TakeDamage(cfg.OverloadDamage)
			end
		end)
		ex.Parent = workspace
		ctx.Util.PlaySound(src, ctx.Config.Sounds.Explosion, { Volume = 1, Range = 400 })
		radio.Shake(1.4, 2.2, src.Position)
	end
	radio.Notify("danger", "SOBREPRESSÃO! Duto rompeu.")
	radio.Say("CONTROLE", "Duto rompido! Pressão aliviada à força, avaliem os danos!")
	ctx.Bus.Fire("Overpressure")
	Pressure.Set(cfg.Safe + 8)
	overTimer = 0
end

local function setupValve(model)
	local wheel = model:FindFirstChild("Wheel")
	if not wheel then return end
	local id = tonumber(model.Name:match("%d+"))
	local steam = Instance.new("ParticleEmitter")
	steam.Rate = 0
	steam.Lifetime = NumberRange.new(0.8, 1.6)
	steam.Speed = NumberRange.new(8, 14)
	steam.SpreadAngle = Vector2.new(25, 25)
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 6) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	steam.Color = ColorSequence.new(Color3.fromRGB(235, 240, 245))
	steam.Parent = wheel
	local prompt = ctx.Util.Prompt(wheel, "Abrir válvula", "Válvula " .. id, 1.2)
	local ready = true
	prompt.Triggered:Connect(function(player)
		if not ready then return end
		ready = false
		prompt.Enabled = false
		local base = wheel.CFrame
		local nv = Instance.new("NumberValue")
		nv.Changed:Connect(function(v) wheel.CFrame = base * CFrame.Angles(math.rad(v), 0, 0) end)
		local tw = ctx.Util.Tween(nv, 1.1, { Value = 360 }, Enum.EasingStyle.Sine)
		tw.Completed:Once(function() nv:Destroy() wheel.CFrame = base end)
		steam:Emit(40)
		ctx.Util.PlaySound(wheel, ctx.Config.Sounds.Valve, { Volume = 0.7 })
		Pressure.Add(-cfg.ValveRelease)
		ctx.Util.Pay(player, ctx.Config.Rewards.Valve)
		ctx.Bus.Fire("ValveTurned", player, id)
		task.delay(cfg.ValveCooldown, function()
			ready = true
			prompt.Enabled = true
		end)
	end)
	valves[id] = model
end

function Pressure.Init(c)
	ctx = c
	cfg = ctx.Config.Pressure
	for _, o in ipairs(ctx.Objects:GetChildren()) do
		if o.Name:match("^Valve_") then setupValve(o) end
	end
	local panel = ctx.Objects:FindFirstChild("GaugePanel")
	if panel then gaugeLabel = ctx.Util.Screen(panel, Enum.NormalId.Front, "PRESSÃO DO DUTO") end
	flare = ctx.Objects:FindFirstChild("FlareTip")
	if flare then
		flareFire = Instance.new("Fire")
		flareFire.Size = 8
		flareFire.Heat = 10
		flareFire.Color = Color3.fromRGB(255, 140, 20)
		flareFire.SecondaryColor = Color3.fromRGB(255, 60, 0)
		flareFire.Parent = flare
		flareLight = Instance.new("PointLight")
		flareLight.Color = Color3.fromRGB(255, 150, 60)
		flareLight.Range = 60
		flareLight.Shadows = false
		flareLight.Parent = flare
	end
	Pressure.Set(cfg.Start)

	local warned = false
	task.spawn(function()
		local dt = 0.25
		while true do
			task.wait(dt)
			if #ctx.Util.PlayersNear(ctx.Center, ctx.State.Get("RigRadius") or 400) &gt; 0 then
				local drift = cfg.DriftPerSec * dt
				if math.random() &lt; 0.015 then drift += math.random(2, 6) end -- surtos
				Pressure.Set(value + drift)
			end
			if value &gt;= cfg.Warn and not warned then
				warned = true
				ctx.Systems.Alarm.Set("pressure", true)
				ctx.Systems.Radio.Notify("warn", "Pressão elevada! Abra as válvulas.")
				ctx.Systems.Radio.Say("CONTROLE", "Pressão no limite de alerta. Preciso de alguém nas válvulas.")
			elseif value &lt; cfg.Warn - 10 and warned then
				warned = false
				ctx.Systems.Alarm.Set("pressure", false)
			end
			if value &gt;= cfg.Critical then
				overTimer += dt
				if overTimer &gt;= cfg.ExplosionHold then Pressure.Overload() end
			else
				overTimer = math.max(0, overTimer - dt)
			end
		end
	end)
end

return Pressure
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF7D65A56FC0141DBAE93E608C2225E56"><Properties><string name="Name">Power</string><ProtectedString name="Source">-- Energia: luzes da plataforma, disjuntor e gerador de emergência.
local Power = {}
local ctx, cfg
local lamps = {}     -- { part, light, material, color }
local isOn = true
local breakerReset = true
local breakerPrompt, genPrompt, genPart
local exhaust

local function setLamps(on)
	for _, l in ipairs(lamps) do
		l.part.Material = on and l.material or Enum.Material.SmoothPlastic
		l.part.Color = on and l.color or Color3.fromRGB(30, 30, 30)
		l.light.Brightness = on and cfg.LampBrightness or 0
	end
end

local function flicker(finalOn)
	for _ = 1, 5 do
		setLamps(math.random() &gt; 0.5)
		task.wait(0.07 + math.random() * 0.1)
	end
	setLamps(finalOn)
end

function Power.IsOn() return isOn end

function Power.Blackout()
	if not isOn then return end
	isOn = false
	breakerReset = false
	ctx.State.Set("Power", false)
	ctx.Systems.Radio.Shake(0.5, 1, nil)
	ctx.Util.PlaySound(genPart, ctx.Config.Sounds.Blackout, { Volume = 1, Range = 300 })
	task.spawn(function()
		flicker(false)
		ctx.Systems.Alarm.Set("blackout", true)
	end)
	if exhaust then exhaust.Rate = 0 end
	breakerPrompt.Enabled = true
	genPrompt.Enabled = false
	ctx.Systems.Radio.Notify("danger", "FALHA DE ENERGIA!")
	ctx.Systems.Radio.Say("CONTROLE", "Perdemos a energia! Rearmem o disjuntor e religuem o gerador.")
	ctx.Bus.Fire("Blackout")
end

function Power.Restore(silent)
	if isOn then return end
	isOn = true
	breakerReset = true
	breakerPrompt.Enabled = false
	genPrompt.Enabled = false
	ctx.State.Set("Power", true)
	ctx.Systems.Alarm.Set("blackout", false)
	task.spawn(function() flicker(true) end)
	if exhaust then exhaust.Rate = 12 end
	if not silent then ctx.Systems.Radio.Notify("success", "Energia restabelecida.") end
end

function Power.Init(c)
	ctx = c
	cfg = ctx.Config.Power
	-- lâmpadas existentes (Lightbulb) e novas (RigLamp)
	for _, d in ipairs(ctx.Model:GetDescendants()) do
		if d:IsA("BasePart") and (d.Name == "Lightbulb" or d.Name == "RigLamp") then
			local light = d:FindFirstChild("RigLight") or Instance.new("PointLight")
			light.Name = "RigLight"
			light.Range = cfg.LampRange
			light.Brightness = cfg.LampBrightness
			light.Color = Color3.fromRGB(255, 226, 170)
			light.Shadows = false
			light.Parent = d
			table.insert(lamps, { part = d, light = light, material = d.Material, color = d.Color })
		end
	end
	genPart = ctx.Objects:FindFirstChild("Generator")
	local panel = ctx.Objects:FindFirstChild("BreakerPanel")
	if not genPart or not panel then warn("[OilRig] Gerador/Disjuntor ausentes") return end
	exhaust = Instance.new("ParticleEmitter")
	exhaust.Rate = 12
	exhaust.Lifetime = NumberRange.new(1, 2)
	exhaust.Speed = NumberRange.new(3, 5)
	exhaust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	exhaust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	exhaust.Color = ColorSequence.new(Color3.fromRGB(70, 70, 70))
	exhaust.EmissionDirection = Enum.NormalId.Top
	exhaust.Parent = genPart

	breakerPrompt = ctx.Util.Prompt(panel, "Rearmar disjuntor", "Painel elétrico", cfg.BreakerHold)
	breakerPrompt.Enabled = false
	breakerPrompt.Triggered:Connect(function(player)
		if isOn or breakerReset then return end
		breakerReset = true
		breakerPrompt.Enabled = false
		genPrompt.Enabled = true
		ctx.Systems.Radio.Notify("info", "Disjuntor rearmado. Ligue o gerador.")
		ctx.Bus.Fire("BreakerReset", player)
	end)
	genPrompt = ctx.Util.Prompt(genPart, "Partir gerador", "Gerador de emergência", cfg.GeneratorHold)
	genPrompt.Enabled = false
	genPrompt.Triggered:Connect(function(player)
		if isOn or not breakerReset then return end
		ctx.Util.PlaySound(genPart, ctx.Config.Sounds.Generator, { Volume = 0.9 })
		Power.Restore()
		ctx.Bus.Fire("PowerRestored", player)
	end)
	ctx.State.Set("Power", true)
end

return Power
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX09FFBF8E08B64A6E953DE7630A034A83"><Properties><string name="Name">Fire</string><ProtectedString name="Source">-- Incêndios: focos, dano por proximidade e extintor.
local Players = game:GetService("Players")
local Fire = {}
local ctx, cfg
local active = {}   -- [spot] = { fire, smoke, light, health }
local count = 0

local function refresh()
	ctx.Systems.Alarm.Set("fire", count &gt; 0)
	ctx.State.Set("Fires", count)
end

local function ignite(spot)
	if active[spot] then return false end
	local f = Instance.new("Fire")
	f.Size = 9
	f.Heat = 10
	f.Color = Color3.fromRGB(255, 150, 30)
	f.SecondaryColor = Color3.fromRGB(255, 70, 0)
	f.Parent = spot
	local s = Instance.new("Smoke")
	s.Size = 12
	s.RiseVelocity = 9
	s.Opacity = 0.5
	s.Color = Color3.fromRGB(40, 40, 40)
	s.Parent = spot
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 140, 50)
	l.Range = 26
	l.Brightness = 2.5
	l.Shadows = false
	l.Parent = spot
	active[spot] = { fire = f, smoke = s, light = l, health = 100 }
	count += 1
	refresh()
	return true
end

local function putOut(spot, player)
	local d = active[spot]
	if not d then return end
	d.fire:Destroy() d.smoke:Destroy() d.light:Destroy()
	active[spot] = nil
	count -= 1
	refresh()
	if player then ctx.Util.Pay(player, ctx.Config.Rewards.FireOut) end
	ctx.Bus.Fire("FireOut", player, spot)
end

function Fire.Count() return count end

function Fire.Spawn(n)
	local free = {}
	for _, o in ipairs(ctx.Objects:GetChildren()) do
		if o.Name:match("^FireSpot_") and not active[o] then table.insert(free, o) end
	end
	local made = 0
	while made &lt; n and #free &gt; 0 do
		local i = math.random(1, #free)
		if ignite(free[i]) then made += 1 end
		table.remove(free, i)
	end
	if made &gt; 0 then ctx.Systems.Radio.Notify("danger", "INCÊNDIO detectado na plataforma!") end
	return made
end

function Fire.ExtinguishAll()
	for spot in pairs(table.clone(active)) do putOut(spot, nil) end
end

local function hook(tool, player)
	local last = 0
	tool.Activated:Connect(function()
		local now = os.clock()
		if now - last &lt; 0.25 then return end
		last = now
		local char = tool.Parent
		local handle = tool:FindFirstChild("Handle")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not handle or not root then return end
		local spray = handle:FindFirstChild("Spray")
		if spray then spray:Emit(12) end
		ctx.Util.PlaySound(handle, ctx.Config.Sounds.Extinguisher, { Volume = 0.5 })
		for spot, d in pairs(table.clone(active)) do
			local to = spot.Position - root.Position
			if to.Magnitude &lt;= cfg.ExtinguishRange and to.Unit:Dot(root.CFrame.LookVector) &gt; 0.25 then
				d.health -= cfg.HitPower
				d.fire.Size = 3 + math.max(d.health, 0) / 100 * 6
				if d.health &lt;= 0 then putOut(spot, player) end
			end
		end
	end)
end

local function giveExtinguisher(player)
	local bp = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	if (bp and bp:FindFirstChild("Extintor")) or (char and char:FindFirstChild("Extintor")) then
		ctx.Systems.Radio.Notify("info", "Você já está com o extintor.", player)
		return
	end
	local tool = ctx.Rig.Tools.Extintor:Clone()
	local handle = tool:FindFirstChild("Handle")
	if handle and not handle:FindFirstChild("Spray") then
		local e = Instance.new("ParticleEmitter")
		e.Name = "Spray"
		e.Rate = 0
		e.Lifetime = NumberRange.new(0.4, 0.8)
		e.Speed = NumberRange.new(18, 26)
		e.SpreadAngle = Vector2.new(12, 12)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 3.5) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		e.Color = ColorSequence.new(Color3.fromRGB(245, 245, 250))
		e.EmissionDirection = Enum.NormalId.Front
		e.Parent = handle
	end
	hook(tool, player)
	tool.Parent = bp
	ctx.Systems.Radio.Notify("success", "Extintor equipado.", player)
end

function Fire.Init(c)
	ctx = c
	cfg = ctx.Config.Fire
	local locker = ctx.Objects:FindFirstChild("Locker")
	if locker then
		local pp = ctx.Util.Prompt(locker, "Pegar extintor", "Armário de emergência", 0.6)
		pp.Triggered:Connect(giveExtinguisher)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			if count &gt; 0 then
				for spot in pairs(active) do
					for _, p in ipairs(ctx.Util.PlayersNear(spot.Position, cfg.DamageRadius)) do
						local h = ctx.Util.Humanoid(p)
						if h and h.Health &gt; 0 then h:TakeDamage(cfg.Damage) end
					end
				end
			end
		end
	end)
end

return Fire
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29F975D5AF284F6F81CD2DC8DD1DE138"><Properties><string name="Name">Cargo</string><ProtectedString name="Source">-- Logística de carga: barris, caixas de suprimento e doca de entrega.
local Cargo = {}
local ctx, cfg
local world = {}     -- [part] = kind
local dock

local function carrying(player)
	local bp = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	for _, name in ipairs({ "Barril", "Caixa de Suprimentos" }) do
		local t = (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
		if t then return t end
	end
end

local function giveTool(player, kind)
	if carrying(player) then
		ctx.Systems.Radio.Notify("warn", "Você já está carregando algo.", player)
		return false
	end
	local template = ctx.Rig.Tools:FindFirstChild(kind)
	if not template then return false end
	local tool = template:Clone()
	tool.Equipped:Connect(function()
		local h = tool.Parent and tool.Parent:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = cfg.CarrySpeed end
	end)
	tool.Unequipped:Connect(function()
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = cfg.NormalSpeed end
	end)
	tool.Destroying:Connect(function()
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = cfg.NormalSpeed end
	end)
	tool.Parent = player:FindFirstChildOfClass("Backpack")
	return true
end

local function makeProp(kind, cf)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if kind == "Barril" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(3.2, 2.4, 2.4)
		p.Color = Color3.fromRGB(215, 95, 25)
		p.Material = Enum.Material.Metal
		p.CFrame = cf * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.pi / 2)
		for _, y in ipairs({ -0.9, 0.9 }) do
			local band = Instance.new("Part")
			band.Shape = Enum.PartType.Cylinder
			band.Size = Vector3.new(0.25, 2.5, 2.5)
			band.Color = Color3.fromRGB(40, 40, 40)
			band.Material = Enum.Material.Metal
			band.Anchored = true
			band.CanCollide = false
			band.CFrame = p.CFrame * CFrame.new(y, 0, 0)
			band.Parent = p
		end
	else
		p.Size = Vector3.new(3, 2.4, 3)
		p.Color = Color3.fromRGB(70, 110, 60)
		p.Material = Enum.Material.DiamondPlate
		p.CFrame = cf * CFrame.new(0, 1.3, 0)
	end
	p.Name = kind .. "_Prop"
	local pp = ctx.Util.Prompt(p, "Pegar", kind == "Barril" and "Barril de petróleo" or "Caixa de suprimentos", 0.4)
	pp.Triggered:Connect(function(player)
		if not world[p] then return end
		if giveTool(player, kind == "Barril" and "Barril" or "Caixa de Suprimentos") then
			world[p] = nil
			p:Destroy()
			ctx.Bus.Fire("CargoPicked", player, kind)
		end
	end)
	world[p] = kind
	p.Parent = workspace
	return p
end

function Cargo.SpawnBarrels(n)
	local free = {}
	for _, o in ipairs(ctx.Objects:GetChildren()) do
		if o.Name:match("^BarrelSpawn_") then table.insert(free, o) end
	end
	local made = 0
	while made &lt; n and #free &gt; 0 do
		local i = math.random(1, #free)
		makeProp("Barril", free[i].CFrame * CFrame.new(0, -free[i].Size.Y / 2, 0))
		table.remove(free, i)
		made += 1
	end
	return made
end

function Cargo.SpawnCrates(n)
	local free = {}
	for _, o in ipairs(ctx.Objects:GetChildren()) do
		if o.Name:match("^CrateSpawn_") then table.insert(free, o) end
	end
	local made = 0
	while made &lt; n and #free &gt; 0 do
		local i = math.random(1, #free)
		makeProp("Suprimento", free[i].CFrame * CFrame.new(0, -free[i].Size.Y / 2, 0))
		table.remove(free, i)
		made += 1
	end
	return made
end

function Cargo.Clear(kind)
	for p, k in pairs(table.clone(world)) do
		if not kind or k == kind then
			world[p] = nil
			p:Destroy()
		end
	end
end

function Cargo.Init(c)
	ctx = c
	cfg = ctx.Config.Cargo
	dock = ctx.Objects:FindFirstChild("DockPad")
	if not dock then warn("[OilRig] DockPad ausente") return end
	local pp = ctx.Util.Prompt(dock, "Entregar carga", "Doca de carregamento", 0.3)
	pp.MaxActivationDistance = 14
	pp.Triggered:Connect(function(player)
		local tool = carrying(player)
		if not tool then
			ctx.Systems.Radio.Notify("warn", "Você não está carregando nada.", player)
			return
		end
		local kind = tool.Name == "Barril" and "Barril" or "Suprimento"
		tool:Destroy()
		local reward = kind == "Barril" and ctx.Config.Rewards.Barrel or ctx.Config.Rewards.Supply
		ctx.Util.Pay(player, reward)
		ctx.State.Set("Delivered", (ctx.State.Get("Delivered") or 0) + 1)
		ctx.Systems.Radio.Notify("success", "+" .. reward .. " • carga entregue", player)
		if ctx.Systems.Crane then ctx.Systems.Crane.Flourish() end
		ctx.Bus.Fire("CargoDelivered", player, kind)
	end)
	ctx.State.Set("Delivered", 0)
end

return Cargo
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX227A7F8396504B55AF97A6F847EF25AC"><Properties><string name="Name">Crane</string><ProtectedString name="Source">-- Guindaste: gira a base (todas as peças do modelo "Crane") ao redor do eixo vertical.
local Crane = {}
local ctx, cfg
local crane, origin
local angle = 0
local busy = false
local display

local function applyAngle(deg)
	local pivot = CFrame.new(cfg.Pivot)
	crane:PivotTo(pivot * CFrame.Angles(0, math.rad(deg), 0) * pivot:Inverse() * origin)
end

function Crane.GetAngle() return angle end

function Crane.SetAngle(target, player)
	if busy then return false end
	target = math.clamp(target, -cfg.MaxAngle, cfg.MaxAngle)
	busy = true
	local from = angle
	local nv = Instance.new("NumberValue")
	nv.Value = from
	local conn = nv.Changed:Connect(function(v) applyAngle(v) end)
	local tw = ctx.Util.Tween(nv, cfg.TweenTime, { Value = target }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	tw.Completed:Wait()
	conn:Disconnect()
	nv:Destroy()
	applyAngle(target)
	angle = target
	busy = false
	ctx.State.Set("CraneAngle", angle)
	Crane.Refresh()
	ctx.Bus.Fire("CraneAngle", angle, player)
	return true
end

function Crane.Flourish()
	if busy then return end
	task.spawn(function()
		local back = angle
		Crane.SetAngle(math.clamp(back + 18, -cfg.MaxAngle, cfg.MaxAngle))
		task.wait(0.6)
		Crane.SetAngle(back)
	end)
end

function Crane.Refresh()
	if not display then return end
	local target = ctx.State.Get("CraneTarget")
	if target then
		display.Text = string.format("%d° → ALVO %d°", angle, target)
	else
		display.Text = string.format("%d°", angle)
	end
end

function Crane.Init(c)
	ctx = c
	cfg = ctx.Config.Crane
	for _, d in ipairs(ctx.Model:GetDescendants()) do
		if d:IsA("Model") and d.Name == "Crane" then crane = d break end
	end
	local console = ctx.Objects:FindFirstChild("CraneConsole")
	if not crane or not console then warn("[OilRig] Guindaste ou console ausente") return end
	origin = crane:GetPivot()
	display = ctx.Util.Screen(console, Enum.NormalId.Front, "GUINDASTE")
	Crane.Refresh()
	ctx.State.Set("CraneAngle", 0)
	local right = ctx.Util.Prompt(console, "Girar →", "Guindaste", 0, Enum.KeyCode.E)
	local left = ctx.Util.Prompt(console, "← Girar", "Guindaste", 0, Enum.KeyCode.F)
	left.UIOffset = Vector2.new(0, -70)
	right.Triggered:Connect(function(p) Crane.SetAngle(angle + cfg.Step, p) end)
	left.Triggered:Connect(function(p) Crane.SetAngle(angle - cfg.Step, p) end)
	ctx.State.Folder:GetAttributeChangedSignal("CraneTarget"):Connect(Crane.Refresh)
end

return Crane
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3D22E7D70D494D9BBF29B372E2E01B4D"><Properties><string name="Name">Helicopter</string><ProtectedString name="Source">-- Helicóptero de suprimentos: construído por código, voa até o heliponto, pousa, deixa caixas e decola.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Heli = {}
local ctx, cfg
local running = false
local dismiss = false

local function part(parent, name, size, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	if shape then p.Shape = shape end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Retorna modelo e tabela de partes com deslocamento (CFrame local ao corpo)
local function build()
	local m = Instance.new("Model")
	m.Name = "HelicopteroSuprimentos"
	local body = part(m, "Body", Vector3.new(5, 4.4, 11), Color3.fromRGB(30, 60, 110), Enum.Material.SmoothPlastic)
	local parts = { { body, CFrame.new() } }
	local function add(name, size, color, off, mat, shape, spin)
		local p = part(m, name, size, color, mat, shape)
		table.insert(parts, { p, off, spin })
		return p
	end
	add("Nose", Vector3.new(4.8, 4.2, 4.8), Color3.fromRGB(30, 60, 110), CFrame.new(0, 0, -6), nil, Enum.PartType.Ball)
	add("Glass", Vector3.new(4.4, 2.4, 4), Color3.fromRGB(120, 190, 220), CFrame.new(0, 0.9, -5.2), Enum.Material.Glass)
	parts[#parts][1].Transparency = 0.4
	add("Stripe", Vector3.new(5.1, 0.5, 10), Color3.fromRGB(250, 200, 30), CFrame.new(0, -0.6, 0))
	add("Tail", Vector3.new(1.3, 1.3, 11), Color3.fromRGB(30, 60, 110), CFrame.new(0, 0.8, 10.5))
	add("Fin", Vector3.new(0.35, 4, 2.4), Color3.fromRGB(250, 200, 30), CFrame.new(0, 2.8, 15.2))
	add("TailRotor", Vector3.new(0.12, 3.4, 0.5), Color3.fromRGB(20, 20, 20), CFrame.new(0.9, 3, 15.6), nil, nil, "x")
	add("Mast", Vector3.new(0.8, 1.4, 0.8), Color3.fromRGB(50, 50, 55), CFrame.new(0, 2.9, 0), Enum.Material.Metal)
	add("RotorA", Vector3.new(24, 0.15, 0.9), Color3.fromRGB(20, 20, 20), CFrame.new(0, 3.7, 0), nil, nil, "y")
	add("RotorB", Vector3.new(0.9, 0.15, 24), Color3.fromRGB(20, 20, 20), CFrame.new(0, 3.7, 0), nil, nil, "y")
	for _, s in ipairs({ -2.7, 2.7 }) do
		add("Skid", Vector3.new(0.4, 0.4, 10), Color3.fromRGB(60, 60, 65), CFrame.new(s, -3.4, 0.5), Enum.Material.Metal)
		add("Strut", Vector3.new(0.3, 1.3, 0.3), Color3.fromRGB(60, 60, 65), CFrame.new(s, -2.8, -2.2))
		add("Strut", Vector3.new(0.3, 1.3, 0.3), Color3.fromRGB(60, 60, 65), CFrame.new(s, -2.8, 3.2))
	end
	local navL = add("NavL", Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(255, 30, 30), CFrame.new(-2.6, 0.4, -1), Enum.Material.Neon, Enum.PartType.Ball)
	local navR = add("NavR", Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(40, 255, 70), CFrame.new(2.6, 0.4, -1), Enum.Material.Neon, Enum.PartType.Ball)
	local strobe = add("Strobe", Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(255, 255, 255), CFrame.new(0, 4.1, 15.4), Enum.Material.Neon, Enum.PartType.Ball)
	local spot = add("Spot", Vector3.new(1, 0.4, 1), Color3.fromRGB(255, 255, 230), CFrame.new(0, -2.4, -3), Enum.Material.Neon)
	local sl = Instance.new("SpotLight")
	sl.Face = Enum.NormalId.Bottom
	sl.Range = 140
	sl.Angle = 55
	sl.Brightness = 6
	sl.Shadows = false
	sl.Parent = spot
	return m, parts, strobe
end

function Heli.Active() return running end
function Heli.Dismiss() dismiss = true end

function Heli.Call()
	if running then return false end
	local pad = ctx.Objects:FindFirstChild("HelipadPad")
	if not pad then warn("[OilRig] HelipadPad ausente") return false end
	running = true
	dismiss = false
	task.spawn(function()
		local model, parts, strobe = build()
		model.Parent = workspace
		local list, cfs = {}, {}
		for i, d in ipairs(parts) do list[i] = d[1] end

		local padPos = pad.Position + Vector3.new(0, pad.Size.Y / 2, 0)
		local flat = padPos - ctx.Center
		flat = Vector3.new(flat.X, 0, flat.Z)
		local dir = flat.Magnitude &gt; 1 and flat.Unit or Vector3.new(1, 0, 0)
		local startPos = padPos + dir * cfg.Distance + Vector3.new(0, cfg.Altitude, 0)
		local hover = padPos + Vector3.new(0, 26, 0)
		local land = padPos + Vector3.new(0, 3.7, 0)

		local pos = startPos
		local heading = CFrame.lookAt(Vector3.zero, -dir) -- olha para a plataforma
		local tilt = 0
		local spin = 0
		local alive = true
		local conn = RunService.Heartbeat:Connect(function(dt)
			spin += dt * 38
			local base = CFrame.new(pos) * heading * CFrame.Angles(tilt, 0, 0)
			for i, d in ipairs(parts) do
				local off = d[2]
				if d[3] == "y" then off = off * CFrame.Angles(0, spin, 0)
				elseif d[3] == "x" then off = off * CFrame.Angles(spin * 1.6, 0, 0) end
				cfs[i] = base * off
			end
			workspace:BulkMoveTo(list, cfs, Enum.BulkMoveMode.FireCFrameChanged)
			strobe.Color = (math.floor(os.clock() * 2) % 2 == 0) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
		end)

		local function fly(to, dur, face, maxTilt)
			local from = pos
			local t0 = os.clock()
			local d = to - from
			local flatDir = Vector3.new(d.X, 0, d.Z)
			if face and flatDir.Magnitude &gt; 2 then heading = CFrame.lookAt(Vector3.zero, flatDir.Unit) end
			while alive do
				local a = math.clamp((os.clock() - t0) / dur, 0, 1)
				local e = TweenService:GetValue(a, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				pos = from:Lerp(to, e)
				tilt = -(maxTilt or 0) * math.sin(a * math.pi)
				if a &gt;= 1 then break end
				RunService.Heartbeat:Wait()
			end
			tilt = 0
		end

		heading = CFrame.lookAt(Vector3.zero, -dir)
		ctx.Systems.Radio.Notify("info", "Helicóptero de suprimentos a caminho.")
		ctx.Systems.Radio.Say("PILOTO", "Controle, aqui Águia 2. Chego ao heliponto em instantes, câmbio.")
		fly(hover, 16, true, 0.18)
		ctx.Util.PlaySound(model.Body, ctx.Config.Sounds.Heli, { Looped = true, Volume = 1, Range = 400 })
		-- alinha o nariz com a entrada do heliponto e pousa
		heading = CFrame.lookAt(Vector3.zero, -dir)
		ctx.Systems.Radio.Shake(0.35, 4, padPos)
		fly(land, 7, false, 0)
		ctx.Systems.Radio.Say("PILOTO", "Pousado. Descarreguem as caixas e levem à doca!")
		Heli.Landed = true
		ctx.Systems.Cargo.SpawnCrates(cfg.CrateCount)
		ctx.Bus.Fire("HeliLanded")

		local waited = 0
		while waited &lt; cfg.Dwell and not dismiss do
			task.wait(1)
			waited += 1
		end
		ctx.Systems.Radio.Say("PILOTO", "Decolando. Boa sorte aí embaixo.")
		fly(hover + Vector3.new(0, 14, 0), 6, false, 0)
		local away = padPos + (-dir + Vector3.new(0.4, 0, 0.3)).Unit * cfg.Distance + Vector3.new(0, cfg.Altitude + 30, 0)
		fly(away, 16, true, 0.2)

		alive = false
		conn:Disconnect()
		model:Destroy()
		Heli.Landed = false
		running = false
		ctx.Bus.Fire("HeliGone")
	end)
	return true
end

function Heli.Init(c)
	ctx = c
	cfg = ctx.Config.Heli
	local console = ctx.Objects:FindFirstChild("HeliConsole")
	if console then
		local pp = ctx.Util.Prompt(console, "Chamar helicóptero", "Rádio de pouso", 1)
		pp.Triggered:Connect(function(player)
			if running then
				ctx.Systems.Radio.Notify("warn", "O helicóptero já está em operação.", player)
			else
				Heli.Call()
			end
		end)
	end
end

return Heli
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX65C90E0B25964B4EBD035AEB8A06EE28"><Properties><string name="Name">Inspection</string><ProtectedString name="Source">-- Pontos de inspeção: marcadores luminosos ativados por missões.
local Inspection = {}
local ctx
local points = {}   -- [id] = { model, marker, prompt, done }

function Inspection.Activate(ids)
	for id, p in pairs(points) do
		local on = table.find(ids, id) ~= nil
		p.done = false
		p.prompt.Enabled = on
		p.marker.Transparency = on and 0.35 or 1
		p.marker.Color = Color3.fromRGB(255, 180, 40)
		p.marker.Material = Enum.Material.Neon
	end
end

function Inspection.DeactivateAll()
	for _, p in pairs(points) do
		p.prompt.Enabled = false
		p.marker.Transparency = 1
	end
end

function Inspection.Init(c)
	ctx = c
	for _, m in ipairs(ctx.Objects:GetChildren()) do
		local id = tonumber(m.Name:match("^Checkpoint_(%d+)$"))
		if id then
			local marker = m:FindFirstChild("Marker")
			local term = m:FindFirstChild("Terminal")
			if marker and term then
				local pp = ctx.Util.Prompt(term, "Inspecionar", "Ponto " .. id, 1.5)
				pp.Enabled = false
				marker.Transparency = 1
				local data = { model = m, marker = marker, prompt = pp, done = false }
				points[id] = data
				pp.Triggered:Connect(function(player)
					if data.done then return end
					data.done = true
					pp.Enabled = false
					marker.Color = Color3.fromRGB(80, 255, 140)
					ctx.Util.Tween(marker, 1.2, { Transparency = 1 })
					ctx.Util.Pay(player, ctx.Config.Rewards.Inspect)
					ctx.Systems.Radio.Notify("success", "Ponto " .. id .. " inspecionado", player)
					ctx.Bus.Fire("Inspected", player, id)
				end)
			end
		end
	end
end

return Inspection
</ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX2264A3B755E24CA79399E821D631D8BF"><Properties><string name="Name">MissionDefs</string></Properties><Item class="ModuleScript" referent="RBX0430AB45861247C696CBB087B2189542"><Properties><string name="Name">pressure</string><ProtectedString name="Source">-- Missão: pressão crítica no duto. Gire as válvulas até voltar à faixa segura.
return {
	Id = "pressure", Title = "Pressão Crítica", Weight = 4, Duration = 120, Reward = 160,
	Description = "O duto principal está sobrecarregado. Gire as válvulas até a pressão cair para a faixa segura.",
	Start = function(ctx, m)
		local P = ctx.Systems.Pressure
		local cfg = ctx.Config.Pressure
		local startV = math.max(P.Get(), cfg.Warn + 5)
		P.Set(startV)
		m:SetGoal(100)
		ctx.Systems.Radio.Say("CONTROLE", "Pressão subindo no duto principal! Alguém abre as válvulas, agora!")
		m:Connect(ctx.Bus.On("ValveTurned", function(plr) m:Contribute(plr) end))
		m:Connect(ctx.Bus.On("PressureChanged", function(v)
			m:Set((startV - v) / (startV - cfg.Safe) * 100)
		end))
	end,
	OnFail = function(ctx)
		ctx.Systems.Pressure.Overload()
	end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1DCEFA98D68F46FC9658B4731833920E"><Properties><string name="Name">blackout</string><ProtectedString name="Source">-- Missão: apagão. Rearmar o disjuntor e religar o gerador, nessa ordem.
return {
	Id = "blackout", Title = "Apagão Total", Weight = 3, Duration = 150, Reward = 180,
	Description = "Perdemos a energia. 1) Rearme o disjuntor no painel elétrico. 2) Parta o gerador de emergência.",
	CanStart = function(ctx) return ctx.Systems.Power.IsOn() end,
	Start = function(ctx, m)
		m:SetGoal(2)
		ctx.Systems.Power.Blackout()
		m:Connect(ctx.Bus.On("BreakerReset", function(plr) m:Contribute(plr) m:Set(1) end))
		m:Connect(ctx.Bus.On("PowerRestored", function(plr) m:Contribute(plr) m:Set(2) end))
	end,
	Cleanup = function(ctx)
		if not ctx.Systems.Power.IsOn() then
			task.delay(8, function()
				if not ctx.Systems.Power.IsOn() then
					ctx.Systems.Power.Restore(true)
					ctx.Systems.Radio.Say("CONTROLE", "Equipe de reserva restabeleceu a energia.")
				end
			end)
		end
	end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXFEDC4553F7A1440287B8A77C83CEBE13"><Properties><string name="Name">fires</string><ProtectedString name="Source">-- Missão: focos de incêndio. Pegue o extintor no armário e apague tudo.
return {
	Id = "fires", Title = "Focos de Incêndio", Weight = 4, Duration = 140, Reward = 200,
	Description = "Há incêndios na plataforma! Pegue o extintor no armário de emergência e apague todos os focos.",
	Start = function(ctx, m)
		local n = ctx.Systems.Fire.Spawn(3)
		if n == 0 then m:Complete() return end
		m:SetGoal(n)
		ctx.Systems.Radio.Say("CONTROLE", "Incêndio! Armário de emergência tem extintores. Mirem na base das chamas.")
		m:Connect(ctx.Bus.On("FireOut", function(plr)
			m:Contribute(plr)
			m:Add(1)
		end))
	end,
	Cleanup = function(ctx) ctx.Systems.Fire.ExtinguishAll() end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXE9B022457D554022B27C1FE2B4C00BDE"><Properties><string name="Name">barrels</string><ProtectedString name="Source">-- Missão: entrega de barris de petróleo na doca.
return {
	Id = "barrels", Title = "Carga de Barris", Weight = 3, Duration = 240, Reward = 220,
	Description = "Leve 5 barris de petróleo até a doca de carregamento antes que o navio-tanque parta.",
	Start = function(ctx, m)
		local n = ctx.Systems.Cargo.SpawnBarrels(5)
		if n == 0 then m:Complete() return end
		m:SetGoal(n)
		ctx.Systems.Radio.Say("CONTROLE", "O navio-tanque está esperando. Barris no pátio, levem todos até a doca.")
		m:Connect(ctx.Bus.On("CargoDelivered", function(plr, kind)
			if kind == "Barril" then m:Contribute(plr) m:Add(1) end
		end))
	end,
	Cleanup = function(ctx) ctx.Systems.Cargo.Clear("Barril") end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3A02B5BFF2D94649B8EDE797C7FB8A01"><Properties><string name="Name">airdrop</string><ProtectedString name="Source">-- Missão: helicóptero traz suprimentos; levar as caixas à doca.
return {
	Id = "airdrop", Title = "Suprimentos Aéreos", Weight = 2, Duration = 280, Reward = 260,
	Description = "Um helicóptero está chegando ao heliponto. Pegue as caixas de suprimento e entregue na doca.",
	CanStart = function(ctx) return not ctx.Systems.Helicopter.Active() end,
	Start = function(ctx, m)
		m:SetGoal(ctx.Config.Heli.CrateCount)
		ctx.Systems.Helicopter.Call()
		m:Connect(ctx.Bus.On("CargoDelivered", function(plr, kind)
			if kind == "Suprimento" then m:Contribute(plr) m:Add(1) end
		end))
	end,
	Cleanup = function(ctx)
		ctx.Systems.Helicopter.Dismiss()
		ctx.Systems.Cargo.Clear("Suprimento")
	end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBE743240087E4B0E8FFA8B4EFAB0D93F"><Properties><string name="Name">inspection</string><ProtectedString name="Source">-- Missão: ronda de inspeção em 4 pontos marcados.
return {
	Id = "inspection", Title = "Ronda de Inspeção", Weight = 3, Duration = 200, Reward = 170,
	Description = "Inspecione os 4 pontos marcados com luz laranja espalhados pela plataforma.",
	Start = function(ctx, m)
		m:SetGoal(4)
		ctx.Systems.Inspection.Activate({ 1, 2, 3, 4 })
		ctx.Systems.Radio.Say("CONTROLE", "Inspeção de rotina. Sigam as luzes laranja e confirmem cada ponto.")
		local seen = {}
		m:Connect(ctx.Bus.On("Inspected", function(plr, id)
			if seen[id] then return end
			seen[id] = true
			m:Contribute(plr)
			m:Add(1)
		end))
	end,
	Cleanup = function(ctx) ctx.Systems.Inspection.DeactivateAll() end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCAACD9B809A6490386CA4E528D268CE7"><Properties><string name="Name">crane</string><ProtectedString name="Source">-- Missão: alinhar o guindaste com o ângulo-alvo.
return {
	Id = "crane", Title = "Operação do Guindaste", Weight = 2, Duration = 120, Reward = 140,
	Description = "Gire o guindaste até o ângulo-alvo mostrado no console (tolerância de 3°).",
	Start = function(ctx, m)
		local options = { -28, -20, -12, 12, 20, 28 }
		local target = options[math.random(1, #options)]
		if math.abs(ctx.Systems.Crane.GetAngle() - target) &lt;= 3 then target = -target end
		ctx.State.Set("CraneTarget", target)
		m:SetGoal(1)
		m:SetDescription("Gire o guindaste até " .. target .. "° (tolerância de 3°). Use o console do guindaste: E gira ao lado positivo, F ao negativo.")
		ctx.Systems.Radio.Say("CONTROLE", "Preciso do guindaste alinhado a " .. target .. " graus para a próxima carga.")
		m:Connect(ctx.Bus.On("CraneAngle", function(a, plr)
			if plr then m:Contribute(plr) end
			if math.abs(a - target) &lt;= 3 then m:Set(1) end
		end))
	end,
	Cleanup = function(ctx) ctx.State.Set("CraneTarget", nil) end,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4296ED049E11441193095F3DE56440F0"><Properties><string name="Name">_Template</string><ProtectedString name="Source">-- MODELO DE MISSÃO (nome começa com "_" → ignorado pelo motor). Duplique, renomeie sem "_" e edite.
-- Tudo que a missão conecta com m:Connect(...) é desconectado automaticamente ao terminar.
--
-- ctx.Systems: Pressure, Power, Fire, Cargo, Crane, Helicopter, Inspection, Alarm, Radio
-- ctx.Bus.On("Evento", fn): ValveTurned, PressureChanged, Overpressure, Blackout, BreakerReset,
--   PowerRestored, FireOut, CargoPicked, CargoDelivered, CraneAngle, Inspected, HeliLanded, HeliGone,
--   MissionComplete, MissionFailed
-- m:SetGoal(n)  m:Set(n)  m:Add(n)  m:Contribute(player)  m:Complete()  m:Fail("motivo")
return {
	Id = "meu_id_unico",
	Title = "Título da Missão",
	Description = "Texto exibido no HUD.",
	Weight = 1,        -- chance relativa de ser sorteada
	Duration = 120,    -- segundos (nil = sem limite)
	Reward = 100,      -- pago a quem contribuiu
	CanStart = function(ctx) return true end,
	Start = function(ctx, m)
		m:SetGoal(1)
	end,
	Cleanup = function(ctx, m) end,
	OnFail = function(ctx, m, reason) end,
}
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBXC8F1672ADAF14E80B7A7216219BF8D6A"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBXA748881EAD114A5582593F3819DA3A09"><Properties><bool name="Disabled">false</bool><string name="Name">RigHUD</string><ProtectedString name="Source">-- HUD do cliente: sistemas, missão, rádio, avisos, alarme e tremor de câmera.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui = script.Parent
local state = RS:WaitForChild("OilRigState")
local remotes = RS:WaitForChild("OilRigRemotes")

local ORANGE = Color3.fromRGB(255, 150, 30)
local GREEN = Color3.fromRGB(90, 255, 140)
local YELLOW = Color3.fromRGB(255, 200, 50)
local RED = Color3.fromRGB(255, 70, 60)
local PANEL = Color3.fromRGB(10, 16, 22)

local function corner(o, r) local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, r or 8) c.Parent = o end
local function stroke(o, col, t) local s = Instance.new("UIStroke") s.Color = col or ORANGE s.Thickness = t or 1.5 s.Transparency = 0.35 s.Parent = o end
local function label(parent, text, size, color, font, pos, sz, align)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Font = font or Enum.Font.GothamMedium
	l.Position = pos or UDim2.new()
	l.Size = sz or UDim2.fromScale(1, 1)
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

-- raiz que aparece só perto da plataforma
local root = Instance.new("Frame")
root.Name = "Root"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Visible = false
root.Parent = gui

local vignette = Instance.new("Frame")
vignette.Size = UDim2.fromScale(1, 1)
vignette.BackgroundColor3 = RED
vignette.BackgroundTransparency = 1
vignette.BorderSizePixel = 0
vignette.Parent = root
local vg = Instance.new("UIGradient")
vg.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.25, 1),
	NumberSequenceKeypoint.new(0.75, 1), NumberSequenceKeypoint.new(1, 0.55),
})
vg.Parent = vignette

-- ===== painel de sistemas (esquerda/topo) =====
local sys = Instance.new("Frame")
sys.Position = UDim2.new(0, 14, 0, 70)
sys.Size = UDim2.new(0, 230, 0, 138)
sys.BackgroundColor3 = PANEL
sys.BackgroundTransparency = 0.2
sys.Parent = root
corner(sys, 10) stroke(sys)
label(sys, "SISTEMAS DA PLATAFORMA", 12, ORANGE, Enum.Font.GothamBold, UDim2.new(0, 12, 0, 6), UDim2.new(1, -24, 0, 18))

label(sys, "PRESSÃO", 12, Color3.fromRGB(190, 200, 210), Enum.Font.GothamBold, UDim2.new(0, 12, 0, 30), UDim2.new(0, 70, 0, 16))
local pVal = label(sys, "0 PSI", 12, GREEN, Enum.Font.GothamBold, UDim2.new(1, -92, 0, 30), UDim2.new(0, 80, 0, 16), Enum.TextXAlignment.Right)
local pBack = Instance.new("Frame")
pBack.Position = UDim2.new(0, 12, 0, 50)
pBack.Size = UDim2.new(1, -24, 0, 10)
pBack.BackgroundColor3 = Color3.fromRGB(30, 40, 50)
pBack.BorderSizePixel = 0
pBack.Parent = sys
corner(pBack, 5)
local pFill = Instance.new("Frame")
pFill.Size = UDim2.fromScale(0.3, 1)
pFill.BackgroundColor3 = GREEN
pFill.BorderSizePixel = 0
pFill.Parent = pBack
corner(pFill, 5)

local function pill(text, y)
	local f = Instance.new("Frame")
	f.Position = UDim2.new(0, 12, 0, y)
	f.Size = UDim2.new(1, -24, 0, 22)
	f.BackgroundColor3 = Color3.fromRGB(20, 30, 38)
	f.BorderSizePixel = 0
	f.Parent = sys
	corner(f, 6)
	label(f, text, 12, Color3.fromRGB(190, 200, 210), Enum.Font.GothamBold, UDim2.new(0, 8, 0, 0), UDim2.new(0.5, 0, 1, 0))
	return label(f, "--", 12, GREEN, Enum.Font.GothamBold, UDim2.new(0.5, 0, 0, 0), UDim2.new(0.5, -8, 1, 0), Enum.TextXAlignment.Right)
end
local powerL = pill("ENERGIA", 68)
local alarmL = pill("ALARME", 94)
local deliverL = pill("ENTREGAS", 120 - 0)
sys.Size = UDim2.new(0, 230, 0, 150)

-- ===== cartão de missão (direita) =====
local card = Instance.new("Frame")
card.AnchorPoint = Vector2.new(1, 0)
card.Position = UDim2.new(1, -14, 0, 70)
card.Size = UDim2.new(0, 290, 0, 150)
card.BackgroundColor3 = PANEL
card.BackgroundTransparency = 0.2
card.Visible = false
card.Parent = root
corner(card, 10) stroke(card)
local mTag = label(card, "MISSÃO", 11, ORANGE, Enum.Font.GothamBold, UDim2.new(0, 12, 0, 6), UDim2.new(1, -24, 0, 14))
local mTitle = label(card, "", 17, Color3.new(1, 1, 1), Enum.Font.GothamBlack, UDim2.new(0, 12, 0, 20), UDim2.new(1, -24, 0, 22))
local mDesc = label(card, "", 12, Color3.fromRGB(200, 210, 220), Enum.Font.Gotham, UDim2.new(0, 12, 0, 44), UDim2.new(1, -24, 0, 52))
mDesc.TextWrapped = true
mDesc.TextYAlignment = Enum.TextYAlignment.Top
local mBack = Instance.new("Frame")
mBack.Position = UDim2.new(0, 12, 1, -42)
mBack.Size = UDim2.new(1, -24, 0, 10)
mBack.BackgroundColor3 = Color3.fromRGB(30, 40, 50)
mBack.BorderSizePixel = 0
mBack.Parent = card
corner(mBack, 5)
local mFill = Instance.new("Frame")
mFill.Size = UDim2.fromScale(0, 1)
mFill.BackgroundColor3 = ORANGE
mFill.BorderSizePixel = 0
mFill.Parent = mBack
corner(mFill, 5)
local mProg = label(card, "", 12, Color3.new(1, 1, 1), Enum.Font.GothamBold, UDim2.new(0, 12, 1, -28), UDim2.new(0.5, 0, 0, 18))
local mTime = label(card, "", 12, YELLOW, Enum.Font.GothamBold, UDim2.new(0.5, 0, 1, -28), UDim2.new(0.5, -12, 0, 18), Enum.TextXAlignment.Right)

-- ===== rádio (baixo-esquerda) =====
local radio = Instance.new("Frame")
radio.AnchorPoint = Vector2.new(0, 1)
radio.Position = UDim2.new(0, 14, 1, -120)
radio.Size = UDim2.new(0, 320, 0, 118)
radio.BackgroundColor3 = PANEL
radio.BackgroundTransparency = 0.3
radio.Parent = root
corner(radio, 10) stroke(radio, Color3.fromRGB(80, 200, 255))
label(radio, "RÁDIO", 11, Color3.fromRGB(80, 200, 255), Enum.Font.GothamBold, UDim2.new(0, 12, 0, 4), UDim2.new(1, -24, 0, 14))
local radioList = Instance.new("Frame")
radioList.Position = UDim2.new(0, 12, 0, 20)
radioList.Size = UDim2.new(1, -24, 1, -26)
radioList.BackgroundTransparency = 1
radioList.ClipsDescendants = true
radioList.Parent = radio
local rl = Instance.new("UIListLayout")
rl.SortOrder = Enum.SortOrder.LayoutOrder
rl.VerticalAlignment = Enum.VerticalAlignment.Bottom
rl.Padding = UDim.new(0, 3)
rl.Parent = radioList
local radioN = 0

local function say(speaker, text)
	radioN += 1
	local l = Instance.new("TextLabel")
	l.LayoutOrder = radioN
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, 30)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Size = UDim2.new(1, 0, 0, 0)
	l.TextWrapped = true
	l.RichText = true
	l.Font = Enum.Font.Gotham
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = Color3.fromRGB(225, 235, 240)
	local col = speaker == "PILOTO" and "#7fd0ff" or "#ffb347"
	l.Text = string.format('&lt;font color="%s"&gt;&lt;b&gt;[%s]&lt;/b&gt;&lt;/font&gt; %s', col, speaker, text)
	l.MaxVisibleGraphemes = 0
	l.Parent = radioList
	task.spawn(function()
		local n = #l.ContentText
		local total = utf8.len(l.ContentText) or n
		for i = 1, total, 2 do
			l.MaxVisibleGraphemes = i
			task.wait(0.012)
		end
		l.MaxVisibleGraphemes = -1
	end)
	-- remove os antigos
	local kids = {}
	for _, c in ipairs(radioList:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
	table.sort(kids, function(a, b) return a.LayoutOrder &lt; b.LayoutOrder end)
	while #kids &gt; 5 do table.remove(kids, 1):Destroy() end
	task.delay(25, function()
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(1), { TextTransparency = 1 }):Play()
			task.wait(1)
			l:Destroy()
		end
	end)
end

-- ===== avisos (toast) =====
local toastHolder = Instance.new("Frame")
toastHolder.AnchorPoint = Vector2.new(0.5, 0)
toastHolder.Position = UDim2.new(0.5, 0, 0, 74)
toastHolder.Size = UDim2.new(0, 360, 0, 200)
toastHolder.BackgroundTransparency = 1
toastHolder.Parent = root
local tl = Instance.new("UIListLayout")
tl.Padding = UDim.new(0, 6)
tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
tl.SortOrder = Enum.SortOrder.LayoutOrder
tl.Parent = toastHolder
local toastN = 0
local KIND = { info = Color3.fromRGB(80, 200, 255), success = GREEN, warn = YELLOW, danger = RED }

local function toast(kind, text)
	toastN += 1
	local f = Instance.new("Frame")
	f.LayoutOrder = toastN
	f.Size = UDim2.new(0, 340, 0, 34)
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 1
	f.Parent = toastHolder
	corner(f, 8)
	local col = KIND[kind] or KIND.info
	stroke(f, col, 2)
	local t = label(f, text, 14, col, Enum.Font.GothamBold, UDim2.new(0, 10, 0, 0), UDim2.new(1, -20, 1, 0), Enum.TextXAlignment.Center)
	t.TextTransparency = 1
	TweenService:Create(f, TweenInfo.new(0.25), { BackgroundTransparency = 0.15 }):Play()
	TweenService:Create(t, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
	task.delay(4, function()
		TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.5)
		f:Destroy()
	end)
end

-- ===== atualização por atributos =====
local function fmtTime(s) return string.format("%d:%02d", math.floor(s / 60), math.floor(s % 60)) end

local function refreshSys()
	local p = state:GetAttribute("Pressure") or 0
	local max = 130
	pVal.Text = string.format("%d PSI", math.floor(p + 0.5))
	local col = p &gt;= 105 and RED or (p &gt;= 85 and YELLOW or GREEN)
	pVal.TextColor3 = col
	pFill.BackgroundColor3 = col
	TweenService:Create(pFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(math.clamp(p / max, 0, 1), 1) }):Play()
	local on = state:GetAttribute("Power") ~= false
	powerL.Text = on and "ONLINE" or "FALHA"
	powerL.TextColor3 = on and GREEN or RED
	local al = state:GetAttribute("Alarm") == true
	alarmL.Text = al and "ATIVO" or "NORMAL"
	alarmL.TextColor3 = al and RED or GREEN
	deliverL.Text = tostring(state:GetAttribute("Delivered") or 0)
	deliverL.TextColor3 = ORANGE
end

local function refreshMission()
	local id = state:GetAttribute("MissionId")
	if not id or id == "" then card.Visible = false return end
	card.Visible = true
	mTitle.Text = state:GetAttribute("MissionTitle") or ""
	mDesc.Text = state:GetAttribute("MissionDesc") or ""
	local g = math.max(state:GetAttribute("MissionGoal") or 1, 1)
	local pr = state:GetAttribute("MissionProgress") or 0
	mProg.Text = string.format("%d%%  •  +%d", math.floor(pr / g * 100), state:GetAttribute("MissionReward") or 0)
	TweenService:Create(mFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(pr / g, 0, 1), 1) }):Play()
end

for _, k in ipairs({ "Pressure", "Power", "Alarm", "Delivered" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshSys)
end
for _, k in ipairs({ "MissionId", "MissionTitle", "MissionDesc", "MissionProgress", "MissionGoal", "MissionReward" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshMission)
end
refreshSys()
refreshMission()

-- relógio da missão + alarme + visibilidade por distância
local blink = 0
task.spawn(function()
	while true do
		task.wait(0.25)
		local ends = state:GetAttribute("MissionEndsAt") or 0
		if card.Visible and ends &gt; 0 then
			local left = math.max(0, ends - workspace:GetServerTimeNow())
			mTime.Text = fmtTime(left)
			mTime.TextColor3 = left &lt; 20 and RED or YELLOW
		else
			mTime.Text = ""
		end
		blink += 1
		local alarm = state:GetAttribute("Alarm") == true
		local target = (alarm and blink % 2 == 0) and 0 or 1
		TweenService:Create(vignette, TweenInfo.new(0.22), { BackgroundTransparency = target }):Play()

		local center = state:GetAttribute("RigCenter")
		local radius = state:GetAttribute("RigRadius") or 400
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		root.Visible = center ~= nil and hrp ~= nil and (hrp.Position - center).Magnitude &lt;= radius
	end
end)

remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
remotes:WaitForChild("Radio").OnClientEvent:Connect(say)

-- tremor de câmera
local shakeEnd, shakePower = 0, 0
remotes:WaitForChild("Shake").OnClientEvent:Connect(function(intensity, duration, pos)
	local scale = 1
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if pos and hrp then
		scale = math.clamp(1 - (hrp.Position - pos).Magnitude / 180, 0.1, 1)
	end
	shakePower = math.max(shakePower, intensity * scale)
	shakeEnd = math.max(shakeEnd, os.clock() + duration)
end)
RunService:BindToRenderStep("OilRigShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeEnd - os.clock()
	if left &gt; 0 then
		local k = math.clamp(left / 1.5, 0, 1) * shakePower
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			* CFrame.Angles(0, 0, math.rad((math.random() - 0.5) * k * 2))
	else
		shakePower = 0
	end
end)
