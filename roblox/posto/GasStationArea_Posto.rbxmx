			<string name="Name">Posto</string>
		</Properties>
		<Item class="Script" referent="RBX013675541D8A4E06A83D506F4289DC6D">
			<Properties>
			<ProtectedString name="Source"><![CDATA[-- POSTO • Núcleo. Inicializa remotes, sistemas, missões e instala o HUD em cada jogador.
-- Estrutura: GasStationArea/{ Convenience Store, Gas Station, PostoObjects, Posto/{Core, Modules, MissionDefs, Client} }
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local posto = script.Parent                 -- pasta Posto
local area = posto.Parent                   -- pasta GasStationArea
local objects = area:WaitForChild("PostoObjects")
local store = area:WaitForChild("Convenience Store")
local station = area:WaitForChild("Gas Station")
local modules = posto:WaitForChild("Modules")

local Config = require(modules.Config)
local Bus = require(modules.Bus)
local State = require(modules.State)
local Util = require(modules.Util)

-- pasta para tudo que for criado em jogo (fogo, poças, NPCs, projéteis)
local runtime = workspace:FindFirstChild("PostoRuntime")
if not runtime then
	runtime = Instance.new("Folder")
	runtime.Name = "PostoRuntime"
	runtime.Parent = workspace
end

-- Remotes
local remotes = RS:FindFirstChild("PostoRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "PostoRemotes"
	remotes.Parent = RS
end
local function remote(name)
	local r = remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotes
	end
	return r
end

-- centro e raio do posto (união das caixas de loja e área de bombas)
local function bounds()
	local lo, hi
	for _, m in ipairs({ store, station }) do
		local cf, size = m:GetBoundingBox()
		local a = cf.Position - size / 2
		local b = cf.Position + size / 2
		lo = lo and Vector3.new(math.min(lo.X, a.X), math.min(lo.Y, a.Y), math.min(lo.Z, a.Z)) or a
		hi = hi and Vector3.new(math.max(hi.X, b.X), math.max(hi.Y, b.Y), math.max(hi.Z, b.Z)) or b
	end
	return (lo + hi) / 2, hi - lo
end
local center, extent = bounds()
local radius = math.max(extent.X, extent.Z) / 2 + Config.Hud.ExtraRadius

local groundRef = objects:FindFirstChild("GroundRef")

local ctx = {
	Posto = posto, Area = area, Objects = objects, Store = store, Station = station, Runtime = runtime,
	Config = Config, Bus = Bus, State = State, Util = Util,
	Remotes = { Notify = remote("Notify"), Radio = remote("Radio"), Shake = remote("Shake"), Popup = remote("Popup"), Flash = remote("Flash") },
	Systems = {}, Center = center, Radius = radius,
	GroundY = groundRef and groundRef.Position.Y or 2.75,
}
Util.Init(ctx)

State.Set("PostoCenter", center)
State.Set("PostoRadius", radius)
State.Set("Cash", Config.Economy.RegisterStart)
State.Set("Power", "on")
State.Set("Alarm", false)

-- limpeza do modelo original: remove os scripts que davam itens via InsertService (agora a Shop cuida)
local removed = 0
for _, d in ipairs(store:GetDescendants()) do
	if d:IsA("Script") and (d.Name:match("^Give") or d.Name == "IceCreamScript") then
		d:Destroy()
		removed += 1
	end
end
-- script antigo de explosão das bombas (não reiniciável) é substituído pelo sistema de Bombas
for _, pump in ipairs(station:GetChildren()) do
	if pump.Name == "GasPump" then
		local old = pump:FindFirstChildOfClass("Script")
		if old then old.Disabled = true end
	end
end

-- validação em runtime: avisa uma vez o que faltar (os sistemas/missões dependentes ficam indisponíveis)
do
	local missing = {}
	for _, n in ipairs({ "MissionBoard", "BreakerPanel", "Generator", "PumpTerminal", "CashierSpot", "StoreDoor_In",
		"StoreDoor_Out", "QueueSlot_1", "StrandedSpot", "Tanker_Start", "Tanker_Park", "Tanker_End", "TankerPort", "TankerRegulator" }) do
		if not objects:FindFirstChild(n) then table.insert(missing, n) end
	end
	for _, pre in ipairs({ "Spawn_Street_", "Flee_", "BoxSpawn_", "ShelfDrop_", "ShutoffValve_", "FireLocker" }) do
		local found = false
		for _, o in ipairs(objects:GetChildren()) do
			if o.Name:sub(1, #pre) == pre then found = true break end
		end
		if not found then table.insert(missing, pre .. "*") end
	end
	if not posto:FindFirstChild("Client") or not posto.Client:FindFirstChild("PostoHUD") then table.insert(missing, "Posto.Client.PostoHUD") end
	if #missing > 0 then warn("[Posto] objetos ausentes em PostoObjects: " .. table.concat(missing, ", ")) end
end

-- marcadores invisíveis em jogo (ficam visíveis no Studio para você mover)
for _, o in ipairs(objects:GetChildren()) do
	if o:IsA("BasePart") and (o.Name:match("^Spawn_") or o.Name:match("^Flee_") or o.Name:match("^QueueSlot_")
		or o.Name:match("^Browse_") or o.Name:match("^PumpSpot_") or o.Name:match("^BoxSpawn_")
		or o.Name:match("^Tanker_") or o.Name:match("^Stranded") or o.Name:match("^Store") or o.Name == "CashierSpot"
		or o.Name == "GroundRef" or o.Name == "DoorSensor") then
		o.Transparency = 1
		o.CanCollide = false
		o.CanQuery = false
	end
end

-- Sistemas (ordem importa para Init)
local order = { "Radio", "Alarm", "Power", "Fire", "Tools", "Pumps", "Reputation", "Shop", "Npc", "Props", "Customers", "Sign", "Jukebox", "Ambience" }
local folder = modules.Systems
for _, name in ipairs(order) do
	local ms = folder:FindFirstChild(name)
	if ms then
		local ok, mod = pcall(require, ms)
		if ok then ctx.Systems[name] = mod else warn("[Posto] falha ao carregar " .. name .. ": " .. tostring(mod)) end
	else
		warn("[Posto] módulo ausente: " .. name)
	end
end
for _, name in ipairs(order) do
	local mod = ctx.Systems[name]
	if mod and mod.Init then
		local ok, err = pcall(mod.Init, ctx)
		if not ok then warn("[Posto] erro em " .. name .. ".Init: " .. tostring(err)) end
	end
end

local Missions = require(modules.Missions)
ctx.Missions = Missions
local okm, errm = pcall(Missions.Init, ctx)
if not okm then warn("[Posto] erro em Missions.Init: " .. tostring(errm)) end

-- HUD do cliente
local template = posto:FindFirstChild("Client") and posto.Client:FindFirstChild("PostoHUD")
local function install(player)
	task.spawn(function()
		-- (não cria mais leaderstats: a economia global ainda não existe — ver Config.Economy)
		if not template then return end
		local pg = player:WaitForChild("PlayerGui", 30)
		if not pg or pg:FindFirstChild("PostoHUD") then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "PostoHUD"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 6
		template:Clone().Parent = gui
		gui.Parent = pg
	end)
end
Players.PlayerAdded:Connect(install)
for _, p in ipairs(Players:GetPlayers()) do install(p) end

print("[Posto] ativo: bombas, energia, fogo, loja, reputação, clientes, NPCs, missões (" .. #Missions.List() .. ") • scripts antigos removidos: " .. removed)
]]></ProtectedString>
