local radio = Instance.new("Frame")
radio.AnchorPoint = Vector2.new(0, 1)
radio.Position = UDim2.new(0, 14, 1, -120)
radio.Size = UDim2.new(0, 320, 0, 118)
radio.BackgroundColor3 = PANEL
radio.BackgroundTransparency = 0.3
radio.Parent = root
corner(radio, 10) stroke(radio, BLUE)
label(radio, "RÁDIO", 11, BLUE, Enum.Font.GothamBold, UDim2.new(0, 12, 0, 4), UDim2.new(1, -24, 0, 14))
local radioList = Instance.new("Frame")
radioList.Position = UDim2.new(0, 12, 0, 20)
radioList.Size = UDim2.new(1, -24, 1, -26)
radioList.BackgroundTransparency = 1
radioList.ClipsDescendants = true
radioList.Parent = radio
local rl = Instance.new("UIListLayout")
rl.SortOrder = Enum.SortOrder.LayoutOrder
rl.VerticalAlignment = Enum.VerticalAlignment.Bottom
rl.Padding = UDim.new(0, 3)
rl.Parent = radioList
local radioN = 0

local function say(speaker, text)
	radioN += 1
	local l = Instance.new("TextLabel")
	l.LayoutOrder = radioN
	l.BackgroundTransparency = 1
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Size = UDim2.new(1, 0, 0, 0)
	l.TextWrapped = true
	l.RichText = true
	l.Font = Enum.Font.Gotham
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = Color3.fromRGB(225, 235, 240)
	l.Text = string.format('<font color="#ffb347"><b>[%s]</b></font> %s', speaker, text)
	l.MaxVisibleGraphemes = 0
	l.Parent = radioList
	task.spawn(function()
		local total = utf8.len(l.ContentText) or #l.ContentText
		for i = 1, total, 2 do
			l.MaxVisibleGraphemes = i
			task.wait(0.012)
		end
		l.MaxVisibleGraphemes = -1
	end)
	local kids = {}
	for _, c in ipairs(radioList:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
	table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	while #kids > 5 do table.remove(kids, 1):Destroy() end
	task.delay(25, function()
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(1), { TextTransparency = 1 }):Play()
			task.wait(1)
			l:Destroy()
		end
	end)
end

-- ===== avisos (toast) =====
local toastHolder = Instance.new("Frame")
toastHolder.AnchorPoint = Vector2.new(0.5, 0)
toastHolder.Position = UDim2.new(0.5, 0, 0, 74)
toastHolder.Size = UDim2.new(0, 380, 0, 220)
toastHolder.BackgroundTransparency = 1
toastHolder.Parent = root
local tl = Instance.new("UIListLayout")
tl.Padding = UDim.new(0, 6)
tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
tl.SortOrder = Enum.SortOrder.LayoutOrder
tl.Parent = toastHolder
local toastN = 0
local KIND = { info = BLUE, success = GREEN, warn = YELLOW, danger = RED }

local function toast(kind, text)
	toastN += 1
	local f = Instance.new("Frame")
	f.LayoutOrder = toastN
	f.Size = UDim2.new(0, 360, 0, 34)
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 1
	f.Parent = toastHolder
	corner(f, 8)
	local col = KIND[kind] or BLUE
	stroke(f, col, 2)
	local t = label(f, text, 13, col, Enum.Font.GothamBold, UDim2.new(0, 10, 0, 0), UDim2.new(1, -20, 1, 0), Enum.TextXAlignment.Center)
	t.TextWrapped = true
	t.TextTransparency = 1
	TweenService:Create(f, TweenInfo.new(0.25), { BackgroundTransparency = 0.15 }):Play()
	TweenService:Create(t, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
	task.delay(4, function()
		TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.5)
		f:Destroy()
	end)
end

-- ===== popup de dinheiro =====
local function popup(text, kind)
	local col = KIND[kind or "success"] or GREEN
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.new(0.5, math.random(-40, 40), 0.55, 0)
	l.Size = UDim2.fromOffset(240, 40)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = 28
	l.TextColor3 = col
	l.TextStrokeTransparency = 0.4
	l.Text = text
	l.ZIndex = 20
	l.Parent = gui
	TweenService:Create(l, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = l.Position - UDim2.fromOffset(0, 90), TextTransparency = 1, TextStrokeTransparency = 1,
	}):Play()
	task.delay(1.4, function() l:Destroy() end)
end

-- ===== atualização =====
local function fmtTime(s) return string.format("%d:%02d", math.floor(s / 60), math.floor(s % 60)) end

local function refreshSys()
	local r = state:GetAttribute("FuelReserve") or 0
	local max = math.max(state:GetAttribute("FuelMax") or 1, 1)
	local k = math.clamp(r / max, 0, 1)
	fuelVal.Text = string.format("%d L", math.floor(r))
	local col = k < 0.15 and RED or (k < 0.3 and YELLOW or GREEN)
	fuelVal.TextColor3 = col
	fuelFill.BackgroundColor3 = col
	TweenService:Create(fuelFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(k, 1) }):Play()
	priceL.Text = string.format("R$ %.2f", state:GetAttribute("FuelPrice") or 0)
	priceL.TextColor3 = YELLOW
	local pw = state:GetAttribute("Power") or "on"
	if pw == "on" then powerL.Text, powerL.TextColor3 = "ONLINE", GREEN
	elseif pw == "emergency" then powerL.Text, powerL.TextColor3 = "GERADOR", YELLOW
	else powerL.Text, powerL.TextColor3 = "FALHA", RED end
	local al = state:GetAttribute("Alarm") == true
	local silent = state:GetAttribute("AlarmSilent") == true
	alarmL.Text = al and (silent and "SILENCIOSO" or "ATIVO") or "NORMAL"
	alarmL.TextColor3 = al and RED or GREEN
	cashL.Text = string.format("R$ %d", math.floor(state:GetAttribute("Cash") or 0))
	cashL.TextColor3 = ORANGE
	local open = state:GetAttribute("StoreOpen") ~= false
	storeL.Text = open and "ABERTA" or "FECHADA"
	storeL.TextColor3 = open and GREEN or RED
end

local function refreshMission()
	local id = state:GetAttribute("MissionId")
	if not id or id == "" then card.Visible = false return end
	card.Visible = true
	mTitle.Text = state:GetAttribute("MissionTitle") or ""
	mDesc.Text = state:GetAttribute("MissionDesc") or ""
	mStep.Text = state:GetAttribute("MissionStep") or ""
	local g = math.max(state:GetAttribute("MissionGoal") or 1, 1)
	local pr = state:GetAttribute("MissionProgress") or 0
	mProg.Text = string.format("%d%%  •  +%d", math.floor(pr / g * 100), state:GetAttribute("MissionReward") or 0)
	TweenService:Create(mFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(pr / g, 0, 1), 1) }):Play()
end

local function refreshRep()
	local lv = player:GetAttribute("PostoLevel") or 1
	local xp = player:GetAttribute("PostoXP") or 0
	local from = player:GetAttribute("PostoXPFrom") or 0
	local to = player:GetAttribute("PostoXPTo") or 1
	repTitle.Text = "REPUTAÇÃO • NÍVEL " .. lv
	local k = 1
	if to > from then k = math.clamp((xp - from) / (to - from), 0, 1) end
	TweenService:Create(repFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(k, 1) }):Play()
	if to > from then repInfo.Text = string.format("%d / %d XP", xp, to) else repInfo.Text = "Nível máximo" end
end

local function refreshOrder()
	local t = player:GetAttribute("PedidoAtual") or ""
	orderChip.Visible = t ~= ""
	orderText.Text = "PEDIDO: " .. t
end

for _, k in ipairs({ "FuelReserve", "FuelMax", "FuelPrice", "Power", "Alarm", "AlarmSilent", "Cash", "StoreOpen" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshSys)
end
for _, k in ipairs({ "MissionId", "MissionTitle", "MissionDesc", "MissionStep", "MissionProgress", "MissionGoal", "MissionReward" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshMission)
end
for _, k in ipairs({ "PostoLevel", "PostoXP", "PostoXPFrom", "PostoXPTo" }) do
	player:GetAttributeChangedSignal(k):Connect(refreshRep)
end
player:GetAttributeChangedSignal("PedidoAtual"):Connect(refreshOrder)
refreshSys() refreshMission() refreshRep() refreshOrder()

-- ===== escala responsiva (celular/tablet) =====
-- Mantém o visual original em telas grandes; em telas menores cada painel encolhe proporcionalmente
-- e as posições acompanham, evitando sobreposição (ex.: rádio por cima da reputação em celular).
local layoutPanels = {
	{ sys, UDim2.new(0, 14, 0, 70) }, { rep, UDim2.new(0, 14, 0, 284) }, { card, UDim2.new(1, -14, 0, 70) },
	{ orderChip, UDim2.new(0.5, 0, 1, -110) }, { radio, UDim2.new(0, 14, 1, -120) }, { toastHolder, UDim2.new(0.5, 0, 0, 74) },
}
for _, e in ipairs(layoutPanels) do
	local s = Instance.new("UIScale")
	s.Name = "EscalaHUD"
	s.Parent = e[1]
	e[3] = s
end
local function layout()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 1 or vp.Y < 1 then return end
	-- (vp.Y - 8) / 574: altura em que a coluna esquerda (até 336) e o rádio (238 a partir de baixo) não se tocam
	local k = math.clamp(math.min(vp.X / 1280, vp.Y / 720, (vp.Y - 8) / 574), 0.5, 1)
	for _, e in ipairs(layoutPanels) do
		local p = e[2]
		e[1].Position = UDim2.new(p.X.Scale, p.X.Offset * k, p.Y.Scale, p.Y.Offset * k)
		e[3].Scale = k
	end
end
local vpConn
local function watchCamera()
	if vpConn then vpConn:Disconnect() end
	local cam = workspace.CurrentCamera
	if cam then vpConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
	layout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

-- zoom dos binóculos
local normalFov = 70
player:GetAttributeChangedSignal("PostoZoom"):Connect(function()
	local cam = workspace.CurrentCamera
	if player:GetAttribute("PostoZoom") then
		normalFov = cam.FieldOfView
		TweenService:Create(cam, TweenInfo.new(0.35), { FieldOfView = 18 }):Play()
	else
		TweenService:Create(cam, TweenInfo.new(0.35), { FieldOfView = normalFov }):Play()
	end
end)

-- relógio, alarme, marcadores e visibilidade por distância
local blink = 0
task.spawn(function()
	while true do
		task.wait(0.25)
		local ends = state:GetAttribute("MissionEndsAt") or 0
		if card.Visible and ends > 0 then
			local left = math.max(0, ends - workspace:GetServerTimeNow())
			mTime.Text = fmtTime(left)
			mTime.TextColor3 = left < 20 and RED or YELLOW
		else
			mTime.Text = ""
		end
		blink += 1
		local alarm = state:GetAttribute("Alarm") == true and state:GetAttribute("AlarmSilent") ~= true
		local target = (alarm and blink % 2 == 0) and 0 or 1
		TweenService:Create(vignette, TweenInfo.new(0.22), { BackgroundTransparency = target }):Play()

		local center = state:GetAttribute("PostoCenter")
		local radius = state:GetAttribute("PostoRadius") or 300
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		root.Visible = center ~= nil and hrp ~= nil and (hrp.Position - center).Magnitude <= radius

		if hrp then
			for _, g in ipairs(CollectionService:GetTagged("PostoMarker")) do
				local part = g.Parent
				local d = g:FindFirstChild("Dist")
				if part and part:IsA("BasePart") and d then
					d.Text = string.format("%d m", math.floor((part.Position - hrp.Position).Magnitude))
				end
			end
		end
	end
end)

remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
remotes:WaitForChild("Radio").OnClientEvent:Connect(say)
remotes:WaitForChild("Popup").OnClientEvent:Connect(popup)
remotes:WaitForChild("Flash").OnClientEvent:Connect(function(duration, color)
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.25
	TweenService:Create(flash, TweenInfo.new(duration or 0.3), { BackgroundTransparency = 1 }):Play()
end)

-- tremor de câmera
local shakeEnd, shakePower = 0, 0
remotes:WaitForChild("Shake").OnClientEvent:Connect(function(intensity, duration, pos)
	local scale = 1
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if pos and hrp then
		scale = math.clamp(1 - (hrp.Position - pos).Magnitude / 200, 0.1, 1)
	end
	shakePower = math.max(shakePower, intensity * scale)
	shakeEnd = math.max(shakeEnd, os.clock() + duration)
end)
RunService:BindToRenderStep("PostoShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeEnd - os.clock()
	if left > 0 then
		local k = math.clamp(left / 1.5, 0, 1) * shakePower
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			* CFrame.Angles(0, 0, math.rad((math.random() - 0.5) * k * 2))
	else
		shakePower = 0
	end
end)
