					<Item class="Script" referent="RBX87C52FA769DA4C4290EF39B1B3CC6B6D">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local display = script.Parent.Display.SurfaceGui.TextBox
local totalDisplay = script.Parent.TotalDisplay.SurfaceGui.TextBox
local customerDisplay = script.Parent.CustomerDisplay.SurfaceGui.TextBox
local total = 0
local input = {}
local sound = script.Parent.Enter.ButtonSound

function buttonPush(button)
	button.CFrame = button.CFrame * CFrame.new(0,-0.03,0)
	wait()
	button.CFrame = button.CFrame * CFrame.new(0,0.03,0)
end

function updateScreen(totalup)
	if totalup == false then
		if #input == 0 then
			display.Text = "0.00"
		else
			if input[1] == "0" then
				table.remove(input, 1) -- antes: índice 0 (erro "position out of bounds" no Output)
			end
			display.Text = table.concat(input)
			local decimal = false
			for i = 1, #input do
				if input[i] == "." then
					decimal = true
				end
			end
			if decimal == false then
				display.Text = display.Text .. ".00"
			end
		end
	else
		display.Text = "0.00"
		total = total + (tonumber(table.concat(input)) or 0)
		totalDisplay.Text = total
		customerDisplay.Text = total
		if total %1 == 0 then
			totalDisplay.Text = totalDisplay.Text .. ".00"
			customerDisplay.Text = customerDisplay.Text .. ".00"
		end
		input = {}
	end
end

for i, v in pairs(script.Parent:GetChildren()) do
	if v:FindFirstChild("ClickDetector") then
		v.ClickDetector.MouseClick:Connect(function()
			if tonumber(v.Name) then
				sound:Play()
				buttonPush(v)
				table.insert(input, v.Name)
				updateScreen(false)
			elseif v.Name == "." then
				sound:Play()
				buttonPush(v)
				local decimal = false
				for i = 1, #input do
					if input[i] == "." then
						decimal = true
					end
				end
				if decimal == false then
					table.insert(input, v.Name)
				end
			elseif v.Name == "Enter" then
				sound:Play()
				buttonPush(v)
				if #input > 0 then
					updateScreen(true)
				end
			elseif v.Name == "Delete" then
				sound:Play()
				buttonPush(v)
				table.remove(input, #input)
				updateScreen(false)
			elseif v.Name == "Clear" then
				sound:Play()
				buttonPush(v)
				input = {}
				total = 0
				display.Text = "0.00"
				totalDisplay.Text = "0.00"
				customerDisplay.Text = "0.00"
			end
		end)
	end
end]]></ProtectedString>
