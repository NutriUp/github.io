		<Item class="Folder" referent="RBX2CAC21E6A5AA4535889A3E6E110C3D66">
			<Properties>

				<string name="Name">MissionDefs</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX14A37655563D41209DB339FFC90CE132">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- MODELO DE MISSÃO (nome começa com "_" → ignorado pelo motor). Duplique, renomeie sem "_" e edite.
-- Tudo que a missão conecta com m:Connect(...) é desconectado automaticamente ao terminar.
--
-- ctx.Systems: Pumps, Power, Fire, Shop, Tools, Reputation, Customers, Npc, Props, Alarm, Radio, Ambience, Jukebox, Sign
-- ctx.Objects: pasta PostoObjects (marcadores e props). ctx.Runtime: pasta onde ficam coisas criadas em jogo.
-- ctx.Bus.On("Evento", fn): ValveClosed, LeakStarted, LeakIgnited, LeakCleaned, PumpExploded, PumpRepaired,
--   FireStarted, FireOut, GeneratorOn, BreakerReset, PowerRestored, PumpsRebooted, Blackout,
--   Purchased, JerrycanBought, JerrycanFilled, CustomerServed, CustomerLeft, FuelLow, FuelEmpty, FuelPrice,
--   LevelUp, ExtinguisherTaken, MissionComplete, MissionFailed, RewardEarned, PoliceAlert
-- Recompensas: ctx.Util.Reward(player, valor, "motivo") (respeita Config.Economy; não paga com a economia desligada)
-- Defeitos reais de equipamento: parte:SetAttribute("Defeito", "texto") / nil (Power, Pumps, Tools, Jukebox respeitam)
-- m:SetGoal(n)  m:Set(n)  m:Add(n)  m:Step("texto")  m:SetTarget(parte)  m:Contribute(player)  m:Complete()  m:Fail("motivo")
-- ctx.Util.Marker(parte, "TEXTO", cor)  /  ctx.Util.Unmark(parte)  /  ctx.Util.Bin()  (limpeza em lote)
return {
	Id = "meu_id_unico",
	Title = "Título da Missão",
	Description = "Texto exibido no HUD.",
	Weight = 1,        -- chance relativa de ser sorteada
	Duration = 120,    -- segundos (nil = sem limite)
	Reward = 100,      -- pago a quem contribuiu (com bônus de reputação)
	XP = 20,           -- reputação ganha por quem contribuiu
	CanStart = function(ctx) return true end,
	Start = function(ctx, m)
		m:SetGoal(1)
	end,
	Cleanup = function(ctx, m) end,
	OnFail = function(ctx, m, reason) end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{34755a5b-a2ea-4411-a5f9-35f63b8096e5}</string>
					<string name="Name">_Template</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA346044A7A614532935DE1AE57BC11D3">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: tempestade derruba a rede. Gerador -> disjuntor -> reiniciar bombas.
return {
	Id = "blackout", Title = "Apagão na Tempestade", Weight = 3, Duration = 180, Reward = 300, XP = 30,
	Description = "Um raio derrubou a energia do posto. Ligue o gerador, rearme o disjuntor e reinicie o terminal das bombas.",
	CanStart = function(ctx)
		local O = ctx.Objects
		return ctx.Systems.Power.Mode() == "on" and not ctx.Systems.Power.Tripped()
			and O:FindFirstChild("Generator") ~= nil and O:FindFirstChild("BreakerPanel") ~= nil and O:FindFirstChild("PumpTerminal") ~= nil
	end,
	Start = function(ctx, m)
		local Bus, Obj = ctx.Bus, ctx.Objects
		m:SetGoal(3)
		m:Step("1) Ligue o gerador (lado sul da loja)")
		ctx.Systems.Ambience.Lightning(3)
		ctx.Systems.Power.Blackout(true)
		ctx.Systems.Radio.Say("CONTROLE", "Raio na rede! O posto está sem energia. Gerador primeiro, depois o disjuntor.")
		local gen = Obj:FindFirstChild("Generator")
		m:SetTarget(gen)
		if gen then ctx.Util.Marker(gen, "GERADOR", Color3.fromRGB(255, 190, 60)) end
		m.marks = { gen }
		m:Connect(Bus.On("GeneratorOn", function(plr)
			m:Contribute(plr)
			m:Add(1)
			ctx.Util.Unmark(gen)
			local br = Obj:FindFirstChild("BreakerPanel")
			m:SetTarget(br)
			if br then ctx.Util.Marker(br, "DISJUNTOR", Color3.fromRGB(255, 190, 60)) end
			table.insert(m.marks, br)
			m:Step("2) Rearme o disjuntor geral")
		end))
		m:Connect(Bus.On("BreakerReset", function(plr)
			m:Contribute(plr)
			m:Add(1)
			ctx.Util.Unmark(Obj:FindFirstChild("BreakerPanel"))
			local t = Obj:FindFirstChild("PumpTerminal")
			m:SetTarget(t)
			if t then ctx.Util.Marker(t, "TERMINAL", Color3.fromRGB(255, 190, 60)) end
			table.insert(m.marks, t)
			m:Step("3) Reinicie o terminal das bombas")
		end))
		m:Connect(Bus.On("PumpsRebooted", function(plr)
			m:Contribute(plr)
			m:Add(1)
		end))
	end,
	Cleanup = function(ctx, m)
		for _, p in ipairs(m.marks or {}) do ctx.Util.Unmark(p) end
		ctx.Systems.Power.ForceOnline()
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{df244ae3-7158-456f-a8ee-633983897db2}</string>
					<string name="Name">blackout</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX460C9DA963674DDE81CAF5350DC6B7FC">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: vazamento numa bomba. Feche a válvula, limpe a poça e apague o fogo antes da explosão.
return {
	Id = "fuel_leak", Title = "Vazamento na Bomba", Weight = 4, Duration = 160, Reward = 280, XP = 30,
	Description = "Uma bomba está vazando combustível! Feche a válvula de emergência, limpe a poça e apague qualquer fogo antes que exploda.",
	-- só bombas saudáveis COM válvula de emergência associada (sem válvula a explosão seria inevitável)
	CanStart = function(ctx)
		for _, p in ipairs(ctx.Systems.Pumps.List()) do
			if p.state == "ok" and p.valvePart and not p.anchor:GetAttribute("Defeito") then return true end
		end
		return false
	end,
	Start = function(ctx, m)
		local Pumps, Fire, Bus = ctx.Systems.Pumps, ctx.Systems.Fire, ctx.Bus
		local okList = {}
		for idx, p in ipairs(Pumps.List()) do
			if p.state == "ok" and p.valvePart and not p.anchor:GetAttribute("Defeito") then table.insert(okList, idx) end
		end
		local i = ctx.Util.Pick(okList)
		if not i or not Pumps.StartLeak(i) then error("nenhuma bomba disponível para o vazamento") end
		m.pump = i
		local tag = "pump" .. i
		local valveDone, cleanDone = false, false
		m:SetGoal(3)
		m:Step("1) Feche a válvula de emergência (marcador vermelho)")
		local list = Pumps.List()
		m:SetTarget(list[i] and list[i].valvePart)
		ctx.Systems.Radio.Say("CONTROLE", "Vazamento na bomba " .. i .. "! Fechem a válvula de emergência AGORA.")

		local function update()
			local p = 0
			if valveDone then p += 1 end
			if cleanDone then p += 1 end
			if valveDone and Fire.Count(tag) == 0 then p += 1 end
			m:Set(p)
		end
		m:Connect(Bus.On("ValveClosed", function(plr, idx)
			if idx ~= i then return end
			m:Contribute(plr)
			valveDone = true
			m:Step("2) Limpe a poça e apague o fogo, se houver")
			m:SetTarget(list[i] and list[i].puddle)
			update()
		end))
		m:Connect(Bus.On("LeakCleaned", function(plr, idx)
			if idx ~= i then return end
			m:Contribute(plr)
			cleanDone = true
			update()
		end))
		m:Connect(Bus.On("FireOut", function(plr, t)
			if t ~= tag then return end
			m:Contribute(plr)
			update()
		end))
		m:Connect(Bus.On("LeakIgnited", function(idx)
			if idx == i then m:Step("FOGO! Pegue o extintor no armário vermelho e apague!") end
		end))
		m:Connect(Bus.On("LeakWarning", function(idx, left)
			if idx == i then
				ctx.Systems.Radio.Notify("danger", "Explosão em " .. left .. "s!")
			end
		end))
		m:Connect(Bus.On("PumpExploded", function(idx)
			if idx == i then m:Fail("a bomba explodiu") end
		end))
	end,
	Cleanup = function(ctx, m)
		local Pumps = ctx.Systems.Pumps
		local i = m.pump
		if not i then return end
		if Pumps.State(i) == "leak" then Pumps.CloseValve(i, nil) end
		if Pumps.State(i) == "valve" then Pumps.CleanPuddle(i, nil) end
		ctx.Systems.Fire.ExtinguishAll("pump" .. i)
		local l = Pumps.List()[i]
		if l and l.valvePart then ctx.Util.Unmark(l.valvePart) end
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{5c8acc5c-7018-43f4-8c21-761a21970325}</string>
					<string name="Name">fuel_leak</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX67B84C84FC9241DAA95E84B3A5A302E3">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: inspeção de segurança. Defeitos REAIS são aplicados aos equipamentos (atributo "Defeito"):
-- enquanto não forem corrigidos, o equipamento deixa de funcionar no seu sistema (bomba em manutenção,
-- válvula emperrada, armário interditado, gerador/disjuntor/terminal/rádio sem operar).
-- O jogador vistoria (G) para diagnosticar e corrige (R) o que estiver com defeito.
local FAULTS = {
	-- prefixo do nome do equipamento -> { defeito, sistema afetado }
	{ "^BreakerPanel$", "fiação aquecida no disjuntor", "energia" },
	{ "^Generator$", "óleo do gerador baixo", "energia" },
	{ "^PumpTerminal$", "terminal das bombas travado", "energia" },
	{ "^FireLocker", "lacre do extintor vencido", "incêndio" },
	{ "^PumpAnchor_", "mangueira da bomba ressecada", "bombas" },
	{ "^ShutoffValve_", "vedação da válvula com desgaste", "bombas" },
	{ "^Jukebox$", "fiação do rádio solta", "loja" },
	{ "^TankerPort$", "engate de descarga com desgaste", "caminhão-tanque" },
}

local function faultFor(part)
	for _, f in ipairs(FAULTS) do
		if part.Name:match(f[1]) then return f[2], f[3] end
	end
	return "desgaste geral", "posto"
end

return {
	Id = "inspection", Title = "Inspeção de Segurança", Weight = 3, Duration = 190, Reward = 240, XP = 25,
	Description = "O fiscal chegou! Vistorie os pontos marcados (tecla G). Equipamentos com defeito ficam fora de operação até serem corrigidos (tecla R).",
	CanStart = function(ctx) return ctx.Objects:FindFirstChild("BreakerPanel") ~= nil end,
	Start = function(ctx, m)
		local Util = ctx.Util
		m.bin = Util.Bin()
		local O = ctx.Objects
		local candidates = {
			O:FindFirstChild("BreakerPanel"), O:FindFirstChild("Generator"), O:FindFirstChild("FireLocker_1"),
			O:FindFirstChild("PumpAnchor_1"), O:FindFirstChild("PumpAnchor_3"), O:FindFirstChild("ShutoffValve_2"),
			O:FindFirstChild("Jukebox"), O:FindFirstChild("TankerPort"),
		}
		local points = {}
		for _, c in ipairs(candidates) do
			if c and c:IsA("BasePart") then table.insert(points, c) end
		end
		points = Util.Shuffle(points)
		local n = math.min(5, #points)
		if n == 0 then error("nenhum equipamento para vistoriar") end
		m:SetGoal(n)
		m:Step("Vistorie os pontos marcados (G)")
		ctx.Systems.Radio.Say("CONTROLE", "Fiscal no posto! Vistoriem os equipamentos marcados.")

		m.faulted = {}
		m.marked = {}
		local pending = {}

		local function nextTarget()
			for _, p in ipairs(points) do
				if pending[p] then m:SetTarget(p) return end
			end
			m:SetTarget(nil)
		end

		local function clearFault(part)
			part:SetAttribute("Defeito", nil)
			local fx = m.faulted[part]
			if fx then fx:Destroy() end
			m.faulted[part] = nil
		end

		local function done(part)
			pending[part] = nil
			Util.Unmark(part)
			m:Add(1)
			nextTarget()
		end

		for k = 1, n do
			local part = points[k]
			pending[part] = true
			table.insert(m.marked, part)
			-- 40% dos pontos têm defeito real desde o início (como no original), agora com efeito no sistema
			if math.random() < 0.4 and not part:GetAttribute("Defeito") then
				local txt = faultFor(part)
				part:SetAttribute("Defeito", txt)
				local smoke = Instance.new("Smoke")
				smoke.Name = "FumacaDefeito"
				smoke.Color = Color3.fromRGB(80, 80, 80)
				smoke.Opacity = 0.18
				smoke.Size = 1.5
				smoke.RiseVelocity = 2
				smoke.Parent = part
				m.faulted[part] = smoke
			end
			Util.Marker(part, "VISTORIAR", Color3.fromRGB(255, 190, 60))
			local insp = Util.Prompt(part, "Inspecionar", "Ponto " .. k .. "/" .. n, 1.4, Enum.KeyCode.G, 10)
			m.bin:Add(insp)
			insp.Triggered:Connect(function(player)
				if m.Ended or not insp.Parent then return end
				m:Contribute(player)
				insp:Destroy()
				local fault = part:GetAttribute("Defeito")
				if fault then
					local _, system = faultFor(part)
					ctx.Systems.Radio.Notify("warn", "Diagnóstico: " .. fault .. " (" .. system .. " fora de operação). Corrija (R).", player)
					Util.Marker(part, "CORRIGIR", Color3.fromRGB(255, 80, 60))
					local fix = Util.Prompt(part, "Corrigir", fault, 2, Enum.KeyCode.R, 10)
					m.bin:Add(fix)
					fix.Triggered:Connect(function(pl)
						if m.Ended or not fix.Parent then return end
						fix:Destroy()
						m:Contribute(pl)
						clearFault(part)
						ctx.Systems.Radio.Notify("success", "Reparo concluído: " .. system .. " de volta à operação.", pl)
						Util.Reward(pl, ctx.Config.Rewards.Inspect, "inspecao")
						done(part)
					end)
				else
					ctx.Systems.Radio.Notify("success", "Tudo certo neste ponto.", player)
					done(part)
				end
			end)
		end
		nextTarget()
	end,
	Cleanup = function(ctx, m)
		for _, p in ipairs(m.marked or {}) do ctx.Util.Unmark(p) end
		-- nenhum equipamento fica quebrado depois da missão (sucesso, falha ou cancelamento)
		for part, fx in pairs(m.faulted or {}) do
			part:SetAttribute("Defeito", nil)
			if fx then fx:Destroy() end
		end
		if m.bin then m.bin:Destroy() end
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{2b057348-feb6-49c2-b81f-bf0cda7feccb}</string>
					<string name="Name">inspection</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX62046DCCB9FA4C28A124D08235A8935B">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: assalto ao posto. Acione o alarme silencioso, derrube e algeme o ladrão, recupere a sacola.
-- Objetivos obrigatórios (4): alarme silencioso • algemar • pegar a sacola • devolver ao caixa.
-- Polícia: não há sistema policial no posto; o alarme dispara Bus "PoliceAlert" (ponto de integração futuro).
return {
	Id = "robbery", Title = "Assalto ao Posto", Weight = 2, Duration = 170, Reward = 450, XP = 45,
	Description = "Um ladrão entrou na loja! Acione o alarme silencioso com o caixa, derrube o ladrão antes que escape, algeme-o e devolva a sacola.",
	CanStart = function(ctx)
		return ctx.Systems.Customers.Cashier() ~= nil and ctx.Systems.Shop.IsOpen()
			and ctx.Objects:FindFirstChild("StoreDoor_Out") ~= nil and ctx.Objects:FindFirstChild("StoreDoor_In") ~= nil
			and ctx.Objects:FindFirstChild("Flee_1") ~= nil
	end,
	Start = function(ctx, m)
		local Util, Bus, Npc, Cfg = ctx.Util, ctx.Bus, ctx.Systems.Npc, ctx.Config.Robbery
		m.bin = Util.Bin()
		local flags = { alerted = false, stunned = false, detained = false, bagTaken = false, escaped = false, robbed = false }
		local stolen = 0                      -- valor efetivamente tirado do caixa (é o que a sacola devolve)
		local loot = math.random(Cfg.LootMin, Cfg.LootMax)
		local function up(p) return p + Vector3.new(0, 3, 0) end
		local function mk(name) return ctx.Objects:FindFirstChild(name) end

		-- cria o NPC ANTES de mexer na loja: falha de criação vira erro controlado (missão encerrada e limpa),
		-- nunca vitória automática
		local sp = Util.Pick({ mk("Spawn_Street_1") or mk("StoreDoor_Out"), mk("Spawn_Street_2") or mk("StoreDoor_Out") })
		local robber = Npc.Create("Assaltante", CFrame.new(up(sp.Position)), {
			shirt = Color3.fromRGB(35, 35, 40), pants = Color3.fromRGB(25, 25, 30), speed = 13,
			role = "Assaltante", tagColor = Color3.fromRGB(255, 70, 60),
		})
		if not robber then error("não foi possível criar o assaltante") end
		m.bin:Add(robber)
		m.robber = robber
		local root = robber:FindFirstChild("HumanoidRootPart")
		local hum = robber:FindFirstChildOfClass("Humanoid")

		m:SetGoal(4)
		m:Step("1) Acione o alarme silencioso com o caixa (Seu Zé) e derrube o ladrão")
		ctx.Systems.Customers.Suspend(true)
		ctx.Systems.Shop.SetOpen(false)
		m:SetTarget(root)
		Util.Marker(root, "ASSALTANTE", Color3.fromRGB(255, 70, 60))

		local cashier = ctx.Systems.Customers.Cashier()
		local croot = cashier:FindFirstChild("HumanoidRootPart")

		local function stepText()
			if flags.bagTaken then
				m:Step(flags.alerted and "Devolva a sacola ao caixa (Seu Zé)" or "Acione o alarme silencioso e devolva a sacola ao caixa")
			elseif flags.detained then
				m:Step(flags.alerted and "Pegue a sacola que ele largou" or "Pegue a sacola e acione o alarme silencioso com o caixa")
			else
				m:Step(flags.alerted and "Derrube e algeme o ladrão antes que ele escape" or "1) Acione o alarme silencioso com o caixa (Seu Zé) e derrube o ladrão")
			end
		end

		-- caixa: alarme silencioso (objetivo obrigatório)
		local alarmPP = Util.Prompt(croot, "Alarme silencioso", "Seu Zé", 0.8, Enum.KeyCode.G, 9)
		m.bin:Add(alarmPP)
		alarmPP.Triggered:Connect(function(player)
			if flags.alerted or m.Ended then return end
			flags.alerted = true
			alarmPP.Enabled = false
			m:Contribute(player)
			ctx.Systems.Alarm.Set("robbery", true, true)
			ctx.Systems.Radio.Notify("info", "Alarme silencioso enviado à central.")
			Npc.Say(cashier, "Alarme acionado!", 3)
			-- ponto de integração com a polícia do jogo (nenhuma polícia própria é criada aqui)
			Bus.Fire("PoliceAlert", { kind = "robbery", position = croot.Position, suspect = robber, by = player })
			-- reação do NPC: percebe o alarme e foge mais rápido
			if hum and hum.Parent then hum.WalkSpeed = Cfg.RobberSpeed end
			m:Add(1)
			stepText()
		end)

		-- ações no ladrão
		local tackle = Util.Prompt(root, "Derrubar", "Assaltante", 0, Enum.KeyCode.E, 10)
		local cuff = Util.Prompt(root, "Algemar", "Assaltante", Cfg.CuffHold, Enum.KeyCode.E, 10)
		cuff.Enabled = false
		m.bin:Add(tackle)
		m.bin:Add(cuff)
		tackle.Triggered:Connect(function(player)
			if flags.stunned or flags.detained or flags.escaped or m.Ended then return end
			flags.stunned = true
			m:Contribute(player)
			Npc.Stun(robber, Cfg.StunSeconds)
			Util.PlaySound(root, ctx.Config.Sounds.Tackle, { Volume = 0.8, Range = 60 })
			ctx.Systems.Radio.Notify("success", "Ladrão derrubado! Algeme-o rápido!", player)
			tackle.Enabled = false
			cuff.Enabled = true
			task.delay(Cfg.StunSeconds, function()
				if not flags.detained and not m.Ended then
					flags.stunned = false
					tackle.Enabled = true
					cuff.Enabled = false
				end
			end)
		end)

		-- sacola: some se quem a carrega morrer/sair; volta para o chão para não travar a missão
		local function dropBag(pos)
			local bag = ctx.Systems.Props.MoneyBag(pos)
			m.bin:Add(bag)
			Util.Marker(bag, "SACOLA", Color3.fromRGB(255, 190, 60))
			m:SetTarget(bag)
			local pp = Util.Prompt(bag, "Pegar sacola", ctx.Util.Money(stolen), 0.4, nil, 10)
			pp.Triggered:Connect(function(pl)
				if flags.bagTaken or m.Ended then return end
				local tool = ctx.Systems.Tools.Give(pl, "moneybag")
				if not tool then return end
				flags.bagTaken = true
				m:Contribute(pl)
				local lastPos = bag.Position
				bag:Destroy()
				if not m.BagCounted then
					m.BagCounted = true
					m:Add(1)
				end
				stepText()
				m:SetTarget(croot)
				Util.Marker(croot, "CAIXA", Color3.fromRGB(90, 255, 140))
				-- recuperação: Tool destruída sem ter sido devolvida (morte, saída do jogador)
				local conn
				conn = tool.Destroying:Connect(function()
					if conn then conn:Disconnect() end
					if m.Ended or m.BagReturned then return end
					flags.bagTaken = false
					local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
					Util.Unmark(croot)
					dropBag((r and r.Parent and r.Position or lastPos) + Vector3.new(0, 0.2, 0))
					ctx.Systems.Radio.Notify("warn", "A sacola caiu! Recupere-a.")
					stepText()
				end)
				m.bin:Add(conn)
			end)
		end

		cuff.Triggered:Connect(function(player)
			if flags.detained or not flags.stunned or m.Ended then return end
			flags.detained = true
			m:Contribute(player)
			hum.PlatformStand = true
			Util.PlaySound(root, ctx.Config.Sounds.Cuff, { Volume = 0.8, Range = 60 })
			cuff.Enabled = false
			tackle.Enabled = false
			Util.Unmark(root)
			m:Add(1)
			Npc.Say(robber, "Tá bom, tá bom! Me rendo!", 4)
			if flags.alerted then
				Bus.Fire("PoliceAlert", { kind = "robbery_detained", position = root.Position, suspect = robber, by = player })
			end
			dropBag(root.Position + Vector3.new(2, 0.2, 2))
			stepText()
		end)

		local returnPP = Util.Prompt(croot, "Devolver sacola", "Seu Zé", 0.5, Enum.KeyCode.F, 9)
		m.bin:Add(returnPP)
		returnPP.Triggered:Connect(function(player)
			if not flags.bagTaken or m.Ended or m.BagReturned then return end
			if not ctx.Systems.Tools.Find(player, "moneybag") then
				ctx.Systems.Radio.Notify("warn", "Você não está com a sacola.", player)
				return
			end
			m.BagReturned = true
			ctx.Systems.Tools.Remove(player, "moneybag")
			ctx.State.Add("Cash", stolen)   -- devolve exatamente o que foi roubado
			m:Contribute(player)
			Util.Unmark(croot)
			Util.PlaySound(croot, ctx.Config.Sounds.Register, { Volume = 0.6, Range = 50 })
			Npc.Say(cashier, "Você salvou o meu dia!", 4)
			m:Add(1)
			if not flags.alerted then
				ctx.Systems.Radio.Notify("warn", "Falta acionar o alarme silencioso com o caixa para registrar a ocorrência.", player)
				stepText()
			end
		end)

		-- morte do ladrão (queda, explosão): encerramento controlado
		hum.Died:Connect(function()
			if not flags.detained and not m.Ended then m:Fail("o assaltante não pôde ser detido") end
		end)

		-- roteiro do ladrão
		task.spawn(function()
			local door_out, door_in, slot = mk("StoreDoor_Out"), mk("StoreDoor_In"), mk("QueueSlot_1")
			Npc.WalkTo(robber, up(door_out.Position), 40)
			if flags.detained or m.Ended then return end
			Npc.WalkTo(robber, up(door_in.Position), 15)
			if flags.detained or m.Ended then return end
			if slot then Npc.WalkTo(robber, up(slot.Position), 20) end
			-- detido antes de chegar ao caixa: não rouba nada
			if flags.detained or m.Ended then return end
			Npc.Face(robber, croot.Position)
			Util.PlaySound(croot, ctx.Config.Sounds.RobberyStart, { Volume = 0.8, Range = 80 })
			ctx.Systems.Radio.Say("CONTROLE", "ASSALTO no posto! O ladrão está no caixa. Usem o alarme silencioso com o Seu Zé!")
			ctx.Systems.Radio.Notify("danger", "ASSALTO EM ANDAMENTO!")
			Npc.Say(robber, "Passa o dinheiro! Rápido!", 4)
			Npc.Say(cashier, "Calma, calma! Pode levar!", 4)
			local t0 = os.clock()
			while not flags.alerted and not flags.detained and os.clock() - t0 < (Cfg.WaitForAlarm or 12) and not m.Ended do task.wait(0.3) end
			if flags.detained or m.Ended then return end
			stolen = math.min(loot, ctx.State.Get("Cash") or 0)
			ctx.State.Add("Cash", -stolen)
			flags.robbed = true
			hum.WalkSpeed = Cfg.RobberSpeed
			Npc.Say(robber, "Valeu, otário!", 3)
			-- fuga
			local i = 1
			while not m.Ended and not flags.detained do
				local wp = mk("Flee_" .. i)
				if not wp then
					if not flags.detained then
						flags.escaped = true
						m:Fail("o ladrão escapou com o dinheiro")
					end
					return
				end
				while flags.stunned and not flags.detained and not m.Ended do task.wait(0.25) end
				if flags.detained or m.Ended then return end
				Npc.WalkTo(robber, up(wp.Position), 30)
				i += 1
			end
		end)
	end,
	Cleanup = function(ctx, m)
		if m.bin then m.bin:Destroy() end
		ctx.Systems.Alarm.Set("robbery", false)
		ctx.Systems.Shop.SetOpen(true)
		ctx.Systems.Customers.Suspend(false)
		local cashier = ctx.Systems.Customers.Cashier()
		if cashier then
			local r = cashier:FindFirstChild("HumanoidRootPart")
			if r then ctx.Util.Unmark(r) end
		end
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			ctx.Systems.Tools.Remove(p, "moneybag")
		end
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{ef50c905-23cc-4830-83b3-f6f64e12267c}</string>
					<string name="Name">robbery</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5991A35565DD4EE7BA013A79D95DB2EE">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: Hora do Rush. Clientes pedem bebidas; pegue nas geladeiras e entregue antes que percam a paciência.
return {
	Id = "rush", Title = "Hora do Rush", Weight = 3, Duration = 260, Reward = 320, XP = 30,
	Description = "A loja encheu! Cada cliente quer bebidas. Pegue nas geladeiras (E) e entregue no cliente da fila. 3 clientes irritados e a missão falha.",
	CanStart = function(ctx)
		return ctx.Systems.Shop.IsOpen() and ctx.Systems.Customers.Cashier() ~= nil
			and ctx.Objects:FindFirstChild("QueueSlot_1") ~= nil
	end,
	Start = function(ctx, m)
		local Customers, Shop = ctx.Systems.Customers, ctx.Systems.Shop
		local need = 6
		local served, angry, spawned = 0, 0, 0
		m.customers = {}
		m:SetGoal(need)
		m:Step("Atenda os clientes: pegue as bebidas pedidas e entregue")
		Shop.SetServeMode(true)
		Customers.Suspend(true)
		ctx.Systems.Radio.Say("CONTROLE", "Fila na loja! Peguem as bebidas nas geladeiras e entreguem nos clientes.")
		local ids = { "cola", "bloxiade", "goala", "redblox" }

		local function newOrder()
			local order = {}
			local kinds = math.random(1, 2)
			for _ = 1, kinds do
				local id = ctx.Util.Pick(ids)
				order[id] = (order[id] or 0) + 1
			end
			return order
		end

		task.spawn(function()
			while not m.Ended and spawned < 10 and served < need do
				local obj = Customers.Spawn({
					order = newOrder(),
					patience = 55,
					onServed = function(plr)
						if m.Ended then return end
						m:Contribute(plr)
						served += 1
						m:Add(1)
					end,
					onLeft = function(reason)
						if m.Ended then return end
						if reason == "nav" then
							-- não chegou à fila (navegação): não conta como irritado e libera outra vaga
							spawned = math.max(0, spawned - 1)
							return
						end
						angry += 1
						ctx.Systems.Radio.Notify("warn", "Cliente irritado foi embora (" .. angry .. "/3)")
						if angry >= 3 then m:Fail("clientes demais irritados") end
					end,
				})
				if obj then
					spawned += 1
					table.insert(m.customers, obj)
				end
				task.wait(obj and (9 + math.random() * 5) or 3)
			end
		end)
	end,
	Cleanup = function(ctx, m)
		-- clientes da missão vão embora sem contar como irritados
		for _, obj in ipairs(m.customers or {}) do ctx.Systems.Customers.Dismiss(obj) end
		ctx.Systems.Shop.SetServeMode(false)
		ctx.Systems.Customers.Suspend(false)
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{2584cae7-dcc9-473f-9531-77a255d333a9}</string>
					<string name="Name">rush</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2F03B9254A1F49679BB9E22690F6397C">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: reposição de estoque. Pegue caixas na calçada e reponha as prateleiras vazias.
return {
	Id = "stock", Title = "Reposição de Estoque", Weight = 3, Duration = 210, Reward = 240, XP = 25,
	Description = "As prateleiras esvaziaram! Pegue as caixas na calçada sul e leve até as prateleiras marcadas dentro da loja.",
	CanStart = function(ctx)
		if not ctx.Systems.Shop.IsOpen() or #ctx.Systems.Shop.Slots() == 0 then return false end
		local box, shelf = false, false
		for _, o in ipairs(ctx.Objects:GetChildren()) do
			if o:IsA("BasePart") then
				if o.Name:match("^BoxSpawn_") then box = true end
				if o.Name:match("^ShelfDrop_") then shelf = true end
			end
		end
		return box and shelf
	end,
	Start = function(ctx, m)
		local Util, Bus = ctx.Util, ctx.Bus
		m.bin = Util.Bin()
		local spawns, drops = {}, {}
		for _, o in ipairs(ctx.Objects:GetChildren()) do
			if o:IsA("BasePart") then
				if o.Name:match("^BoxSpawn_") then table.insert(spawns, o) end
				if o.Name:match("^ShelfDrop_") then table.insert(drops, o) end
			end
		end
		table.sort(spawns, function(a, b) return a.Name < b.Name end)
		local n = math.min(5, #spawns)
		-- sem caixas/prateleiras a missão não pode ser cumprida: erro controlado em vez de vitória automática
		if n == 0 or #drops == 0 then error("sem pontos de caixa ou prateleira") end
		ctx.Systems.Shop.Deplete(8)
		m:SetGoal(n)
		m:Step("1) Pegue uma caixa na calçada sul da loja")
		ctx.Systems.Radio.Say("CONTROLE", "Estoque zerado! Caixas na calçada sul. Levem para as prateleiras.")
		m:SetTarget(spawns[1])

		local function spawnCrate(k)
			local crate = ctx.Systems.Props.Crate(spawns[k].CFrame * CFrame.new(0, 1.3, 0))
			m.bin:Add(crate)
			Util.Marker(crate, "CAIXA", Color3.fromRGB(255, 190, 60))
			local pp = Util.Prompt(crate, "Pegar caixa", "Estoque", 0.5)
			pp.Triggered:Connect(function(player)
				if m.Ended or not crate.Parent then return end
				if ctx.Systems.Tools.Find(player, "crate") then
					ctx.Systems.Radio.Notify("warn", "Você já está carregando uma caixa.", player)
					return
				end
				local tool = ctx.Systems.Tools.Give(player, "crate")
				if not tool then return end
				m:Contribute(player)
				crate:Destroy()
				-- recuperação: caixa perdida (morte/saída do jogador) volta para a calçada
				local conn
				conn = tool.Destroying:Connect(function()
					if conn then conn:Disconnect() end
					if m.Ended or tool:GetAttribute("Entregue") then return end
					spawnCrate(k)
					ctx.Systems.Radio.Notify("warn", "Uma caixa foi perdida e voltou para a calçada.")
				end)
				m.bin:Add(conn)
				m:Step("2) Equipe a caixa e leve até as prateleiras (marcadores)")
				ctx.Systems.Radio.Notify("info", "Caixa na mão. Equipe e vá até uma prateleira.", player)
			end)
		end
		for k = 1, n do spawnCrate(k) end
		for _, d in ipairs(drops) do
			Util.Marker(d, "REPOR", Color3.fromRGB(90, 255, 140))
			local pp = Util.Prompt(d, "Repor prateleira", "Estoque", 0.7, nil, 10)
			m.bin:Add(pp)
			pp.Triggered:Connect(function(player)
				if not ctx.Systems.Tools.Find(player, "crate") then
					ctx.Systems.Radio.Notify("warn", "Pegue uma caixa na calçada primeiro.", player)
					return
				end
				local tool = ctx.Systems.Tools.Find(player, "crate")
				tool:SetAttribute("Entregue", true)
				tool:Destroy()
				ctx.Systems.Shop.Restock(2)
				m:Contribute(player)
				Util.Reward(player, ctx.Config.Rewards.Box, "estoque")
				m:Add(1)
			end)
		end
		m.drops = drops
	end,
	Cleanup = function(ctx, m)
		if m.bin then m.bin:Destroy() end
		-- caixas ainda carregadas não ficam com os jogadores (nem a lentidão da Tool pesada)
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			while ctx.Systems.Tools.Remove(p, "crate") do end
		end
		for _, d in ipairs(m.drops or {}) do ctx.Util.Unmark(d) end
		ctx.Systems.Shop.Restock(4)
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{af0b357d-f740-4d6a-8d75-d2f19299dac8}</string>
					<string name="Name">stock</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE1F91F92AD9940BCB61C2CF42D21E5D7">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: motorista ficou sem combustível. Encha um galão na bomba e entregue no carro.
return {
	Id = "stranded", Title = "Carro sem Combustível", Weight = 3, Duration = 220, Reward = 230, XP = 25,
	Description = "Um motorista ficou sem gasolina na entrada do posto. Compre um galão, encha na bomba (mín. 10 L) e leve até o carro.",
	CanStart = function(ctx)
		return ctx.Objects:FindFirstChild("StrandedSpot") ~= nil and ctx.Systems.Pumps.Reserve() >= 15
	end,
	Start = function(ctx, m)
		local Util, Bus = ctx.Util, ctx.Bus
		m.bin = Util.Bin()
		local spot = ctx.Objects.StrandedSpot
		local need = 10
		local filled = false
		m:SetGoal(2)
		m:Step("1) Compre um galão (bomba ou loja) e encha com 10 L ou mais")
		ctx.Systems.Radio.Say("CONTROLE", "Motorista parado na entrada sem combustível. Levem um galão cheio até ele.")

		local carCF = CFrame.new(spot.Position + Vector3.new(0, -spot.Size.Y / 2, 0)) * CFrame.Angles(0, spot.Orientation.Y * math.pi / 180, 0)
		local car, lights = ctx.Systems.Props.Car(carCF, Color3.fromRGB(60, 120, 210))
		if not car or not car.PrimaryPart then error("não foi possível criar o carro") end
		m.car = car
		m.bin:Add(car)
		local body = car.PrimaryPart
		m:SetTarget(body)
		Util.Marker(body, "CARRO", Color3.fromRGB(255, 190, 60))

		-- driver
		local driver = ctx.Systems.Npc.Create("Motorista", carCF * CFrame.new(5.5, 3, 0), {
			shirt = Color3.fromRGB(240, 240, 240), pants = Color3.fromRGB(60, 60, 80), speed = 0, role = "Cliente",
			tagColor = Color3.fromRGB(120, 200, 255),
		})
		if driver then
			m.bin:Add(driver)
			ctx.Systems.Npc.Say(driver, "Fiquei sem gasolina! Alguém me ajuda?", 8)
		end

		-- pisca-alerta
		task.spawn(function()
			local on = false
			while car.Parent and not m.Ended do
				on = not on
				for _, l in ipairs(lights) do
					l.Color = on and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(90, 50, 0)
				end
				task.wait(0.5)
			end
		end)

		-- já existe galão cheio?
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			local c = ctx.Systems.Tools.Find(p, "jerrycan")
			if c and (c:GetAttribute("Liters") or 0) >= need then
				filled = true
				m:Add(1)
				m:Step("2) Leve o galão até o carro")
				break
			end
		end

		m:Connect(Bus.On("JerrycanFilled", function(plr, liters, can)
			m:Contribute(plr)
			if not filled and can and (can:GetAttribute("Liters") or 0) >= need then
				filled = true
				m:Add(1)
				m:Step("2) Leve o galão até o carro (marcador)")
			end
		end))

		local pp = Util.Prompt(body, "Abastecer carro", "Motorista sem combustível", 2.5, nil, 12)
		m.bin:Add(pp)
		local delivering = false
		pp.Triggered:Connect(function(player)
			if delivering then return end
			local can = ctx.Systems.Tools.Find(player, "jerrycan")
			if not can or (can:GetAttribute("Liters") or 0) < need then
				ctx.Systems.Radio.Notify("warn", "Você precisa de um galão com pelo menos " .. need .. " L.", player)
				return
			end
			delivering = true
			can:SetAttribute("Liters", (can:GetAttribute("Liters") or 0) - need)
			ctx.Systems.Tools.Refresh(can)
			m:Contribute(player)
			if not filled then m:Add(1) filled = true end
			Util.Unmark(body)
			if driver then ctx.Systems.Npc.Say(driver, "Você é demais! Toma uma gorjeta!", 4) end
			Util.Reward(player, math.random(30, 70), "gorjeta")
			-- o carro vai embora (a limpeza espera o carro sair de cena)
			m.departing = true
			Util.PlaySound(body, ctx.Config.Sounds.CarStart, { Volume = 0.8, Range = 120 })
			task.spawn(function()
				local away = ctx.Objects:FindFirstChild("StrandedExit")
				local target = carCF * CFrame.new(0, 0, -90)
				if away then target = CFrame.lookAt(away.Position, away.Position + carCF.LookVector) end
				m:Add(1)
				ctx.Systems.Props.Move(car, target, 6, Enum.EasingStyle.Quad)
			end)
		end)
	end,
	Cleanup = function(ctx, m)
		if m.bin then
			task.delay(m.departing and 7 or 1, function() m.bin:Destroy() end)
		end
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{724816c4-018c-4b9c-b61a-7d929bf51d78}</string>
					<string name="Name">stranded</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX776A94CDFC294D7B8B288867C56175CA">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Missão: caminhão-tanque. Autorize, conecte o mangote, abra a válvula, controle os surtos de pressão e finalize.
return {
	Id = "tanker", Title = "Caminhão-Tanque", Weight = 2, Duration = 260, Reward = 420, XP = 40,
	Description = "O caminhão-tanque chegou para reabastecer o posto. Autorize a entrega, conecte o mangote, abra a válvula e aperte o regulador nos surtos de pressão.",
	CanStart = function(ctx)
		local O = ctx.Objects
		return O:FindFirstChild("Tanker_Start") and O:FindFirstChild("Tanker_Park") and O:FindFirstChild("Tanker_End")
			and O:FindFirstChild("TankerPort") and O:FindFirstChild("TankerRegulator")
			and ctx.Systems.Pumps.Reserve() <= ctx.Config.Fuel.ReserveMax - 500
	end,
	Start = function(ctx, m)
		local Util, Cfg = ctx.Util, ctx.Config.Tanker
		local O = ctx.Objects
		m.bin = Util.Bin()
		m:SetGoal(4)
		m:Step("Aguarde o caminhão estacionar...")
		ctx.Systems.Radio.Say("CONTROLE", "Caminhão-tanque na entrada! Preparem a descarga.")
		local startP, park, endP = O.Tanker_Start.Position, O.Tanker_Park.Position, O.Tanker_End.Position
		local truck, port = ctx.Systems.Props.Truck(CFrame.lookAt(startP, park))
		if not truck or not port or not truck:FindFirstChild("Cab") then error("não foi possível criar o caminhão") end
		m.truck = truck
		m.bin:Add(truck)
		local surgeId = 0   -- identifica o surto atual: um temporizador antigo nunca afeta um surto novo
		local portGround = O.TankerPort
		local reg = O.TankerRegulator
		local state = { auth = false, hose = false, flowing = false, done = false, surge = false, failures = 0 }

		local cab = truck:FindFirstChild("Cab")
		local authPP = Util.Prompt(cab, "Autorizar descarga", "Motorista", 1, nil, 14)
		authPP.Enabled = false
		local hosePP = Util.Prompt(port, "Conectar mangote", "Válvula do caminhão", 3, nil, 12)
		hosePP.Enabled = false
		local valvePP = Util.Prompt(portGround, "Abrir válvula de descarga", "Ponto de descarga", 3, nil, 12)
		valvePP.Enabled = false
		local regPP = Util.Prompt(reg, "Aliviar pressão", "Regulador", 0.3, nil, 12)
		regPP.Enabled = false
		local outPP = Util.Prompt(port, "Desconectar e finalizar", "Caminhão", 2, nil, 12)
		outPP.Enabled = false
		for _, p in ipairs({ authPP, hosePP, valvePP, regPP, outPP }) do m.bin:Add(p) end

		local function mark(part, text)
			for _, p in ipairs({ cab, port, portGround, reg }) do Util.Unmark(p) end
			if part then
				Util.Marker(part, text, Color3.fromRGB(255, 190, 60))
				m:SetTarget(part)
			end
		end

		authPP.Triggered:Connect(function(pl)
			if state.auth then return end
			state.auth = true
			authPP.Enabled = false
			m:Contribute(pl)
			m:Add(1)
			hosePP.Enabled = true
			mark(port, "MANGOTE")
			m:Step("2) Conecte o mangote no caminhão")
		end)
		hosePP.Triggered:Connect(function(pl)
			if state.hose then return end
			state.hose = true
			hosePP.Enabled = false
			m:Contribute(pl)
			m:Add(1)
			valvePP.Enabled = true
			mark(portGround, "VÁLVULA")
			m:Step("3) Abra a válvula de descarga no chão")
		end)
		regPP.Triggered:Connect(function(pl)
			if state.surge and not m.Ended then
				state.surge = false
				m:Contribute(pl)
				ctx.Systems.Alarm.Set("tanker", false)
				ctx.Systems.Radio.Notify("success", "Pressão aliviada!", pl)
			end
		end)
		valvePP.Triggered:Connect(function(pl)
			if state.flowing or state.done then return end
			state.flowing = true
			valvePP.Enabled = false
			m:Contribute(pl)
			m:Step("Descarregando... Fique perto do regulador!")
			mark(reg, "REGULADOR")
			task.spawn(function()
				local per = Cfg.Liters / Cfg.TransferSeconds
				local elapsed = 0
				local nextSurge = math.random(Cfg.SurgeEvery[1], Cfg.SurgeEvery[2])
				while elapsed < Cfg.TransferSeconds and not m.Ended do
					task.wait(1)
					if ctx.Systems.Fire.Count("tanker") == 0 and not state.surge then
						elapsed += 1
						ctx.Systems.Pumps.AddReserve(per)
						ctx.State.Set("MissionProgress", 2 + elapsed / Cfg.TransferSeconds)
						nextSurge -= 1
						if nextSurge <= 0 and elapsed < Cfg.TransferSeconds - 3 then
							nextSurge = math.random(Cfg.SurgeEvery[1], Cfg.SurgeEvery[2])
							state.surge = true
							surgeId += 1
							local myId = surgeId
							regPP.Enabled = true
							ctx.Systems.Alarm.Set("tanker", true, false)
							ctx.Systems.Radio.Notify("danger", "SURTO DE PRESSÃO! Aperte o regulador!")
							ctx.Systems.Radio.Say("CONTROLE", "Pressão subindo no mangote! Regulador, rápido!")
							task.delay(Cfg.SurgeWindow, function()
								if state.surge and surgeId == myId and not m.Ended and not state.done then
									state.surge = false
									ctx.Systems.Alarm.Set("tanker", false)
									state.failures += 1
									ctx.Systems.Fire.Ignite(portGround.Position + Vector3.new(0, 1, 0), 7, { tag = "tanker", spread = false })
									ctx.Systems.Radio.Shake(0.8, 1, portGround.Position)
									ctx.Systems.Radio.Notify("danger", "Vazamento no ponto de descarga! Apague o fogo!")
									if state.failures >= 3 then m:Fail("pressão fora de controle") end
								end
							end)
						end
					end
				end
				regPP.Enabled = false
				state.surge = false
				ctx.Systems.Alarm.Set("tanker", false)
				if m.Ended then return end
				state.done = true
				m:Set(3)
				outPP.Enabled = true
				mark(port, "FINALIZAR")
				m:Step("4) Desconecte o mangote e finalize")
			end)
		end)
		outPP.Triggered:Connect(function(pl)
			if not state.done or state.finished then return end
			state.finished = true
			outPP.Enabled = false
			m:Contribute(pl)
			mark(nil)
			-- conclui ao finalizar (o tempo não pode mais estourar durante a saída); a limpeza espera o caminhão sair
			m.departing = true
			m:Add(1)
			task.spawn(function()
				local snd = Util.PlaySound(truck.PrimaryPart or cab, ctx.Config.Sounds.Truck, { Looped = true, Volume = 0.8, Range = 160 })
				ctx.Systems.Props.Move(truck, CFrame.lookAt(endP, endP + (endP - park)), 7, Enum.EasingStyle.Quad)
				if snd then snd:Destroy() end
			end)
		end)

		-- chegada
		task.spawn(function()
			local snd = Util.PlaySound(truck.PrimaryPart or cab, ctx.Config.Sounds.Truck, { Looped = true, Volume = 0.8, Range = 160 })
			ctx.Systems.Props.Move(truck, CFrame.lookAt(park, park + (park - startP)), 8, Enum.EasingStyle.Sine)
			if snd then snd:Destroy() end
			if m.Ended then return end
			authPP.Enabled = true
			mark(cab, "MOTORISTA")
			m:Step("1) Autorize a descarga com o motorista")
		end)
	end,
	Cleanup = function(ctx, m)
		for _, n in ipairs({ "TankerPort", "TankerRegulator" }) do
			ctx.Util.Unmark(ctx.Objects:FindFirstChild(n))
		end
		ctx.Systems.Alarm.Set("tanker", false)
		ctx.Systems.Fire.ExtinguishAll("tanker")
		if m.bin then
			task.delay(m.departing and 8 or 2, function() m.bin:Destroy() end)
		end
	end,
}
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{2c57399f-d7cf-4210-9d96-ff53d53ff145}</string>
					<string name="Name">tanker</string>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBXE2EDA09FF25E49938B7D924C4DEBCD6F">
			<Properties>

				<string name="Name">Client</string>
			</Properties>
			<Item class="LocalScript" referent="RBX31603DA54D5C4F39B71D0DCA134B61CD">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- HUD do cliente do Posto: sistemas, reputação, missão, rádio, avisos, popups, marcadores, flash, zoom e tremor.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local player = Players.LocalPlayer
local gui = script.Parent
local state = RS:WaitForChild("PostoState")
local remotes = RS:WaitForChild("PostoRemotes")

local ORANGE = Color3.fromRGB(255, 150, 30)
local GREEN = Color3.fromRGB(90, 255, 140)
local YELLOW = Color3.fromRGB(255, 200, 50)
local RED = Color3.fromRGB(255, 70, 60)
local BLUE = Color3.fromRGB(80, 200, 255)
local PANEL = Color3.fromRGB(10, 16, 22)
local GREY = Color3.fromRGB(190, 200, 210)

local function corner(o, r) local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, r or 8) c.Parent = o end
local function stroke(o, col, t) local s = Instance.new("UIStroke") s.Color = col or ORANGE s.Thickness = t or 1.5 s.Transparency = 0.35 s.Parent = o end
local function label(parent, text, size, color, font, pos, sz, align)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Font = font or Enum.Font.GothamMedium
	l.Position = pos or UDim2.new()
	l.Size = sz or UDim2.fromScale(1, 1)
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end
local function bar(parent, pos, size, color)
	local back = Instance.new("Frame")
	back.Position = pos
	back.Size = size
	back.BackgroundColor3 = Color3.fromRGB(30, 40, 50)
	back.BorderSizePixel = 0
	back.Parent = parent
	corner(back, 5)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	corner(fill, 5)
	return fill
end

