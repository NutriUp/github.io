					<Item class="Script" referent="RBX4F0596564B8C4AE8A7A7BD5256F84B8D">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local handle = script.Parent.Interactive
local doorOpen = false
local changingState = false

handle.ClickDetector.MouseClick:Connect(function()
	if doorOpen == true and changingState == false then
		changingState = true
		for i = 1, 40 do
			script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.new(-0.1, 0, 0))
			wait()
		end
		changingState = false
		doorOpen = false
	elseif changingState == false then
		changingState = true
		for i = 1, 40 do
			script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.new(0.1, 0, 0))
			wait()
		end
		changingState = false
		doorOpen = true
	end
end)]]></ProtectedString>
