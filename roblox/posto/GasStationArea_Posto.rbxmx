					<Item class="Script" referent="RBX3D617B4A59D3482B87845E0F46E08585">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local doorOpen = false
local changingState = false

for i, v in pairs(script.Parent:GetChildren()) do
	if v:FindFirstChild("ClickDetector") then
		v.ClickDetector.MouseClick:Connect(function()
			if doorOpen == true and changingState == false then
				changingState = true
				for i = 1, 16 do
					script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(-5), 0))
					wait()
				end
				changingState = false
				doorOpen = false
			elseif changingState == false then
				changingState = true
				for i = 1, 16 do
					script.Parent:SetPrimaryPartCFrame(script.Parent.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(5), 0))
					wait()
				end
				changingState = false
				doorOpen = true
			end
		end)
	end
end]]></ProtectedString>
