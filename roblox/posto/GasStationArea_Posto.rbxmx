			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{15926644-aba7-47ef-af0e-e5244991b72d}</string>
				<string name="Name">Core</string>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX2A76A4EDFFFD427EA9A3DE24552980D0">
			<Properties>

				<string name="Name">Modules</string>
			</Properties>
			<Item class="ModuleScript" referent="RBXA9FF8B65A45C4764867DB8DB41849F1C">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- Barramento de eventos interno. Sistemas e missões conversam por aqui.
local Bus = {}
local handlers = {}

function Bus.On(name, fn)
	handlers[name] = handlers[name] or {}
	table.insert(handlers[name], fn)
	return {
		Disconnect = function()
			local t = handlers[name]
			local i = t and table.find(t, fn)
			if i then table.remove(t, i) end
		end,
	}
end

function Bus.Fire(name, ...)
	local t = handlers[name]
	if not t then return end
	for _, fn in ipairs(table.clone(t)) do
		task.spawn(fn, ...)
	end
end

return Bus
]]></ProtectedString>
			<Content name="LinkedSource"><null></null></Content>
			<string name="ScriptGuid">{5a7775fa-82d6-442c-bfc6-92cef45ebe54}</string>
