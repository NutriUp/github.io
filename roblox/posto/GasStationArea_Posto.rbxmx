				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1CD42EA7F855410BAEF01603502A1361">
				<Properties>
			<ProtectedString name="Source"><![CDATA[-- POSTO • Configuração central. Ajuste tudo aqui sem mexer nos sistemas.
-- Todos os valores abaixo são lidos em tempo de execução pelos módulos.
local Config = {}

-- ===== Diretor de missões =====
Config.Director = {
	AutoStart = true,      -- sorteia missões automaticamente
	FirstDelay = 45,       -- segundos até a 1a missão
	MinGap = 45,           -- intervalo mínimo entre missões
	MaxGap = 110,          -- intervalo máximo entre missões
}

-- ===== Economia =====
-- O jogo ainda NÃO tem economia global. Enquanto Enabled = false:
--   • nenhum saldo de jogador é criado, lido ou alterado (o posto não cria leaderstats);
--   • recompensas só são anunciadas no Bus como "RewardEarned"(player, valor, motivo);
--   • compras seguem PurchasesWhenDisabled ("free" = entrega o item sem cobrar; "blocked" = recusa a compra).
-- Integração futura: Util.SetEconomyProvider({ Pay = fn(p, v, motivo) -> pago, Charge = fn(p, v, motivo) -> ok, Balance = fn(p) -> n })
-- ou Provider = "leaderstats" (usa leaderstats[Stat] SOMENTE se já existir; nunca cria).
-- O "caixa do posto" (RegisterStart / estado Cash) é dinheiro do cenário (assalto, vendas), não saldo de jogador.
Config.Economy = {
	Enabled = false,
	Provider = "custom",   -- "custom" | "leaderstats"
	Stat = "Dinheiro",     -- nome do valor em leaderstats (mesmo da Oil Rig)
	RegisterStart = 500,   -- dinheiro inicial do caixa do posto
	PurchasesWhenDisabled = "free",
	-- divisão do prêmio da missão: "full" (cada colaborador recebe o integral, regra original) | "split" | "none"
	MissionPayout = "full",
}

-- ===== Combustível =====
Config.Fuel = {
	ReserveMax = 2000,     -- litros que o tanque comporta
	ReserveStart = 1100,
	LowWarn = 300,         -- aviso de reserva baixa
	BasePrice = 6.20,      -- preço base por litro (R$)
	PriceMin = 0.80,       -- multiplicador mínimo do mercado
	PriceMax = 1.45,       -- multiplicador máximo do mercado
	PriceEvery = 75,       -- segundos entre mudanças de preço
	PriceStep = 0.07,      -- variação máxima por mudança
	JerrycanCapacity = 20, -- litros do galão
	JerrycanPrice = 35,    -- preço do galão vazio
}

-- ===== Bombas =====
Config.Pumps = {
	LeakGrowTime = 45,       -- segundos para a poça chegar ao tamanho máximo
	LeakMaxSize = 11,
	IgniteAfter = 55,        -- segundos de vazamento aberto até pegar fogo
	ExplodeAfter = 95,       -- segundos de vazamento aberto até explodir
	ValveHold = 1.6,
	CleanHold = 3.5,
	ExplosionRadius = 22,
	ExplosionDamage = 60,
	BrokenSeconds = 70,      -- tempo da bomba fora de serviço após explodir
}

-- ===== Energia =====
Config.Power = {
	BreakerHold = 2,
	GeneratorHold = 3,
	TerminalHold = 2,
	EmergencyRatio = 3,      -- 1 a cada N luzes acende no modo emergência
}

-- ===== Fogo =====
Config.Fire = {
	Damage = 7,              -- dano/seg a quem fica perto do fogo
	DamageRadius = 6.5,
	ExtinguishRange = 24,
	HP = 60,                 -- vida de cada foco
	HitPower = 14,           -- por esguicho do extintor
	ExtinguisherCharge = 100,
	ChargePerShot = 4,
	SpreadEvery = 14,        -- segundos para um foco gerar vizinho
	MaxFires = 8,
}

-- ===== Loja =====
Config.Shop = {
	StartStockMin = 3,
	StartStockMax = 6,
	PassiveRestockEvery = 90, -- segundos: +1 em um slot esgotado
	DrinksHeal = 10,          -- cura das bebidas (0 desliga; seu jogo só cura com bandagem/kit)
	-- id = { nome, preço, tipo, ... }  (a chave é o nome do modelo na loja)
	Items = {
		-- bebidas (pasta ConvenienceStoreDrinks)
		Colas       = { id = "cola",      name = "Cola Gelada",        price = 8,  kind = "drink",  heal = 1.0, xp = 1 },
		Bloxiades   = { id = "bloxiade",  name = "Bloxiade",           price = 9,  kind = "drink",  heal = 1.0, speed = 5, seconds = 20, xp = 1 },
		Goalas      = { id = "goala",     name = "Goala Zero",         price = 7,  kind = "drink",  heal = 1.0, xp = 1 },
		RedBLOXs    = { id = "redblox",   name = "RedBLOX Energy",     price = 14, kind = "drink",  heal = 0.5, speed = 9, seconds = 25, jump = 10, xp = 2 },
		-- sorvete (freezer)
		IceCream    = { id = "icecream",  name = "Sorvete",            price = 10, kind = "drink",  heal = 1.5, xp = 1 },
		-- itens da prateleira (pasta ItemsForSale)
		BeachBalls  = { id = "beachball", name = "Bola de Praia",      price = 20, kind = "throw",  shape = "ball",  color = {255, 120, 60} },
		RCCar       = { id = "rccar",     name = "Carrinho RC",        price = 60, kind = "toy" },
		GravCoils   = { id = "gravcoil",  name = "Gravity Coil",       price = 150, kind = "coil",  gravity = 0.55 },
		GPS         = { id = "gps",       name = "GPS",                price = 45, kind = "gps" },
		Flashlights = { id = "flashlight",name = "Lanterna",           price = 30, kind = "light",  spot = true },
		GiftBag     = { id = "giftbag",   name = "Sacola Surpresa",    price = 25, kind = "gift" },
		GoldenBoomBoxes = { id = "goldboombox", name = "Boombox Dourada", price = 220, kind = "music", gold = true },
		TicTacToe   = { id = "tictactoe", name = "Jogo da Velha",      price = 12, kind = "toy" },
		SpeedCoils  = { id = "speedcoil", name = "Speed Coil",         price = 120, kind = "coil",  speed = 10 },
		Lamps       = { id = "lamp",      name = "Luminária",          price = 28, kind = "light",  spot = false },
		RegenCoils  = { id = "regencoil", name = "Regen Coil",         price = 180, kind = "coil",  regen = 1 },
		Racket      = { id = "racket",    name = "Raquete",            price = 22, kind = "toy" },
		Binoculars  = { id = "binoculars",name = "Binóculos",          price = 55, kind = "zoom" },
		BoomBoxes   = { id = "boombox",   name = "Boombox",            price = 90, kind = "music" },
		BloxyRadars = { id = "radar",     name = "Radar Bloxy",        price = 70, kind = "radar" },
		Compasses   = { id = "compass",   name = "Bússola",            price = 18, kind = "compass" },
		ChocoCoin   = { id = "chococoin", name = "Moeda de Chocolate", price = 5,  kind = "drink",  heal = 0.5, xp = 1 },
		Boomerangs  = { id = "boomerang", name = "Bumerangue",         price = 16, kind = "throw",  shape = "wedge", color = {200, 140, 70} },
		Frisbees    = { id = "frisbee",   name = "Frisbee",            price = 12, kind = "throw",  shape = "disc",  color = {80, 170, 255} },
		FireflyJars = { id = "fireflyjar",name = "Pote de Vaga-lumes", price = 35, kind = "light",  jar = true },
		DiscoBalls  = { id = "discoball", name = "Globo de Luz",       price = 48, kind = "light",  disco = true },
	},
}

-- ===== Reputação (nível do jogador com o posto) =====
Config.Rep = {
	Persist = true,                 -- salva em DataStore (precisa de "API Services" ligado no jogo publicado)
	StoreName = "PostoReputacao_v1",
	LevelXP = { 0, 60, 160, 320, 560, 900, 1400, 2100 },   -- XP mínimo de cada nível
	Discount = { 0, 0.03, 0.05, 0.08, 0.10, 0.12, 0.15, 0.20 }, -- desconto por nível na loja e bombas
	RewardBonus = { 0, 0.05, 0.08, 0.12, 0.16, 0.20, 0.25, 0.30 }, -- bônus nas recompensas de missão
}

-- ===== Clientes (NPCs ambientes) =====
Config.Customers = {
	Enabled = true,
	Max = 3,
	SpawnMin = 28, SpawnMax = 65,   -- segundos entre clientes
	Patience = 55,                  -- segundos na fila até desistir
	WalkSpeed = 11,
	Tip = { 4, 14 },                -- gorjeta ao atender
	Pays = { 18, 70 },              -- quanto o cliente paga ao caixa do posto
}

-- ===== Recompensas base (missões definem as próprias) =====
Config.Rewards = {
	Valve = 8, Puddle = 12, FireOut = 10, Inspect = 14, Box = 12, Serve = 14,
}

-- ===== Caminhão-tanque =====
Config.Tanker = {
	Liters = 1400,           -- litros entregues
	TransferSeconds = 26,
	SurgeEvery = { 6, 10 },  -- intervalo entre "surtos de pressão"
	SurgeWindow = 6,         -- segundos para reagir ao surto
}

-- ===== Assalto =====
-- Integração com polícia: o posto NÃO tem polícia própria. O alarme silencioso dispara Bus "PoliceAlert"(info);
-- um sistema policial do jogo pode escutar com require(Posto.Modules.Bus).On("PoliceAlert", fn).
Config.Robbery = {
	LootMin = 180, LootMax = 360,
	RobberSpeed = 15,
	StunSeconds = 7,
	CuffHold = 2,
	WaitForAlarm = 12,     -- segundos que o ladrão espera no caixa antes de fugir
}

-- ===== Jukebox / Rádio da loja (cole IDs "rbxassetid://123") =====
Config.Jukebox = {
	Stations = {
		{ Name = "Rádio Posto FM", Id = "" },
		{ Name = "Estrada & Asfalto", Id = "" },
		{ Name = "Madrugada Lo-Fi", Id = "" },
	},
	Volume = 0.45,
}

-- ===== HUD =====
Config.Hud = { ExtraRadius = 120 }

-- ===== Sons =====
-- Cole IDs autorizados como "rbxassetid://123" (ou só o número). Vazio = sem som.
-- Nenhuma mecânica depende de áudio: ID ausente/inválido nunca bloqueia nada.
-- (As estações do rádio da loja ficam em Config.Jukebox.)
Config.Sounds = {
	-- bombas e abastecimento
	Fuel = "",            -- bomba enchendo galão / vazamento
	PumpBeep = "",        -- bomba aceita o abastecimento
	Valve = "",           -- válvula de emergência
	-- alarmes
	Alarm = "",           -- sirene geral do posto (loop)
	Siren = "",           -- reservado: sirene policial (integração futura)
	-- incêndios
	FireLoop = "",        -- loop em cada foco
	Extinguisher = "", Explosion = "",
	-- energia
	Generator = "",       -- partida do gerador
	GeneratorLoop = "",   -- gerador funcionando (loop)
	Breaker = "",         -- disjuntor rearmado
	Spark = "", Blackout = "", Thunder = "",
	-- caixa e loja
	Register = "",        -- caixa registradora
	Purchase = "", Chime = "", Drink = "", Gift = "",
	-- clientes e NPCs
	CustomerServed = "", CustomerAngry = "",
	-- assalto
	RobberyStart = "", Tackle = "", Cuff = "",
	-- veículos
	Truck = "",           -- caminhão-tanque em movimento
	CarStart = "",        -- carro do motorista partindo
	-- rádio e alertas
	Radio = "", Alert = "",
	-- missões
	MissionStart = "", Complete = "", Fail = "",
}

-- ===== Dicas aleatórias que o CONTROLE solta no rádio =====
Config.Tips = {
	"Lembrem: quem enche galão ganha reputação com o posto.",
	"Reputação alta dá desconto na loja e bônus em toda missão.",
	"Extintor sem carga? Recarregue no armário vermelho.",
	"Fiquem de olho no preço do combustível: ele muda com o mercado.",
	"Se o cheiro de gasolina estiver forte, procurem a válvula de emergência.",
}

return Config
]]></ProtectedString>
