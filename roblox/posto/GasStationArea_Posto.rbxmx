						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
					<Item class="Script" referent="RBX66BF215D633C4DECA65992214C2074C5">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local fire = Instance.new("Fire") -- making fire
fire.Parent = script.Parent -- putting it in the parent
fire.Heat = 10
fire.Size = 4

for i = 1, 100 do
	script.Parent.Parent.Humanoid:TakeDamage(0.1) -- making the player take damage
	wait(0.1)
end

fire:Destroy() -- removing the fire and the script
script:Destroy()]]></ProtectedString>
