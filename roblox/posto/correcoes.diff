+-- ===== escala responsiva (celular/tablet) =====
+-- Mantém o visual original em telas grandes; em telas menores cada painel encolhe proporcionalmente
+-- e as posições acompanham, evitando sobreposição (ex.: rádio por cima da reputação em celular).
+local layoutPanels = {
+	{ sys, UDim2.new(0, 14, 0, 70) }, { rep, UDim2.new(0, 14, 0, 284) }, { card, UDim2.new(1, -14, 0, 70) },
+	{ orderChip, UDim2.new(0.5, 0, 1, -110) }, { radio, UDim2.new(0, 14, 1, -120) }, { toastHolder, UDim2.new(0.5, 0, 0, 74) },
+}
+for _, e in ipairs(layoutPanels) do
+	local s = Instance.new("UIScale")
+	s.Name = "EscalaHUD"
+	s.Parent = e[1]
+	e[3] = s
+end
+local function layout()
+	local cam = workspace.CurrentCamera
+	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
+	if vp.X < 1 or vp.Y < 1 then return end
+	-- (vp.Y - 8) / 574: altura em que a coluna esquerda (até 336) e o rádio (238 a partir de baixo) não se tocam
+	local k = math.clamp(math.min(vp.X / 1280, vp.Y / 720, (vp.Y - 8) / 574), 0.5, 1)
+	for _, e in ipairs(layoutPanels) do
+		local p = e[2]
+		e[1].Position = UDim2.new(p.X.Scale, p.X.Offset * k, p.Y.Scale, p.Y.Offset * k)
+		e[3].Scale = k
+	end
+end
+local vpConn
+local function watchCamera()
+	if vpConn then vpConn:Disconnect() end
+	local cam = workspace.CurrentCamera
+	if cam then vpConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
+	layout()
+end
+workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+watchCamera()
+
