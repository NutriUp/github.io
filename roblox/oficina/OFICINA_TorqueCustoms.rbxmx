<Item class="Script" referent="RBXFE42CE833A7B4B4C98AA7C646567A3A6"><Properties><bool name="Disabled">false</bool><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Núcleo. Cria os remotes, inicia os módulos e instala a interface em cada jogador.
-- Estrutura: <modelo da oficina>/{ ...cenário original..., OficinaObjetos (boxes, consoles, mobília), Oficina/{ Core, Modules, Client } }
-- Não depende de nada fora do modelo; integrações (economia, dono do veículo, reparo) ficam em Modules/Config,
-- Economia.DefinirProvedor e Veiculos.DefinirReparo.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local oficina = script.Parent
local modelo = oficina.Parent
local objetos = modelo:WaitForChild("OficinaObjetos")
local modules = oficina:WaitForChild("Modules")

local Config = require(modules.Config)

local remotes = RS:FindFirstChild("OficinaRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "OficinaRemotes"
	remotes.Parent = RS
end
local function remote(classe, nome)
	local r = remotes:FindFirstChild(nome)
	if not r then
		r = Instance.new(classe)
		r.Name = nome
		r.Parent = remotes
	end
	return r
end

local Util = {}
-- som opcional: ID vazio/inválido nunca gera erro
function Util.Som(parent, id, volume)
	if type(id) == "number" then id = "rbxassetid://" .. id end
	if type(id) ~= "string" or id == "" or not parent then return nil end
	local ok, s = pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = volume or 0.6
		s.RollOffMaxDistance = 90
		s.Parent = parent
		s:Play()
		Debris:AddItem(s, 15)
		return s
	end)
	return ok and s or nil
end

local ctx = {
	Oficina = oficina, Modelo = modelo, Objetos = objetos, Config = Config, Util = Util,
	Remotes = { Sessao = remote("RemoteEvent", "Sessao"), Comprar = remote("RemoteFunction", "Comprar") },
}

-- telas dos consoles (LIVRE / EM ATENDIMENTO)
local telas = {}
function ctx.Estado(box)
	local t = telas[box.indice]
	if not t then return end
	if box.sessao then
		t.Text = "EM ATENDIMENTO\n" .. box.sessao.player.DisplayName
		t.TextColor3 = Color3.fromRGB(255, 190, 60)
	else
		t.Text = "BOX " .. box.indice .. " LIVRE\nEstacione e segure E"
		t.TextColor3 = Color3.fromRGB(90, 255, 140)
	end
end

local ordem = { "Economia", "Veiculos", "Visual", "Desempenho", "Portoes", "Sessoes" }
for _, nome in ipairs(ordem) do
	local ms = modules:FindFirstChild(nome)
	if ms then
		local ok, mod = pcall(require, ms)
		if ok then ctx[nome] = mod else warn("[Oficina] falha ao carregar " .. nome .. ": " .. tostring(mod)) end
	else
		warn("[Oficina] módulo ausente: " .. nome)
	end
end
for _, nome in ipairs(ordem) do
	local mod = ctx[nome]
	if mod and mod.Init then
		local ok, err = pcall(mod.Init, ctx)
		if not ok then warn("[Oficina] erro em " .. nome .. ".Init: " .. tostring(err)) end
	end
end

-- telas dos consoles
if ctx.Sessoes then
	for _, box in ipairs(ctx.Sessoes.Boxes()) do
		local tela = box.console:FindFirstChild("Tela") or box.console
		local sg = Instance.new("SurfaceGui")
		sg.Name = "TelaOficina"
		sg.Face = Enum.NormalId.Front
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.Parent = tela
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
		l.Font = Enum.Font.GothamBold
		l.TextScaled = true
		l.Parent = sg
		telas[box.indice] = l
		ctx.Estado(box)
	end
end

-- interface do cliente
local template = oficina:FindFirstChild("Client") and oficina.Client:FindFirstChild("OficinaCliente")
local function instalar(player)
	task.spawn(function()
		if not template then return end
		local pg = player:WaitForChild("PlayerGui", 30)
		if not pg or pg:FindFirstChild("OficinaUI") then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "OficinaUI"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 20
		local raiz = Instance.new("ObjectValue")
		raiz.Name = "Raiz"
		raiz.Value = oficina
		raiz.Parent = gui
		template:Clone().Parent = gui
		gui.Parent = pg
	end)
end
if not template then warn("[Oficina] interface ausente: Oficina.Client.OficinaCliente") end
Players.PlayerAdded:Connect(instalar)
for _, p in ipairs(Players:GetPlayers()) do instalar(p) end

print(string.format("[Oficina] %s ativa: %d box(es), %d portão(ões) automático(s)", Config.Nome,
	ctx.Sessoes and #ctx.Sessoes.Boxes() or 0, ctx.Portoes and ctx.Portoes.Quantidade() or 0))
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBXBC5016BF819D4758846A4EAFCD81A206"><Properties><string name="Name">Modules</string></Properties>
<Item class="ModuleScript" referent="RBX540D2E98F7334989A580E853DA77414C"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Configuração central: identidade, preços, categorias, níveis de melhoria e integrações.
-- Tudo que é preço/opção é lido SOMENTE daqui pelo servidor. O cliente usa este módulo apenas para exibir.
local Config = {}

Config.Nome = "TORQUE CUSTOMS"
Config.Slogan = "Pintura • Performance • Reparo"

-- ===== Economia (usa a moeda que já existe no jogo; a oficina nunca cria leaderstats nem DataStore) =====
Config.Economia = {
	Stat = "Dinheiro",   -- leaderstats.Dinheiro (mesma moeda do posto, OilRig e polícia)
}

-- ===== Atendimento =====
Config.Sessao = {
	TempoMaximo = 300,        -- segundos até o atendimento encerrar sozinho
	VelocidadeMaxima = 8,     -- o carro precisa estar praticamente parado no box
	EsperaEntreCompras = 1,   -- antiflood do remote de compra (s)
	MaxItensCarrinho = 12,
}

-- ===== Dono do veículo =====
-- A oficina procura um dono registrado no modelo do carro (atributos / valores abaixo).
-- Se o sistema de veículos do jogo não registrar dono, vale quem está dirigindo ao iniciar o atendimento.
-- (CarSpawning não pôde ser inspecionado: ajuste os nomes aqui se ele usar outro.)
Config.Dono = {
	Atributos = { "Dono", "Owner", "OwnerId", "OwnerUserId", "DonoUserId", "UserId" },
	Valores = { "Dono", "Owner" },          -- ObjectValue (Player), IntValue (UserId) ou StringValue (nome)
	AceitarMotoristaSemDono = true,
}

-- ===== Portões automáticos =====
Config.Portoes = { RaioAbrir = 34, Tempo = 1.3, FecharApos = 3 }

-- ===== Paleta de pintura (qualquer cor fora dela é "personalizada") =====
Config.Paleta = {
	{ nome = "Preto Ônix", cor = Color3.fromRGB(17, 17, 19) },
	{ nome = "Grafite", cor = Color3.fromRGB(58, 60, 66) },
	{ nome = "Prata", cor = Color3.fromRGB(170, 174, 180) },
	{ nome = "Branco Pérola", cor = Color3.fromRGB(240, 240, 236) },
	{ nome = "Vermelho Torque", cor = Color3.fromRGB(196, 28, 32) },
	{ nome = "Vinho", cor = Color3.fromRGB(96, 18, 30) },
	{ nome = "Laranja", cor = Color3.fromRGB(240, 110, 20) },
	{ nome = "Amarelo", cor = Color3.fromRGB(245, 200, 30) },
	{ nome = "Verde Limão", cor = Color3.fromRGB(140, 220, 40) },
	{ nome = "Verde Inglês", cor = Color3.fromRGB(20, 80, 50) },
	{ nome = "Turquesa", cor = Color3.fromRGB(30, 180, 170) },
	{ nome = "Azul Elétrico", cor = Color3.fromRGB(30, 110, 240) },
	{ nome = "Azul Marinho", cor = Color3.fromRGB(18, 34, 80) },
	{ nome = "Roxo", cor = Color3.fromRGB(110, 50, 190) },
	{ nome = "Rosa", cor = Color3.fromRGB(235, 80, 160) },
	{ nome = "Bronze", cor = Color3.fromRGB(150, 100, 60) },
}

-- ===== Categorias =====
-- tipo "cor": valor = Color3 (preco para cor da paleta, precoPersonalizada para cor livre; remover = false quando permitido)
-- tipo "opcao": valor = id de uma das opcoes
-- tipo "nivel": valor = nível desejado (paga-se a soma dos níveis que faltam)
-- tipo "servico": valor = true
Config.Categorias = {
	{ id = "pintura", nome = "Pintura", grupo = "Visual", tipo = "cor", preco = 350, precoPersonalizada = 600, camera = "frente" },
	{ id = "pintura2", nome = "Pintura secundária", grupo = "Visual", tipo = "cor", preco = 250, precoPersonalizada = 450, camera = "lado" },
	{ id = "rodas", nome = "Rodas e aros", grupo = "Visual", tipo = "cor", preco = 220, precoPersonalizada = 380, camera = "roda" },
	{ id = "vidros", nome = "Insulfilm", grupo = "Visual", tipo = "opcao", camera = "lado", opcoes = {
		{ id = "original", nome = "Original", preco = 0, escuro = 0 },
		{ id = "leve", nome = "Leve", preco = 150, escuro = 0.35 },
		{ id = "medio", nome = "Médio", preco = 260, escuro = 0.6 },
		{ id = "limusine", nome = "Limusine", preco = 400, escuro = 0.88 },
	} },
	{ id = "neon", nome = "Neon inferior", grupo = "Visual", tipo = "cor", preco = 500, precoPersonalizada = 700, remover = true, camera = "baixo" },
	{ id = "aerofolio", nome = "Aerofólio", grupo = "Visual", tipo = "opcao", camera = "tras", opcoes = {
		{ id = "nenhum", nome = "Sem aerofólio", preco = 0 },
		{ id = "lip", nome = "Lip discreto", preco = 300 },
		{ id = "esportivo", nome = "Esportivo", preco = 650 },
		{ id = "gt", nome = "GT de pista", preco = 1100 },
	} },
	{ id = "escape", nome = "Escapamento", grupo = "Visual", tipo = "opcao", camera = "tras", opcoes = {
		{ id = "original", nome = "Original", preco = 0 },
		{ id = "duplo", nome = "Ponteira dupla", preco = 280 },
		{ id = "quadruplo", nome = "Quádruplo esportivo", preco = 520 },
	} },
	-- mecânica: efeito real (ver módulo Desempenho). "campo" descreve o que muda em cada tipo de veículo.
	{ id = "motor", nome = "Motor", grupo = "Mecânica", tipo = "nivel", camera = "frente", descricao = "Mais potência",
		niveis = { { preco = 800, mult = 1.08 }, { preco = 1400, mult = 1.16 }, { preco = 2200, mult = 1.25 }, { preco = 3400, mult = 1.35 } } },
	{ id = "turbo", nome = "Turbo", grupo = "Mecânica", tipo = "nivel", camera = "frente", descricao = "Pressão extra de turbo",
		niveis = { { preco = 1200, boost = 4, mult = 1.06 }, { preco = 2000, boost = 8, mult = 1.12 }, { preco = 3200, boost = 12, mult = 1.18 } } },
	{ id = "transmissao", nome = "Transmissão", grupo = "Mecânica", tipo = "nivel", camera = "lado", descricao = "Relação final mais curta: acelera mais",
		niveis = { { preco = 600, mult = 1.05 }, { preco = 1000, mult = 1.10 }, { preco = 1600, mult = 1.16 } } },
	{ id = "freios", nome = "Freios", grupo = "Mecânica", tipo = "nivel", camera = "roda", descricao = "Mais força de frenagem",
		niveis = { { preco = 500, mult = 1.15 }, { preco = 900, mult = 1.30 }, { preco = 1500, mult = 1.50 } } },
	{ id = "suspensao", nome = "Suspensão", grupo = "Mecânica", tipo = "nivel", camera = "roda", descricao = "Molas e amortecedores mais firmes",
		niveis = { { preco = 450, mult = 1.15 }, { preco = 800, mult = 1.30 }, { preco = 1300, mult = 1.45 } } },
	{ id = "reparo", nome = "Reparo completo", grupo = "Serviços", tipo = "servico", preco = 300, camera = "frente",
		descricao = "Restaura a integridade do veículo" },
}

-- ===== Reparo / diagnóstico =====
-- VehicleDamage não pôde ser inspecionado. A oficina só oferece reparo quando encontra a vida do veículo
-- em um destes atributos (no modelo) ou quando um sistema registra a função com Veiculos.DefinirReparo(...).
Config.Reparo = {
	AtributosVida = { "Vida", "Health", "Saude", "Durabilidade", "VehicleHealth" },
	AtributosVidaMax = { "VidaMax", "MaxHealth", "SaudeMax", "DurabilidadeMax", "VehicleMaxHealth" },
}

-- ===== Câmeras (ângulo em graus ao redor do carro, altura e distância em relação ao tamanho do carro) =====
Config.Cameras = {
	frente = { angulo = 35, altura = 0.55, dist = 1.55 },
	lado = { angulo = 90, altura = 0.45, dist = 1.5 },
	tras = { angulo = 205, altura = 0.6, dist = 1.45 },
	roda = { angulo = 70, altura = 0.18, dist = 1.15 },
	baixo = { angulo = 120, altura = 0.12, dist = 1.4 },
}

-- ===== Sons (cole IDs autorizados "rbxassetid://123"; vazio = sem som; nunca bloqueia nada) =====
Config.Sons = {
	Abrir = "", Navegar = "", Previa = "", Compra = "", Erro = "", Fechar = "",
	Portao = "", Pintura = "", Ferramenta = "",
}

function Config.Categoria(id)
	for _, c in ipairs(Config.Categorias) do
		if c.id == id then return c end
	end
	return nil
end

function Config.Opcao(cat, id)
	for _, o in ipairs(cat.opcoes or {}) do
		if o.id == id then return o end
	end
	return nil
end

-- cor da paleta? (tolerância pequena por causa do arredondamento na rede)
function Config.NaPaleta(cor)
	for _, p in ipairs(Config.Paleta) do
		local c = p.cor
		if math.abs(c.R - cor.R) < 0.012 and math.abs(c.G - cor.G) < 0.012 and math.abs(c.B - cor.B) < 0.012 then return true end
	end
	return false
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXB79239D487DB4DF6A646B83CA9E0123B"><Properties><string name="Name">Economia</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Camada de integração com a economia do jogo (somente servidor).
-- Usa leaderstats.Dinheiro que JÁ existe. Nunca cria leaderstats, moeda ou DataStore.
-- Quando o módulo central de dados (tarefa T03) existir, registre-o aqui sem mexer no resto da oficina:
--   Economia.DefinirProvedor({ Saldo = function(player) return n end, Cobrar = function(player, valor, motivo) return true/false end })
local Economia = {}
local Config
local provedor

function Economia.Init(ctx) Config = ctx.Config end
function Economia.DefinirProvedor(p) provedor = p end

local function valor(player)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(Config.Economia.Stat)
	if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then return v end
	return nil
end

-- saldo atual ou nil se a economia não estiver disponível para este jogador
function Economia.Saldo(player)
	if provedor and provedor.Saldo then
		local ok, n = pcall(provedor.Saldo, player)
		if ok and type(n) == "number" then return n end
		return nil
	end
	local v = valor(player)
	return v and v.Value or nil
end

-- debita no servidor. Devolve (true) ou (false, motivo).
function Economia.Cobrar(player, quantia, motivo)
	if type(quantia) ~= "number" or quantia ~= quantia or quantia < 0 then return false, "valor inválido" end
	quantia = math.ceil(quantia)
	if quantia == 0 then return true end
	if provedor and provedor.Cobrar then
		local ok, res = pcall(provedor.Cobrar, player, quantia, motivo)
		if ok and res then return true end
		return false, "pagamento recusado"
	end
	local v = valor(player)
	if not v then return false, "economia indisponível" end
	if v.Value < quantia then return false, "saldo insuficiente" end
	v.Value -= quantia
	return true
end

return Economia
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXC5D4F2C8D3C941149DC1684473134409"><Properties><string name="Name">Veiculos</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Adaptador dos veículos REAIS do jogo (não cria sistema de veículos paralelo).
-- Descobre o carro a partir do assento do motorista, o dono, o tipo (A-Chassis / VehicleSeat) e cuida de
-- fixar o carro no box e do reparo. Tudo aqui roda no servidor.
local Players = game:GetService("Players")

local Veiculos = {}
local Config
local reparoExterno   -- função registrada por outro sistema (ex.: VehicleDamage): fn(carro) -> bool

function Veiculos.Init(ctx) Config = ctx.Config end

-- ===== identificação =====
local function contaAssentos(model)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("VehicleSeat") then n += 1 end
	end
	return n
end

-- carro (Model) ao qual o assento pertence
function Veiculos.DoAssento(seat)
	if not seat or not seat:IsA("VehicleSeat") then return nil end
	-- A-Chassis: o modelo do carro tem o módulo "A-Chassis Tune" como filho direto
	local a = seat.Parent
	while a and a ~= workspace do
		if a:IsA("Model") and a:FindFirstChild("A-Chassis Tune") then return a end
		a = a.Parent
	end
	-- genérico: o maior Model ancestral que ainda contém só este assento de motorista e tem tamanho de veículo
	local melhor
	a = seat.Parent
	while a and a ~= workspace do
		if a:IsA("Model") then
			if contaAssentos(a) ~= 1 then break end
			local ok, _, size = pcall(function() return a:GetBoundingBox() end)
			if not ok or size.Magnitude > 90 then break end
			melhor = a
		end
		a = a.Parent
	end
	return melhor
end

function Veiculos.AssentoMotorista(car)
	local s = car:FindFirstChild("DriveSeat", true)
	if s and s:IsA("VehicleSeat") then return s end
	return car:FindFirstChildWhichIsA("VehicleSeat", true)
end

function Veiculos.Tipo(car)
	if car:FindFirstChild("A-Chassis Tune") then return "achassis" end
	if car:FindFirstChildWhichIsA("VehicleSeat", true) then return "vehicleseat" end
	return nil
end

-- ===== dono =====
-- devolve (userId | nil, origem)
function Veiculos.Dono(car)
	for _, nome in ipairs(Config.Dono.Atributos) do
		local v = car:GetAttribute(nome)
		if type(v) == "number" then return v, "atributo " .. nome end
		if type(v) == "string" then
			local p = Players:FindFirstChild(v)
			if p then return p.UserId, "atributo " .. nome end
			if tonumber(v) then return tonumber(v), "atributo " .. nome end
		end
	end
	for _, nome in ipairs(Config.Dono.Valores) do
		local o = car:FindFirstChild(nome)
		if o then
			if o:IsA("ObjectValue") and o.Value and o.Value:IsA("Player") then return o.Value.UserId, "valor " .. nome end
			if (o:IsA("IntValue") or o:IsA("NumberValue")) and o.Value ~= 0 then return o.Value, "valor " .. nome end
			if o:IsA("StringValue") and o.Value ~= "" then
				local p = Players:FindFirstChild(o.Value)
				if p then return p.UserId, "valor " .. nome end
			end
		end
	end
	return nil, "sem dono registrado"
end

-- o jogador pode personalizar este carro? (precisa estar no assento do motorista)
function Veiculos.PodeUsar(player, car)
	local seat = Veiculos.AssentoMotorista(car)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not seat or not hum or seat.Occupant ~= hum then return false, "Entre no assento do motorista." end
	local dono = Veiculos.Dono(car)
	if dono then
		if dono ~= player.UserId then return false, "Este veículo pertence a outro jogador." end
		return true
	end
	if Config.Dono.AceitarMotoristaSemDono then return true end
	return false, "Veículo sem dono registrado."
end

-- ===== fixar no box =====
function Veiculos.Fixar(car, fixo, player)
	local seat = Veiculos.AssentoMotorista(car)
	if not seat then return end
	if fixo then
		car:SetAttribute("OfAncoraOriginal", seat.Anchored)
		seat.AssemblyLinearVelocity = Vector3.zero
		seat.AssemblyAngularVelocity = Vector3.zero
		seat.Anchored = true
	else
		local original = car:GetAttribute("OfAncoraOriginal")
		seat.Anchored = original == true
		car:SetAttribute("OfAncoraOriginal", nil)
		-- ancorar tira a posse de rede; devolve ao motorista para o carro voltar a responder
		if player and not seat.Anchored then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and seat.Occupant == hum then pcall(function() seat:SetNetworkOwner(player) end) end
		end
	end
end

-- faz o motorista sentar de novo (o A-Chassis relê o Tune a cada vez que alguém assume o volante)
function Veiculos.Reassentar(car, player)
	local seat = Veiculos.AssentoMotorista(car)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not seat or not hum or seat.Occupant ~= hum then return end
	task.spawn(function()
		hum.Sit = false
		task.wait(0.6)
		if hum.Parent and hum.Health > 0 and seat.Parent and not seat.Occupant then
			seat:Sit(hum)
		end
	end)
end

-- ===== reparo / diagnóstico =====
function Veiculos.DefinirReparo(fn) reparoExterno = fn end

-- devolve { suportado, vida, max, danificado }
function Veiculos.Diagnostico(car)
	for i, nome in ipairs(Config.Reparo.AtributosVida) do
		local v = car:GetAttribute(nome)
		if type(v) == "number" then
			local max
			for _, nm in ipairs(Config.Reparo.AtributosVidaMax) do
				local m = car:GetAttribute(nm)
				if type(m) == "number" then max = m break end
			end
			max = max or car:GetAttribute("OfVidaMax") or math.max(v, 100)
			if not car:GetAttribute("OfVidaMax") then car:SetAttribute("OfVidaMax", max) end
			return { suportado = true, vida = v, max = max, danificado = v < max - 0.5, atributo = nome }
		end
	end
	if reparoExterno then return { suportado = true, danificado = true, externo = true } end
	return { suportado = false }
end

function Veiculos.Reparar(car)
	local d = Veiculos.Diagnostico(car)
	if not d.suportado then return false end
	if reparoExterno then
		local ok, res = pcall(reparoExterno, car)
		if ok and res ~= false then return true end
		if d.externo then return false end
	end
	if d.atributo then
		car:SetAttribute(d.atributo, d.max)
		return true
	end
	return false
end

return Veiculos
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX619ECB79F7EC4F4696C206B97E1471B3"><Properties><string name="Name">Visual</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Personalização visual (módulo compartilhado: servidor aplica de verdade, cliente usa na pré-visualização).
-- Funciona em qualquer modelo de carro: classifica as peças uma vez (carroceria primária/secundária, rodas, vidros)
-- e constrói acessórios (neon, aerofólio, escapamento) medindo o próprio carro. Nada é específico de um modelo.
local RunService = game:GetService("RunService")

local Visual = {}
local Config

function Visual.Init(ctx) Config = ctx.Config end
function Visual.UsarConfig(cfg) Config = cfg end

local PASTAS = { neon = "OfNeon", aerofolio = "OfAerofolio", escape = "OfEscape" }
Visual.Pastas = PASTAS

local function nossa(inst)
	local a = inst
	while a do
		if a:IsA("Folder") and a.Name:sub(1, 2) == "Of" then return true end
		a = a.Parent
	end
	return false
end

local function assento(car)
	local s = car:FindFirstChild("DriveSeat", true)
	if s and s:IsA("VehicleSeat") then return s end
	return car:FindFirstChildWhichIsA("VehicleSeat", true)
end

local function chaveCor(c)
	return math.floor(c.R * 15 + 0.5) * 256 + math.floor(c.G * 15 + 0.5) * 16 + math.floor(c.B * 15 + 0.5)
end

local function area(p)
	local s = p.Size
	return s.X * s.Y + s.Y * s.Z + s.X * s.Z
end

-- ===== classificação (servidor, uma vez por carro) =====
-- Marca cada peça com o atributo OfGrupo: "p" carroceria primária, "s" secundária, "r" rodas, "v" vidros,
-- e guarda cor/transparência de fábrica (OfCor0 / OfTr0).
function Visual.Preparar(car)
	if car:GetAttribute("OfPreparado") then return end
	local rodas = car:FindFirstChild("Wheels") or car:FindFirstChild("Rodas")
	local corpo = {}
	local soma = {}
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and not nossa(d) and d.Transparency < 0.95 then
			local nome = d.Name:lower()
			local grupo
			if (rodas and d:IsDescendantOf(rodas)) or nome:find("wheel") or nome:find("roda") or nome:find("rim") or nome:find("tire") or nome:find("pneu") then
				-- pneus (muito escuros) ficam de fora: só o aro é pintado
				local _, _, v = d.Color:ToHSV()
				if v > 0.22 or nome:find("rim") or nome:find("aro") then grupo = "r" end
			elseif d.Material == Enum.Material.Glass or nome:find("window") or nome:find("glass") or nome:find("vidro") or nome:find("windshield") then
				grupo = "v"
			elseif d.Material ~= Enum.Material.Neon and not d:IsA("VehicleSeat") and not d:IsA("Seat")
				and not d:FindFirstChildWhichIsA("Light") and d.Transparency < 0.4 then
				table.insert(corpo, d)
				local k = chaveCor(d.Color)
				soma[k] = (soma[k] or 0) + area(d)
			end
			if grupo then
				d:SetAttribute("OfGrupo", grupo)
				d:SetAttribute("OfCor0", d.Color)
				d:SetAttribute("OfTr0", d.Transparency)
			end
		end
	end
	-- cor dominante = pintura primária; segunda cor relevante (≥ 6% da área) = secundária
	local ordem, total = {}, 0
	for k, a in pairs(soma) do
		table.insert(ordem, { k, a })
		total += a
	end
	table.sort(ordem, function(a, b) return a[2] > b[2] end)
	local prim = ordem[1] and ordem[1][1]
	local sec = ordem[2] and ordem[2][2] >= total * 0.06 and ordem[2][1] or nil
	for _, d in ipairs(corpo) do
		local k = chaveCor(d.Color)
		local grupo = (k == prim and "p") or (k == sec and "s") or nil
		if grupo then
			d:SetAttribute("OfGrupo", grupo)
			d:SetAttribute("OfCor0", d.Color)
			d:SetAttribute("OfTr0", d.Transparency)
		end
	end
	car:SetAttribute("OfPreparado", true)
end

function Visual.Grupo(car, grupo)
	local out = {}
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("OfGrupo") == grupo then table.insert(out, d) end
	end
	return out
end

-- quais categorias visuais este carro aceita
function Visual.Suporte(car)
	local n = { p = 0, s = 0, r = 0, v = 0 }
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") then
			local g = d:GetAttribute("OfGrupo")
			if g and n[g] then n[g] += 1 end
		end
	end
	local temAssento = assento(car) ~= nil
	return {
		pintura = n.p > 0, pintura2 = n.s > 0, rodas = n.r > 0, vidros = n.v > 0,
		neon = temAssento, aerofolio = temAssento, escape = temAssento,
	}
end

-- ===== pintura / vidros =====
function Visual.Pintar(car, grupo, cor)
	for _, p in ipairs(Visual.Grupo(car, grupo)) do
		p.Color = cor or p:GetAttribute("OfCor0") or p.Color
	end
end

function Visual.Vidros(car, escuro)
	escuro = math.clamp(escuro or 0, 0, 1)
	for _, p in ipairs(Visual.Grupo(car, "v")) do
		local cor0 = p:GetAttribute("OfCor0") or p.Color
		local tr0 = p:GetAttribute("OfTr0") or p.Transparency
		p.Color = cor0:Lerp(Color3.fromRGB(8, 8, 10), escuro)
		p.Transparency = tr0 * (1 - escuro * 0.92)
	end
end

-- ===== medidas do carro (no espaço do assento do motorista: -Z = frente) =====
function Visual.Medidas(car)
	local seat = assento(car)
	if not seat then return nil end
	local ref = seat.CFrame
	local lo, hi
	local loCorpo
	local rodas = car:FindFirstChild("Wheels") or car:FindFirstChild("Rodas")
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("BasePart") and not nossa(d) and d.Transparency < 0.95 then
			local c = ref:ToObjectSpace(d.CFrame)
			local s = d.Size / 2
			local ex = math.abs(c.RightVector.X) * s.X + math.abs(c.UpVector.X) * s.Y + math.abs(c.LookVector.X) * s.Z
			local ey = math.abs(c.RightVector.Y) * s.X + math.abs(c.UpVector.Y) * s.Y + math.abs(c.LookVector.Y) * s.Z
			local ez = math.abs(c.RightVector.Z) * s.X + math.abs(c.UpVector.Z) * s.Y + math.abs(c.LookVector.Z) * s.Z
			local e = Vector3.new(ex, ey, ez)
			local a, b = c.Position - e, c.Position + e
			lo = lo and lo:Min(a) or a
			hi = hi and hi:Max(b) or b
			if not (rodas and d:IsDescendantOf(rodas)) then
				loCorpo = loCorpo and math.min(loCorpo, a.Y) or a.Y
			end
		end
	end
	if not lo then return nil end
	return {
		ref = ref, seat = seat, lo = lo, hi = hi,
		largura = hi.X - lo.X, comprimento = hi.Z - lo.Z, altura = hi.Y - lo.Y,
		centroX = (lo.X + hi.X) / 2, chao = lo.Y, baseCorpo = loCorpo or lo.Y,
	}
end

local function limpar(car, nome)
	local f = car:FindFirstChild(nome)
	if f then f:Destroy() end
end

local function peca(pasta, m, props, cfLocal, solto)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do p[k] = v end
	p.CFrame = m.ref * cfLocal
	if solto then
		-- pré-visualização no cliente: o carro está fixo no box, basta ancorar
		p.Anchored = true
	else
		p.Anchored = false
		local w = Instance.new("WeldConstraint")
		w.Part0 = p
		w.Part1 = m.seat
		w.Parent = p
	end
	p.Parent = pasta
	return p
end

-- altura da "tampa traseira": raio para baixo sobre a traseira do carro
local function alturaTraseira(car, m)
	local lista = {}
	for _, c in ipairs(car:GetChildren()) do
		if not (c:IsA("Folder") and c.Name:sub(1, 2) == "Of") then table.insert(lista, c) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = lista
	local origem = m.ref * Vector3.new(m.centroX, m.hi.Y + 3, m.hi.Z - math.min(1.6, m.comprimento * 0.1))
	local r = workspace:Raycast(origem, m.ref:VectorToWorldSpace(Vector3.new(0, -(m.altura + 6), 0)), params)
	if r then return m.ref:PointToObjectSpace(r.Position).Y end
	return m.lo.Y + m.altura * 0.62
end

-- ===== neon =====
-- cor = Color3 ou nil (remove). nome/solto servem à pré-visualização do cliente.
function Visual.Neon(car, cor, nome, solto)
	nome = nome or PASTAS.neon
	limpar(car, nome)
	if not cor then return nil end
	local m = Visual.Medidas(car)
	if not m then return nil end
	local pasta = Instance.new("Folder")
	pasta.Name = nome
	local y = m.baseCorpo + 0.12
	local L, W = m.comprimento * 0.72, m.largura * 0.78
	local cz = (m.lo.Z + m.hi.Z) / 2
	local props = { Material = Enum.Material.Neon, Color = cor, Name = "Neon" }
	local function tira(size, pos)
		local p = peca(pasta, m, props, CFrame.new(pos), solto)
		p.Size = size
		return p
	end
	tira(Vector3.new(0.18, 0.18, L), Vector3.new(m.centroX - W / 2, y, cz))
	tira(Vector3.new(0.18, 0.18, L), Vector3.new(m.centroX + W / 2, y, cz))
	tira(Vector3.new(W, 0.18, 0.18), Vector3.new(m.centroX, y, cz - L / 2))
	local centro = tira(Vector3.new(W, 0.18, 0.18), Vector3.new(m.centroX, y, cz + L / 2))
	local luz = Instance.new("PointLight")
	luz.Color = cor
	luz.Range = math.clamp(m.comprimento * 0.9, 10, 22)
	luz.Brightness = 2.2
	luz.Shadows = false
	luz.Parent = centro
	local luz2 = luz:Clone()
	luz2.Parent = pasta:GetChildren()[3]
	pasta.Parent = car
	return pasta
end

-- ===== aerofólio =====
function Visual.Aerofolio(car, id, nome, solto)
	nome = nome or PASTAS.aerofolio
	limpar(car, nome)
	if not id or id == "nenhum" then return nil end
	local m = Visual.Medidas(car)
	if not m then return nil end
	local pasta = Instance.new("Folder")
	pasta.Name = nome
	local deck = alturaTraseira(car, m)
	local z = m.hi.Z - math.min(1.4, m.comprimento * 0.09)
	local W = m.largura
	local preto = { Color = Color3.fromRGB(22, 22, 24), Material = Enum.Material.SmoothPlastic, Name = "Aerofolio" }
	local function bloco(size, pos, ang)
		local p = peca(pasta, m, preto, CFrame.new(pos) * CFrame.Angles(math.rad(ang or 0), 0, 0), solto)
		p.Size = size
		return p
	end
	if id == "lip" then
		bloco(Vector3.new(W * 0.82, 0.16, 0.7), Vector3.new(m.centroX, deck + 0.12, z), -8)
	elseif id == "esportivo" then
		local h = 0.75
		for _, s in ipairs({ -1, 1 }) do
			bloco(Vector3.new(0.14, h, 0.5), Vector3.new(m.centroX + s * W * 0.28, deck + h / 2, z))
		end
		bloco(Vector3.new(W * 0.86, 0.14, 1.05), Vector3.new(m.centroX, deck + h + 0.05, z + 0.05), -6)
	elseif id == "gt" then
		local h = 1.35
		for _, s in ipairs({ -1, 1 }) do
			bloco(Vector3.new(0.16, h, 0.7), Vector3.new(m.centroX + s * W * 0.24, deck + h / 2, z))
			bloco(Vector3.new(0.1, 0.75, 1.5), Vector3.new(m.centroX + s * W * 0.5, deck + h + 0.1, z + 0.1))
		end
		bloco(Vector3.new(W, 0.16, 1.35), Vector3.new(m.centroX, deck + h + 0.05, z + 0.1), -5)
	else
		pasta:Destroy()
		return nil
	end
	pasta.Parent = car
	return pasta
end

-- ===== escapamento =====
function Visual.Escape(car, id, nome, solto)
	nome = nome or PASTAS.escape
	limpar(car, nome)
	if not id or id == "original" then return nil end
	local m = Visual.Medidas(car)
	if not m then return nil end
	local pasta = Instance.new("Folder")
	pasta.Name = nome
	local y = m.baseCorpo + 0.38
	local z = m.hi.Z + 0.05
	local cromado = { Color = Color3.fromRGB(190, 192, 198), Material = Enum.Material.Metal, Reflectance = 0.25, Shape = Enum.PartType.Cylinder, Name = "Ponteira" }
	local function ponteira(x, d)
		local p = peca(pasta, m, cromado, CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(90), 0), solto)
		p.Size = Vector3.new(0.9, d, d)
		local miolo = peca(pasta, m, { Color = Color3.fromRGB(12, 12, 12), Shape = Enum.PartType.Cylinder, Name = "Miolo" },
			CFrame.new(x, y, z + 0.06) * CFrame.Angles(0, math.rad(90), 0), solto)
		miolo.Size = Vector3.new(0.82, d * 0.72, d * 0.72)
	end
	local W = m.largura
	if id == "duplo" then
		ponteira(m.centroX - W * 0.3, 0.42)
		ponteira(m.centroX + W * 0.3, 0.42)
	elseif id == "quadruplo" then
		for _, s in ipairs({ -1, 1 }) do
			ponteira(m.centroX + s * W * 0.34, 0.46)
			ponteira(m.centroX + s * (W * 0.34 - 0.55), 0.46)
		end
	else
		pasta:Destroy()
		return nil
	end
	pasta.Parent = car
	return pasta
end

-- ===== estado salvo no carro (atributos) =====
-- OfPintura / OfPintura2 / OfRodas / OfNeon : Color3   OfVidros / OfAerofolio / OfEscape : id da opção
function Visual.LerEstado(car)
	return {
		pintura = car:GetAttribute("OfPintura"), pintura2 = car:GetAttribute("OfPintura2"),
		rodas = car:GetAttribute("OfRodas"), neon = car:GetAttribute("OfNeon"),
		vidros = car:GetAttribute("OfVidros") or "original",
		aerofolio = car:GetAttribute("OfAerofolio") or "nenhum",
		escape = car:GetAttribute("OfEscape") or "original",
	}
end

-- aplica uma categoria. solto/sufixo = pré-visualização local (não toca nos acessórios reais).
function Visual.AplicarCategoria(car, id, valor, previa)
	local sufixo = previa and "_Previa" or ""
	if id == "pintura" then
		Visual.Pintar(car, "p", valor)
	elseif id == "pintura2" then
		Visual.Pintar(car, "s", valor)
	elseif id == "rodas" then
		Visual.Pintar(car, "r", valor)
	elseif id == "vidros" then
		local cat = Config.Categoria("vidros")
		local op = cat and Config.Opcao(cat, valor)
		Visual.Vidros(car, op and op.escuro or 0)
	elseif id == "neon" then
		Visual.Neon(car, typeof(valor) == "Color3" and valor or nil, PASTAS.neon .. sufixo, previa)
	elseif id == "aerofolio" then
		Visual.Aerofolio(car, valor, PASTAS.aerofolio .. sufixo, previa)
	elseif id == "escape" then
		Visual.Escape(car, valor, PASTAS.escape .. sufixo, previa)
	end
end

-- reaplica tudo a partir dos atributos (servidor; também serve para restaurar um carro salvo no futuro)
function Visual.AplicarEstado(car)
	local e = Visual.LerEstado(car)
	if e.pintura then Visual.Pintar(car, "p", e.pintura) end
	if e.pintura2 then Visual.Pintar(car, "s", e.pintura2) end
	if e.rodas then Visual.Pintar(car, "r", e.rodas) end
	Visual.AplicarCategoria(car, "vidros", e.vidros)
	Visual.Neon(car, e.neon)
	Visual.Aerofolio(car, e.aerofolio)
	Visual.Escape(car, e.escape)
end

Visual.EhServidor = RunService:IsServer()

return Visual
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3ECCA878FC6F460A84B8E99E9C0F587B"><Properties><string name="Name">Desempenho</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Melhorias mecânicas com efeito REAL (módulo compartilhado).
-- Os níveis ficam em atributos do carro (OfN_motor, OfN_turbo, OfN_transmissao, OfN_freios, OfN_suspensao),
-- definidos somente pelo servidor.
--   • A-Chassis: a física roda no cliente do motorista, que lê o módulo "A-Chassis Tune" toda vez que assume o
--     volante. Por isso cada cliente ajusta a própria cópia do Tune a partir dos atributos (AplicarTuneCliente)
--     e o servidor faz o motorista sentar de novo ao sair da oficina. A suspensão (molas) é ajustada no servidor.
--   • VehicleSeat clássico: o servidor ajusta MaxSpeed/Torque do assento.
local CollectionService = game:GetService("CollectionService")

local Desempenho = {}
local Config

Desempenho.Ids = { "motor", "turbo", "transmissao", "freios", "suspensao" }
Desempenho.Tag = "OficinaTunado"

function Desempenho.Init(ctx) Config = ctx.Config end
function Desempenho.UsarConfig(cfg) Config = cfg end

function Desempenho.Nivel(car, id)
	local n = car:GetAttribute("OfN_" .. id)
	return type(n) == "number" and n or 0
end

local function dado(id, nivel)
	local cat = Config.Categoria(id)
	return cat and cat.niveis and cat.niveis[nivel] or nil
end

local function mult(car, id)
	local d = dado(id, Desempenho.Nivel(car, id))
	return d and d.mult or 1
end

local function molas(car)
	local out = {}
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("SpringConstraint") then table.insert(out, d) end
	end
	return out
end

local function tipo(car)
	if car:FindFirstChild("A-Chassis Tune") then return "achassis" end
	if car:FindFirstChildWhichIsA("VehicleSeat", true) then return "vehicleseat" end
	return nil
end
Desempenho.Tipo = tipo

-- quais melhorias este veículo realmente suporta
function Desempenho.Suporte(car)
	local t = tipo(car)
	local temMolas = #molas(car) > 0
	if t == "achassis" then
		return { motor = true, turbo = true, transmissao = true, freios = true, suspensao = temMolas }
	elseif t == "vehicleseat" then
		local seat = car:FindFirstChildWhichIsA("VehicleSeat", true)
		local classico = seat ~= nil and seat.MaxSpeed > 0 and seat.Torque > 0
		return { motor = classico, turbo = classico, transmissao = classico, freios = false, suspensao = temMolas }
	end
	return { motor = false, turbo = false, transmissao = false, freios = false, suspensao = false }
end

-- ===== servidor =====
function Desempenho.AplicarServidor(car)
	-- suspensão: molas reais do carro
	local ms = mult(car, "suspensao")
	for _, sp in ipairs(molas(car)) do
		if sp:GetAttribute("OfK0") == nil then
			sp:SetAttribute("OfK0", sp.Stiffness)
			sp:SetAttribute("OfD0", sp.Damping)
		end
		sp.Stiffness = sp:GetAttribute("OfK0") * ms
		sp.Damping = sp:GetAttribute("OfD0") * ms
	end
	local t = tipo(car)
	if t == "vehicleseat" then
		local seat = car:FindFirstChildWhichIsA("VehicleSeat", true)
		if seat then
			if seat:GetAttribute("OfVel0") == nil then
				seat:SetAttribute("OfVel0", seat.MaxSpeed)
				seat:SetAttribute("OfTq0", seat.Torque)
			end
			seat.MaxSpeed = seat:GetAttribute("OfVel0") * mult(car, "motor") * mult(car, "turbo")
			seat.Torque = seat:GetAttribute("OfTq0") * mult(car, "motor") * mult(car, "transmissao")
		end
	elseif t == "achassis" then
		-- os clientes escutam esta tag e ajustam o Tune local
		CollectionService:AddTag(car, Desempenho.Tag)
	end
end

-- ===== cliente (A-Chassis) =====
local CAMPOS_BASE = { "Horsepower", "E_Horsepower", "E_Torque", "BrakeForce", "PBrakeForce", "FBrakeForce", "RBrakeForce", "FinalDrive", "T_Boost", "Turbochargers" }

function Desempenho.AplicarTuneCliente(car)
	local ms = car:FindFirstChild("A-Chassis Tune")
	if not ms or not ms:IsA("ModuleScript") then return false end
	local ok, tune = pcall(require, ms)
	if not ok or type(tune) ~= "table" then return false end
	if not tune._OfBase then
		local base = {}
		for _, k in ipairs(CAMPOS_BASE) do
			if type(tune[k]) == "number" then base[k] = tune[k] end
		end
		tune._OfBase = base
	end
	local b = tune._OfBase
	local function set(k, v) if b[k] then tune[k] = v end end
	local m = mult(car, "motor")
	set("Horsepower", (b.Horsepower or 0) * m)
	set("E_Horsepower", (b.E_Horsepower or 0) * m)
	set("E_Torque", (b.E_Torque or 0) * m)
	local f = mult(car, "freios")
	for _, k in ipairs({ "BrakeForce", "PBrakeForce", "FBrakeForce", "RBrakeForce" }) do set(k, (b[k] or 0) * f) end
	set("FinalDrive", (b.FinalDrive or 0) * mult(car, "transmissao"))
	local nt = Desempenho.Nivel(car, "turbo")
	local dt = dado("turbo", nt)
	if b.T_Boost then
		tune.T_Boost = b.T_Boost + (dt and dt.boost or 0)
		if b.Turbochargers then tune.Turbochargers = (nt > 0) and math.max(b.Turbochargers, 1) or b.Turbochargers end
	elseif dt and b.Horsepower then
		-- chassi sem turbo configurável: o ganho entra como potência
		tune.Horsepower = tune.Horsepower * (dt.mult or 1)
	end
	return true
end

return Desempenho
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXF9111A97D12F4A62B67EFA276750FC72"><Properties><string name="Name">Portoes</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Portões de enrolar automáticos. No modelo original os portões são malhas sólidas e fechadas
-- (nenhum carro entrava). Aqui eles "enrolam" para cima quando alguém se aproxima e fecham depois.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Portoes = {}
local ctx
local lista = {}

local function mover(p, abrir)
	if p.aberto == abrir then return end
	p.aberto = abrir
	local cfg = ctx.Config.Portoes
	local info = TweenInfo.new(cfg.Tempo, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	ctx.Util.Som(p.part, ctx.Config.Sons.Portao, 0.6)
	if abrir then
		p.part.CanCollide = false
		local alvo = Vector3.new(p.size.X, 1.6, p.size.Z)
		TweenService:Create(p.part, info, { Size = alvo, CFrame = p.cf * CFrame.new(0, (p.size.Y - 1.6) / 2, 0) }):Play()
	else
		local tw = TweenService:Create(p.part, info, { Size = p.size, CFrame = p.cf })
		tw:Play()
		tw.Completed:Once(function()
			if not p.aberto then p.part.CanCollide = true end
		end)
	end
end

function Portoes.Init(c)
	ctx = c
	for _, d in ipairs(ctx.Modelo:GetDescendants()) do
		if d:IsA("MeshPart") and d.Name == "Racing_Garage_Rollup_a" then
			table.insert(lista, { part = d, cf = d.CFrame, size = d.Size, aberto = false, vazio = 0 })
		end
	end
	if #lista == 0 then
		warn("[Oficina] portões (Racing_Garage_Rollup_a) não encontrados; a entrada fica como está no modelo")
		return
	end
	task.spawn(function()
		local cfg = ctx.Config.Portoes
		while true do
			task.wait(0.4)
			for _, p in ipairs(lista) do
				local perto = false
				for _, pl in ipairs(Players:GetPlayers()) do
					local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
					if r and (r.Position - p.cf.Position).Magnitude <= cfg.RaioAbrir then perto = true break end
				end
				if perto then
					p.vazio = 0
					mover(p, true)
				else
					p.vazio += 0.4
					if p.vazio >= cfg.FecharApos then mover(p, false) end
				end
			end
		end
	end)
end

function Portoes.Quantidade() return #lista end

return Portoes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXC7755CE2BB60486DA77245DDB60F5A7C"><Properties><string name="Name">Sessoes</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Atendimentos (somente servidor). Um box atende um jogador por vez; cada jogador só mexe no
-- veículo que está dirigindo. Toda compra é validada e precificada aqui — o cliente só envia "o que quer".
local Players = game:GetService("Players")

local Sessoes = {}
local ctx, Config, Veiculos, Visual, Desempenho, Economia
local boxes = {}          -- [i] = { zona, console, prompt, sessao }
local porJogador = {}     -- [player] = sessao

local function aviso(player, tipo, texto)
	if player and player.Parent then ctx.Remotes.Sessao:FireClient(player, "aviso", { tipo = tipo, texto = texto }) end
end

local function dentro(zona, pos)
	local p = zona.CFrame:PointToObjectSpace(pos)
	local s = zona.Size / 2
	return math.abs(p.X) <= s.X and math.abs(p.Z) <= s.Z and math.abs(p.Y) <= s.Y + 6
end

local function niveis(car)
	local t = {}
	for _, id in ipairs(Desempenho.Ids) do t[id] = Desempenho.Nivel(car, id) end
	return t
end

local function resumo(car)
	local sup = Visual.Suporte(car)
	for k, v in pairs(Desempenho.Suporte(car)) do sup[k] = v end
	local diag = Veiculos.Diagnostico(car)
	sup.reparo = diag.suportado
	return { suporte = sup, estado = Visual.LerEstado(car), niveis = niveis(car), diagnostico = diag, tipo = Veiculos.Tipo(car) }
end

-- ===== encerrar =====
function Sessoes.Encerrar(player, motivo)
	local s = porJogador[player]
	if not s then return end
	porJogador[player] = nil
	s.box.sessao = nil
	if s.box.prompt then s.box.prompt.Enabled = true end
	local car = s.car
	if car and car.Parent then
		car:SetAttribute("OfEmSessao", nil)
		Veiculos.Fixar(car, false, player)
		if s.mudouMecanica and player.Parent then Veiculos.Reassentar(car, player) end
	end
	if player.Parent then
		ctx.Remotes.Sessao:FireClient(player, "encerrar", { motivo = motivo })
	end
	ctx.Estado(s.box)
end

-- ===== iniciar =====
function Sessoes.Iniciar(player, box)
	if porJogador[player] then return end
	if box.sessao then aviso(player, "aviso", "Este box já está em atendimento.") return end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if not hum or hum.Health <= 0 or not seat or not seat:IsA("VehicleSeat") then
		aviso(player, "aviso", "Traga seu veículo: dirija até o box e fique no volante.")
		return
	end
	local car = Veiculos.DoAssento(seat)
	if not car then aviso(player, "aviso", "Veículo não reconhecido pela oficina.") return end
	if Veiculos.AssentoMotorista(car) ~= seat then aviso(player, "aviso", "Só o motorista pode iniciar o atendimento.") return end
	if not dentro(box.zona, seat.Position) then aviso(player, "aviso", "Posicione o veículo dentro do box (faixas amarelas).") return end
	if seat.AssemblyLinearVelocity.Magnitude > Config.Sessao.VelocidadeMaxima then aviso(player, "aviso", "Pare o veículo para iniciar.") return end
	if car:GetAttribute("OfEmSessao") then aviso(player, "aviso", "Este veículo já está em atendimento.") return end
	local pode, por = Veiculos.PodeUsar(player, car)
	if not pode then aviso(player, "erro", por) return end

	local okPrep, errPrep = pcall(Visual.Preparar, car)
	if not okPrep then warn("[Oficina] falha ao preparar veículo: " .. tostring(errPrep)) aviso(player, "erro", "Não foi possível analisar este veículo.") return end

	local s = { player = player, car = car, seat = seat, box = box, inicio = os.clock(), ultimaCompra = 0, ocupado = false, mudouMecanica = false }
	box.sessao = s
	porJogador[player] = s
	car:SetAttribute("OfEmSessao", player.UserId)
	Veiculos.Fixar(car, true)
	if box.prompt then box.prompt.Enabled = false end
	local dados = resumo(car)
	dados.car = car
	dados.box = box.indice
	dados.saldo = Economia.Saldo(player)
	ctx.Remotes.Sessao:FireClient(player, "iniciar", dados)
	ctx.Estado(box)
end

-- ===== compra =====
-- devolve (preço, valorNormalizado) ou (nil, motivo)
local function avaliar(car, cat, valor, info)
	if not info.suporte[cat.id] then return nil, cat.nome .. " não está disponível para este veículo." end
	if cat.tipo == "cor" then
		if valor == false then
			if not cat.remover then return nil, "opção inválida" end
			if not info.estado[cat.id] then return nil, cat.nome .. ": nada para remover." end
			return 0, false
		end
		if typeof(valor) ~= "Color3" then return nil, "cor inválida" end
		local cor = Color3.new(math.clamp(valor.R, 0, 1), math.clamp(valor.G, 0, 1), math.clamp(valor.B, 0, 1))
		return Config.NaPaleta(cor) and cat.preco or cat.precoPersonalizada, cor
	elseif cat.tipo == "opcao" then
		if type(valor) ~= "string" then return nil, "opção inválida" end
		local op = Config.Opcao(cat, valor)
		if not op then return nil, "opção inválida" end
		if info.estado[cat.id] == op.id then return nil, cat.nome .. ": já instalado." end
		return op.preco, op.id
	elseif cat.tipo == "nivel" then
		if type(valor) ~= "number" or valor % 1 ~= 0 then return nil, "nível inválido" end
		local atual = info.niveis[cat.id] or 0
		if valor <= atual or valor > #cat.niveis then return nil, cat.nome .. ": nível indisponível." end
		local total = 0
		for n = atual + 1, valor do total += cat.niveis[n].preco end
		return total, valor
	elseif cat.tipo == "servico" then
		if valor ~= true then return nil, "opção inválida" end
		if not info.diagnostico.suportado then return nil, "Reparo indisponível para este veículo." end
		if not info.diagnostico.danificado then return nil, "O veículo não precisa de reparo." end
		return cat.preco, true
	end
	return nil, "categoria inválida"
end

local ATRIBUTO = { pintura = "OfPintura", pintura2 = "OfPintura2", rodas = "OfRodas", neon = "OfNeon",
	vidros = "OfVidros", aerofolio = "OfAerofolio", escape = "OfEscape" }

local function aplicar(s, cat, valor)
	local car = s.car
	if cat.tipo == "nivel" then
		car:SetAttribute("OfN_" .. cat.id, valor)
		Desempenho.AplicarServidor(car)
		s.mudouMecanica = true
	elseif cat.tipo == "servico" then
		Veiculos.Reparar(car)
	else
		car:SetAttribute(ATRIBUTO[cat.id], valor ~= false and valor or nil)
		Visual.AplicarCategoria(car, cat.id, valor ~= false and valor or nil)
	end
end

function Sessoes.Comprar(player, carrinho)
	local s = porJogador[player]
	if not s then return { ok = false, erro = "Nenhum atendimento em andamento." } end
	if s.ocupado then return { ok = false, erro = "Compra em processamento." } end
	if os.clock() - s.ultimaCompra < Config.Sessao.EsperaEntreCompras then return { ok = false, erro = "Aguarde um instante." } end
	if type(carrinho) ~= "table" then return { ok = false, erro = "Pedido inválido." } end
	local car = s.car
	if not car.Parent or s.seat.Occupant == nil or not dentro(s.box.zona, s.seat.Position) then
		Sessoes.Encerrar(player, "veículo fora do box")
		return { ok = false, erro = "Atendimento encerrado." }
	end
	s.ocupado = true
	local resposta
	local okExec, errExec = pcall(function()
		local info = resumo(car)
		local itens, total, n = {}, 0, 0
		for id, valor in pairs(carrinho) do
			n += 1
			if n > Config.Sessao.MaxItensCarrinho then resposta = { ok = false, erro = "Itens demais no pedido." } return end
			local cat = type(id) == "string" and Config.Categoria(id) or nil
			if not cat then resposta = { ok = false, erro = "Item desconhecido." } return end
			local preco, norm = avaliar(car, cat, valor, info)
			if not preco then resposta = { ok = false, erro = norm } return end
			table.insert(itens, { cat = cat, valor = norm })
			total += preco
		end
		if #itens == 0 then resposta = { ok = false, erro = "Carrinho vazio." } return end
		local saldo = Economia.Saldo(player)
		if total > 0 then
			if saldo == nil then resposta = { ok = false, erro = "Economia indisponível no momento." } return end
			if saldo < total then resposta = { ok = false, erro = "Saldo insuficiente." } return end
			local pago, motivo = Economia.Cobrar(player, total, "oficina")
			if not pago then resposta = { ok = false, erro = "Pagamento recusado: " .. tostring(motivo) } return end
		end
		for _, it in ipairs(itens) do
			local okA, errA = pcall(aplicar, s, it.cat, it.valor)
			if not okA then warn("[Oficina] erro ao aplicar " .. it.cat.id .. ": " .. tostring(errA)) end
		end
		s.ultimaCompra = os.clock()
		local novo = resumo(car)
		novo.ok = true
		novo.total = total
		novo.saldo = Economia.Saldo(player)
		resposta = novo
		ctx.Util.Som(s.box.console, Config.Sons.Compra, 0.7)
	end)
	s.ocupado = false
	if not okExec then
		warn("[Oficina] erro na compra: " .. tostring(errExec))
		return { ok = false, erro = "Erro interno ao processar o pedido." }
	end
	return resposta
end

-- ===== inicialização =====
function Sessoes.Ativa(player) return porJogador[player] end
function Sessoes.Boxes() return boxes end

function Sessoes.Init(c)
	ctx = c
	Config, Veiculos, Visual, Desempenho, Economia = c.Config, c.Veiculos, c.Visual, c.Desempenho, c.Economia
	local i = 1
	while true do
		local zona = ctx.Objetos:FindFirstChild("Box_" .. i)
		local console = ctx.Objetos:FindFirstChild("Console_" .. i)
		if not zona or not console then break end
		local box = { indice = i, zona = zona, console = console }
		zona.Transparency = 1
		zona.CanCollide = false
		zona.CanQuery = false
		zona.CanTouch = false
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Iniciar atendimento"
		pp.ObjectText = Config.Nome .. " • Box " .. i
		pp.HoldDuration = 0.5
		pp.MaxActivationDistance = 22
		pp.RequiresLineOfSight = false
		pp.Parent = console
		pp.Triggered:Connect(function(player) Sessoes.Iniciar(player, box) end)
		box.prompt = pp
		boxes[i] = box
		i += 1
	end
	if #boxes == 0 then warn("[Oficina] nenhum box encontrado (OficinaObjetos.Box_N + Console_N)") end

	ctx.Remotes.Sessao.OnServerEvent:Connect(function(player, acao)
		if acao == "sair" then Sessoes.Encerrar(player, "encerrado pelo cliente") end
	end)
	ctx.Remotes.Comprar.OnServerInvoke = function(player, carrinho)
		local ok, res = pcall(Sessoes.Comprar, player, carrinho)
		if ok then return res end
		warn("[Oficina] erro no remote Comprar: " .. tostring(res))
		return { ok = false, erro = "Erro interno." }
	end
	Players.PlayerRemoving:Connect(function(player) Sessoes.Encerrar(player, "jogador saiu") end)

	-- vigia: encerra se o motorista sair do carro, morrer, o carro sumir/sair do box ou o tempo acabar
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, s in pairs(table.clone(porJogador)) do
				local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				local motivo
				if not player.Parent then motivo = "jogador saiu"
				elseif not s.car.Parent or not s.seat.Parent then motivo = "veículo removido"
				elseif not hum or hum.Health <= 0 or s.seat.Occupant ~= hum then motivo = "motorista saiu do veículo"
				elseif os.clock() - s.inicio > Config.Sessao.TempoMaximo then motivo = "tempo esgotado"
				end
				if motivo and not s.ocupado then Sessoes.Encerrar(player, motivo) end
			end
		end
	end)
end

return Sessoes
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBXDBD670B1F6974DD28C290BBD0F15F034"><Properties><string name="Name">Client</string></Properties>
<Item class="LocalScript" referent="RBX76900382115C418F9A1CE80F83369B77"><Properties><bool name="Disabled">false</bool><string name="Name">OficinaCliente</string><ProtectedString name="Source"><![CDATA[-- OFICINA • Cliente: interface, câmera de personalização e pré-visualização.
-- A pré-visualização é 100% local (ninguém mais vê e nada é cobrado). Só o servidor aplica de verdade,
-- depois de validar e cobrar. Cancelar/sair sempre restaura o estado anterior do veículo.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local gui = script.Parent
local oficina = gui:WaitForChild("Raiz").Value
local modules = oficina:WaitForChild("Modules")
local Config = require(modules:WaitForChild("Config"))
local Visual = require(modules:WaitForChild("Visual"))
local Desempenho = require(modules:WaitForChild("Desempenho"))
Visual.UsarConfig(Config)
Desempenho.UsarConfig(Config)
local remotes = RS:WaitForChild("OficinaRemotes")
local rSessao = remotes:WaitForChild("Sessao")
local rComprar = remotes:WaitForChild("Comprar")

-- ===== melhorias mecânicas (A-Chassis): ajusta o Tune local a partir dos atributos definidos pelo servidor =====
local function ligarTune(car)
	local function aplicar() pcall(Desempenho.AplicarTuneCliente, car) end
	aplicar()
	for _, id in ipairs(Desempenho.Ids) do
		car:GetAttributeChangedSignal("OfN_" .. id):Connect(aplicar)
	end
end
CollectionService:GetInstanceAddedSignal(Desempenho.Tag):Connect(ligarTune)
for _, car in ipairs(CollectionService:GetTagged(Desempenho.Tag)) do ligarTune(car) end

-- ===== visual =====
local FUNDO = Color3.fromRGB(12, 14, 18)
local PAINEL = Color3.fromRGB(20, 23, 29)
local LINHA = Color3.fromRGB(44, 49, 60)
local DESTAQUE = Color3.fromRGB(255, 140, 30)
local TEXTO = Color3.fromRGB(235, 238, 244)
local FRACO = Color3.fromRGB(150, 158, 172)
local VERDE = Color3.fromRGB(90, 220, 130)
local VERMELHO = Color3.fromRGB(240, 80, 70)

local function novo(classe, props, pai)
	local o = Instance.new(classe)
	for k, v in pairs(props or {}) do o[k] = v end
	if pai then o.Parent = pai end
	return o
end
local function canto(o, r) novo("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function borda(o, cor) novo("UIStroke", { Color = cor or LINHA, Thickness = 1.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function texto(pai, t, tam, cor, fonte, props)
	local l = novo("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = tam, TextColor3 = cor or TEXTO, Font = fonte or Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, tam + 6), TextWrapped = true,
	}, pai)
	for k, v in pairs(props or {}) do l[k] = v end
	return l
end
local function botao(pai, t, cor, props)
	local b = novo("TextButton", {
		Text = t, TextSize = 15, Font = Enum.Font.GothamBold, TextColor3 = TEXTO, AutoButtonColor = true,
		BackgroundColor3 = cor or LINHA, Size = UDim2.new(1, 0, 0, 44), BorderSizePixel = 0,
	}, pai)
	canto(b, 8)
	for k, v in pairs(props or {}) do b[k] = v end
	return b
end
local function dinheiro(n)
	local s = tostring(math.floor((n or 0) + 0.5)):reverse():gsub("(%d%d%d)", "%1."):reverse()
	if s:sub(1, 1) == "." then s = s:sub(2) end
	return "R$ " .. s
end
local function som(id)
	if type(id) ~= "string" or id == "" then return end
	pcall(function()
		local s = novo("Sound", { SoundId = id, Volume = 0.5 })
		SoundService:PlayLocalSound(s)
		s:Destroy()
	end)
end

local raiz = novo("Frame", { Name = "Raiz", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, gui)

-- barra superior
local topo = novo("Frame", { BackgroundColor3 = FUNDO, BackgroundTransparency = 0.1, Size = UDim2.new(1, 0, 0, 58), BorderSizePixel = 0 }, raiz)
novo("Frame", { BackgroundColor3 = DESTAQUE, Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BorderSizePixel = 0 }, topo)
texto(topo, Config.Nome, 24, DESTAQUE, Enum.Font.GothamBlack, { Position = UDim2.new(0, 18, 0, 8), Size = UDim2.new(0.6, 0, 0, 26) })
texto(topo, Config.Slogan, 12, FRACO, Enum.Font.Gotham, { Position = UDim2.new(0, 18, 0, 34), Size = UDim2.new(0.6, 0, 0, 16) })
local saldoL = texto(topo, "", 20, VERDE, Enum.Font.GothamBold, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 16),
	Size = UDim2.new(0.35, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Right })

-- categorias (esquerda)
local esquerda = novo("Frame", { BackgroundColor3 = PAINEL, BackgroundTransparency = 0.06, Position = UDim2.new(0, 14, 0, 72), Size = UDim2.new(0, 230, 1, -86), BorderSizePixel = 0 }, raiz)
canto(esquerda, 10) borda(esquerda)
local listaCat = novo("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0, 6, 0, 6),
	ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, BorderSizePixel = 0 }, esquerda)
novo("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, listaCat)

-- carrinho (direita)
local direita = novo("Frame", { BackgroundColor3 = PAINEL, BackgroundTransparency = 0.06, AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 72), Size = UDim2.new(0, 250, 1, -86), BorderSizePixel = 0 }, raiz)
canto(direita, 10) borda(direita)
texto(direita, "PEDIDO", 13, DESTAQUE, Enum.Font.GothamBold, { Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(1, -24, 0, 18) })
local listaCarrinho = novo("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 30), Size = UDim2.new(1, -16, 1, -232),
	ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, BorderSizePixel = 0 }, direita)
novo("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, listaCarrinho)
local rodape = novo("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -10), Size = UDim2.new(1, -20, 0, 190) }, direita)
local totalL = texto(rodape, "Total: R$ 0", 18, TEXTO, Enum.Font.GothamBlack, { Size = UDim2.new(1, 0, 0, 26) })
local bComprar = botao(rodape, "APLICAR E PAGAR", DESTAQUE, { Position = UDim2.new(0, 0, 0, 34), TextColor3 = Color3.fromRGB(20, 14, 6) })
local bLimpar = botao(rodape, "CANCELAR ALTERAÇÕES", LINHA, { Position = UDim2.new(0, 0, 0, 84) })
local bSair = botao(rodape, "SAIR DA OFICINA", Color3.fromRGB(90, 34, 34), { Position = UDim2.new(0, 0, 0, 134) })

-- opções (embaixo, no centro)
local centro = novo("Frame", { BackgroundColor3 = PAINEL, BackgroundTransparency = 0.06, AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(1, -540, 0, 214), BorderSizePixel = 0 }, raiz)
canto(centro, 10) borda(centro)
local tituloCat = texto(centro, "", 17, TEXTO, Enum.Font.GothamBlack, { Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -150, 0, 22) })
local descCat = texto(centro, "", 12, FRACO, Enum.Font.Gotham, { Position = UDim2.new(0, 14, 0, 30), Size = UDim2.new(1, -150, 0, 16) })
local bVoltar = botao(centro, "VOLTAR", LINHA, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.new(0, 110, 0, 36), TextSize = 13 })
local areaOp = novo("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 52), Size = UDim2.new(1, -20, 1, -60),
	ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, BorderSizePixel = 0 }, centro)

-- girar câmera
local bEsq = botao(raiz, "◀", FUNDO, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 258, 0.42, 0), Size = UDim2.new(0, 48, 0, 48), TextSize = 20 })
local bDir = botao(raiz, "▶", FUNDO, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -278, 0.42, 0), Size = UDim2.new(0, 48, 0, 48), TextSize = 20 })

-- aviso (toast) e confirmação
local toast = texto(gui, "", 15, TEXTO, Enum.Font.GothamBold, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70),
	Size = UDim2.new(0, 460, 0, 40), BackgroundTransparency = 0.1, BackgroundColor3 = FUNDO, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 30 })
canto(toast, 8) borda(toast, DESTAQUE)
local toastN = 0
local function avisar(t, cor)
	toastN += 1
	local meu = toastN
	toast.Text = t
	toast.TextColor3 = cor or TEXTO
	toast.Visible = true
	task.delay(3.5, function() if meu == toastN then toast.Visible = false end end)
end

local modal = novo("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 40, Active = true }, raiz)
local caixa = novo("Frame", { BackgroundColor3 = PAINEL, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 380, 0, 200), ZIndex = 41 }, modal)
canto(caixa, 12) borda(caixa, DESTAQUE)
local modalT = texto(caixa, "", 16, TEXTO, Enum.Font.GothamBold, { Position = UDim2.new(0, 20, 0, 18), Size = UDim2.new(1, -40, 0, 96), ZIndex = 42, TextYAlignment = Enum.TextYAlignment.Top })
local bSim = botao(caixa, "CONFIRMAR", DESTAQUE, { Position = UDim2.new(0, 20, 1, -64), Size = UDim2.new(0.5, -26, 0, 46), ZIndex = 42, TextColor3 = Color3.fromRGB(20, 14, 6) })
local bNao = botao(caixa, "VOLTAR", LINHA, { Position = UDim2.new(0.5, 6, 1, -64), Size = UDim2.new(0.5, -26, 0, 46), ZIndex = 42 })

-- escala responsiva: celular e tablet usam a mesma interface, proporcional à tela
local escalas = {}
for _, f in ipairs({ topo, esquerda, direita, centro, bEsq, bDir, caixa, toast }) do
	escalas[f] = novo("UIScale", {}, f)
end
local function layout()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 1 then return end
	local k = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.5, 1)
	for f, s in pairs(escalas) do s.Scale = k end
	esquerda.Position = UDim2.new(0, 14 * k, 0, 72 * k)
	esquerda.Size = UDim2.new(0, 230, 1 / k, -86)
	direita.Position = UDim2.new(1, -14 * k, 0, 72 * k)
	direita.Size = UDim2.new(0, 250, 1 / k, -86)
	centro.Position = UDim2.new(0.5, 0, 1, -14 * k)
	centro.Size = UDim2.new(1 / k, -540, 0, 214)
	topo.Size = UDim2.new(1 / k, 0, 0, 58)
	bEsq.Position = UDim2.new(0, 258 * k, 0.42, 0)
	bDir.Position = UDim2.new(1, -278 * k, 0.42, 0)
end

-- ===== estado da sessão =====
local sessao            -- { car, suporte, estado, niveis, diagnostico }
local carrinho = {}     -- [idCategoria] = valor
local catAtual
local fotos             -- [part] = { Color, Transparency } (estado do servidor antes da pré-visualização)
local angulo, anguloAlvo, camCfg = 35, 35, Config.Cameras.frente
local camAntes

local VISUAIS = { pintura = true, pintura2 = true, rodas = true, vidros = true, neon = true, aerofolio = true, escape = true }

local function fotografar()
	fotos = {}
	for _, d in ipairs(sessao.car:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("OfGrupo") then
			fotos[d] = { d.Color, d.Transparency }
		end
	end
end

local function esconderReal(nome, esconder)
	local f = sessao.car:FindFirstChild(nome)
	if not f then return end
	for _, d in ipairs(f:GetDescendants()) do
		if d:IsA("BasePart") then d.LocalTransparencyModifier = esconder and 1 or 0
		elseif d:IsA("Light") then d.Enabled = not esconder end
	end
end

-- volta o carro exatamente ao estado do servidor
local function restaurar()
	if not sessao or not sessao.car.Parent then return end
	for p, f in pairs(fotos or {}) do
		if p.Parent then
			p.Color = f[1]
			p.Transparency = f[2]
		end
	end
	for _, nome in pairs(Visual.Pastas) do
		local prev = sessao.car:FindFirstChild(nome .. "_Previa")
		if prev then prev:Destroy() end
		esconderReal(nome, false)
	end
end

local function previsualizar()
	restaurar()
	for id, valor in pairs(carrinho) do
		if VISUAIS[id] then
			local pasta = Visual.Pastas[id]
			if pasta then esconderReal(pasta, true) end
			pcall(Visual.AplicarCategoria, sessao.car, id, valor ~= false and valor or nil, true)
		end
	end
end

local function precoDe(cat, valor)
	if cat.tipo == "cor" then
		if valor == false then return 0 end
		return Config.NaPaleta(valor) and cat.preco or cat.precoPersonalizada
	elseif cat.tipo == "opcao" then
		local op = Config.Opcao(cat, valor)
		return op and op.preco or 0
	elseif cat.tipo == "nivel" then
		local t = 0
		for n = (sessao.niveis[cat.id] or 0) + 1, valor do t += cat.niveis[n].preco end
		return t
	end
	return cat.preco or 0
end

local function total()
	local t = 0
	for id, valor in pairs(carrinho) do
		local cat = Config.Categoria(id)
		if cat then t += precoDe(cat, valor) end
	end
	return t
end

local function rotulo(cat, valor)
	if cat.tipo == "cor" then
		if valor == false then return "remover" end
		for _, p in ipairs(Config.Paleta) do
			if Config.NaPaleta(valor) and math.abs(p.cor.R - valor.R) < 0.012 and math.abs(p.cor.G - valor.G) < 0.012 and math.abs(p.cor.B - valor.B) < 0.012 then return p.nome end
		end
		return "cor personalizada"
	elseif cat.tipo == "opcao" then
		local op = Config.Opcao(cat, valor)
		return op and op.nome or tostring(valor)
	elseif cat.tipo == "nivel" then
		return "nível " .. valor
	end
	return "serviço"
end

local mostrarCategoria

local function atualizarCarrinho()
	for _, c in ipairs(listaCarrinho:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	local n = 0
	for _, cat in ipairs(Config.Categorias) do
		local valor = carrinho[cat.id]
		if valor ~= nil then
			n += 1
			local b = botao(listaCarrinho, "", FUNDO, { Size = UDim2.new(1, -4, 0, 46), LayoutOrder = n })
			texto(b, cat.nome, 13, TEXTO, Enum.Font.GothamBold, { Position = UDim2.new(0, 8, 0, 4), Size = UDim2.new(1, -40, 0, 16) })
			texto(b, rotulo(cat, valor) .. " • " .. dinheiro(precoDe(cat, valor)), 12, FRACO, Enum.Font.Gotham, { Position = UDim2.new(0, 8, 0, 22), Size = UDim2.new(1, -40, 0, 16) })
			texto(b, "✕", 16, VERMELHO, Enum.Font.GothamBold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 20, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
			b.MouseButton1Click:Connect(function()
				carrinho[cat.id] = nil
				previsualizar()
				atualizarCarrinho()
				if catAtual then mostrarCategoria(catAtual) end
			end)
		end
	end
	if n == 0 then
		texto(listaCarrinho, "Escolha uma categoria e experimente. Nada é cobrado até você confirmar.", 12, FRACO, Enum.Font.Gotham, { Size = UDim2.new(1, -4, 0, 60) })
	end
	totalL.Text = "Total: " .. dinheiro(total())
	bComprar.BackgroundColor3 = n > 0 and DESTAQUE or LINHA
end

local function escolher(cat, valor)
	carrinho[cat.id] = valor
	som(Config.Sons.Previa)
	previsualizar()
	atualizarCarrinho()
	mostrarCategoria(cat)
end

local function limparOpcoes()
	for _, c in ipairs(areaOp:GetChildren()) do c:Destroy() end
end

-- seletor de cor livre (matiz, saturação, brilho)
local arrastando
UserInputService.InputChanged:Connect(function(input)
	if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		arrastando(input.Position.X)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then arrastando = nil end
end)

local function seletorCor(pai, cat, y)
	local h, s, v = 0.05, 0.9, 0.95
	local quadro = novo("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(1, -8, 0, 132) }, pai)
	texto(quadro, "Cor personalizada • " .. dinheiro(cat.precoPersonalizada), 12, FRACO, Enum.Font.GothamBold, { Size = UDim2.new(1, 0, 0, 16) })
	local amostra = novo("Frame", { BackgroundColor3 = Color3.fromHSV(h, s, v), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 22), Size = UDim2.new(0, 96, 0, 54), BorderSizePixel = 0 }, quadro)
	canto(amostra, 8)
	local usar = botao(quadro, "USAR COR", DESTAQUE, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 82), Size = UDim2.new(0, 96, 0, 44), TextSize = 13, TextColor3 = Color3.fromRGB(20, 14, 6) })
	local function barra(i, nome, ini, aoMudar)
		local linha = novo("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = FUNDO, Position = UDim2.new(0, 0, 0, 22 + (i - 1) * 36), Size = UDim2.new(1, -110, 0, 30), BorderSizePixel = 0 }, quadro)
		canto(linha, 6)
		local fill = novo("Frame", { BackgroundColor3 = DESTAQUE, Size = UDim2.fromScale(ini, 1), BorderSizePixel = 0 }, linha)
		canto(fill, 6)
		texto(linha, nome, 12, TEXTO, Enum.Font.GothamBold, { Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -8, 1, 0), ZIndex = 2 })
		local function mover(x)
			local k = math.clamp((x - linha.AbsolutePosition.X) / math.max(linha.AbsoluteSize.X, 1), 0, 1)
			fill.Size = UDim2.fromScale(k, 1)
			aoMudar(k)
			amostra.BackgroundColor3 = Color3.fromHSV(h, s, v)
		end
		linha.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				arrastando = mover
				mover(input.Position.X)
			end
		end)
	end
	barra(1, "Matiz", h, function(k) h = k end)
	barra(2, "Saturação", s, function(k) s = k end)
	barra(3, "Brilho", v, function(k) v = k end)
	usar.MouseButton1Click:Connect(function() escolher(cat, Color3.fromHSV(h, s, v)) end)
	return 132
end

function mostrarCategoria(cat)
	catAtual = cat
	limparOpcoes()
	tituloCat.Text = string.upper(cat.nome)
	descCat.Text = cat.descricao or ""
	camCfg = Config.Cameras[cat.camera or "frente"] or Config.Cameras.frente
	anguloAlvo = camCfg.angulo
	if not sessao.suporte[cat.id] then
		descCat.Text = "Indisponível para este veículo."
		texto(areaOp, cat.tipo == "servico" and "Este veículo não informa danos à oficina (integração com o sistema de dano pendente)."
			or "O modelo deste veículo não tem as peças necessárias para esta personalização.", 13, FRACO, Enum.Font.Gotham, { Size = UDim2.new(1, -8, 0, 40) })
		return
	end
	local escolhido = carrinho[cat.id]
	if cat.tipo == "cor" then
		local grade = novo("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, areaOp)
		novo("UIGridLayout", { CellSize = UDim2.new(0, 54, 0, 46), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, grade)
		for i, p in ipairs(Config.Paleta) do
			local b = novo("TextButton", { Text = "", BackgroundColor3 = p.cor, LayoutOrder = i, BorderSizePixel = 0 }, grade)
			canto(b, 8)
			if typeof(escolhido) == "Color3" and math.abs(escolhido.R - p.cor.R) < 0.012 and math.abs(escolhido.G - p.cor.G) < 0.012 and math.abs(escolhido.B - p.cor.B) < 0.012 then
				novo("UIStroke", { Color = DESTAQUE, Thickness = 3 }, b)
			end
			b.MouseButton1Click:Connect(function() escolher(cat, p.cor) end)
		end
		if cat.remover and sessao.estado[cat.id] then
			local b = botao(grade, "REMOVER", Color3.fromRGB(90, 34, 34), { LayoutOrder = 99, TextSize = 10 })
			b.MouseButton1Click:Connect(function() escolher(cat, false) end)
		end
		local linhas = math.ceil((#Config.Paleta + 1) / math.max(1, math.floor((areaOp.AbsoluteSize.X / math.max(escalas[centro].Scale, 0.01)) / 60)))
		descCat.Text = "Paleta • " .. dinheiro(cat.preco) .. "   (toque numa cor para ver no carro)"
		seletorCor(areaOp, cat, linhas * 52 + 8)
	elseif cat.tipo == "opcao" then
		novo("UIGridLayout", { CellSize = UDim2.new(0, 178, 0, 62), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, areaOp)
		for i, op in ipairs(cat.opcoes) do
			local instalado = sessao.estado[cat.id] == op.id
			local b = botao(areaOp, "", escolhido == op.id and Color3.fromRGB(70, 48, 20) or FUNDO, { LayoutOrder = i })
			if escolhido == op.id then borda(b, DESTAQUE) end
			texto(b, op.nome, 14, TEXTO, Enum.Font.GothamBold, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(1, -16, 0, 18) })
			texto(b, instalado and "INSTALADO" or dinheiro(op.preco), 12, instalado and VERDE or FRACO, Enum.Font.GothamBold, { Position = UDim2.new(0, 10, 0, 32), Size = UDim2.new(1, -16, 0, 16) })
			b.MouseButton1Click:Connect(function()
				if instalado then
					carrinho[cat.id] = nil
					previsualizar() atualizarCarrinho() mostrarCategoria(cat)
				else
					escolher(cat, op.id)
				end
			end)
		end
	elseif cat.tipo == "nivel" then
		novo("UIGridLayout", { CellSize = UDim2.new(0, 178, 0, 62), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, areaOp)
		local atual = sessao.niveis[cat.id] or 0
		descCat.Text = (cat.descricao or "") .. " • nível atual: " .. atual .. "/" .. #cat.niveis
		local acumulado = 0
		for n, d in ipairs(cat.niveis) do
			local tem = n <= atual
			if not tem then acumulado += d.preco end
			local b = botao(areaOp, "", escolhido == n and Color3.fromRGB(70, 48, 20) or FUNDO, { LayoutOrder = n, AutoButtonColor = not tem })
			if escolhido == n then borda(b, DESTAQUE) end
			local ganho = d.boost and ("+" .. d.boost .. " psi") or ("+" .. math.floor((d.mult - 1) * 100 + 0.5) .. "%")
			texto(b, "Nível " .. n .. "  " .. ganho, 14, tem and FRACO or TEXTO, Enum.Font.GothamBold, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(1, -16, 0, 18) })
			texto(b, tem and "INSTALADO" or dinheiro(acumulado), 12, tem and VERDE or FRACO, Enum.Font.GothamBold, { Position = UDim2.new(0, 10, 0, 32), Size = UDim2.new(1, -16, 0, 16) })
			if not tem then b.MouseButton1Click:Connect(function() escolher(cat, n) end) end
		end
	elseif cat.tipo == "servico" then
		local d = sessao.diagnostico
		local linha = d.vida and string.format("Diagnóstico: integridade %d / %d", math.floor(d.vida), math.floor(d.max)) or "Diagnóstico: veículo com avarias"
		if not d.danificado then linha = "Diagnóstico: veículo em perfeito estado. Nenhum reparo necessário." end
		texto(areaOp, linha, 14, d.danificado and DESTAQUE or VERDE, Enum.Font.GothamBold, { Size = UDim2.new(1, -8, 0, 24) })
		if d.danificado then
			local b = botao(areaOp, (escolhido and "✓ " or "") .. "REPARO COMPLETO • " .. dinheiro(cat.preco), escolhido and Color3.fromRGB(70, 48, 20) or FUNDO,
				{ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(0, 300, 0, 48) })
			b.MouseButton1Click:Connect(function()
				if escolhido then carrinho[cat.id] = nil previsualizar() atualizarCarrinho() mostrarCategoria(cat) else escolher(cat, true) end
			end)
		end
	end
end

local function montarCategorias()
	for _, c in ipairs(listaCat:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	local grupo, ordem = nil, 0
	for _, cat in ipairs(Config.Categorias) do
		if cat.grupo ~= grupo then
			grupo = cat.grupo
			ordem += 1
			texto(listaCat, string.upper(grupo), 11, DESTAQUE, Enum.Font.GothamBold, { LayoutOrder = ordem, Size = UDim2.new(1, -6, 0, 20) })
		end
		ordem += 1
		local ok = sessao.suporte[cat.id]
		local b = botao(listaCat, "   " .. cat.nome, FUNDO, { LayoutOrder = ordem, Size = UDim2.new(1, -6, 0, 44), TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = ok and TEXTO or Color3.fromRGB(95, 100, 112), TextSize = 14 })
		b.MouseButton1Click:Connect(function()
			som(Config.Sons.Navegar)
			mostrarCategoria(cat)
		end)
	end
end

-- ===== câmera =====
local function atualizarSaldo()
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(Config.Economia.Stat)
	saldoL.Text = v and dinheiro(v.Value) or "Saldo indisponível"
end

local function camera(dt)
	if not sessao or not sessao.car.Parent then return end
	local cam = workspace.CurrentCamera
	local cf, size = sessao.car:GetBoundingBox()
	local raio = math.max(size.X, size.Z)
	local dif = (anguloAlvo - angulo + 540) % 360 - 180
	angulo += dif * math.clamp(dt * 5, 0, 1)
	local a = math.rad(angulo)
	local frente = cf.LookVector * Vector3.new(1, 0, 1)
	if frente.Magnitude < 0.1 then frente = Vector3.new(0, 0, -1) end
	local base = CFrame.lookAt(Vector3.zero, frente.Unit)
	local dir = (base * CFrame.Angles(0, -a, 0)).LookVector
	local alvo = cf.Position + Vector3.new(0, size.Y * 0.05, 0)
	local pos = alvo + dir * raio * camCfg.dist + Vector3.new(0, size.Y * (0.3 + camCfg.altura * 2), 0)
	cam.CFrame = CFrame.lookAt(pos, alvo)
end

local function abrir(dados)
	sessao = dados
	carrinho = {}
	catAtual = nil
	fotografar()
	local cam = workspace.CurrentCamera
	camAntes = { cam.CameraType, cam.CameraSubject, cam.FieldOfView }
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 55
	angulo, anguloAlvo, camCfg = 35, 35, Config.Cameras.frente
	RunService:BindToRenderStep("OficinaCamera", Enum.RenderPriority.Camera.Value + 2, camera)
	layout()
	montarCategorias()
	atualizarCarrinho()
	atualizarSaldo()
	mostrarCategoria(Config.Categorias[1])
	raiz.Visible = true
	modal.Visible = false
	som(Config.Sons.Abrir)
end

local function fechar()
	if not sessao then return end
	pcall(restaurar)
	RunService:UnbindFromRenderStep("OficinaCamera")
	local cam = workspace.CurrentCamera
	if camAntes then
		cam.CameraType = camAntes[1]
		cam.FieldOfView = camAntes[3]
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		cam.CameraSubject = hum or camAntes[2]
	end
	sessao = nil
	carrinho = {}
	raiz.Visible = false
	som(Config.Sons.Fechar)
end

-- ===== ações =====
bEsq.MouseButton1Click:Connect(function() anguloAlvo = (anguloAlvo - 35) % 360 end)
bDir.MouseButton1Click:Connect(function() anguloAlvo = (anguloAlvo + 35) % 360 end)
bVoltar.MouseButton1Click:Connect(function()
	-- volta = desfaz a escolha da categoria aberta
	if catAtual and carrinho[catAtual.id] ~= nil then
		carrinho[catAtual.id] = nil
		previsualizar() atualizarCarrinho() mostrarCategoria(catAtual)
	end
end)
bLimpar.MouseButton1Click:Connect(function()
	carrinho = {}
	previsualizar() atualizarCarrinho()
	if catAtual then mostrarCategoria(catAtual) end
	avisar("Alterações canceladas. O veículo voltou ao estado anterior.")
end)
bSair.MouseButton1Click:Connect(function() rSessao:FireServer("sair") end)
bNao.MouseButton1Click:Connect(function() modal.Visible = false end)
bComprar.MouseButton1Click:Connect(function()
	if next(carrinho) == nil then avisar("Seu pedido está vazio.", FRACO) return end
	modalT.Text = "Confirmar a compra?\n\nTotal: " .. dinheiro(total()) .. "\nAs alterações serão aplicadas ao veículo."
	modal.Visible = true
end)

local comprando = false
bSim.MouseButton1Click:Connect(function()
	if comprando or not sessao then return end
	comprando = true
	modal.Visible = false
	local pedido = table.clone(carrinho)
	-- tira a pré-visualização ANTES de pedir: o que aparecer depois é o estado real vindo do servidor
	restaurar()
	local ok, res = pcall(function() return rComprar:InvokeServer(pedido) end)
	comprando = false
	if not sessao then return end
	if ok and type(res) == "table" and res.ok then
		carrinho = {}
		sessao.suporte, sessao.estado, sessao.niveis, sessao.diagnostico = res.suporte, res.estado, res.niveis, res.diagnostico
		som(Config.Sons.Compra)
		avisar("Compra concluída: " .. dinheiro(res.total) .. ". Alterações aplicadas!", VERDE)
		task.wait(0.35)
		if sessao then
			fotografar()
			atualizarCarrinho()
			atualizarSaldo()
			if catAtual then mostrarCategoria(catAtual) end
		end
	else
		som(Config.Sons.Erro)
		avisar((ok and type(res) == "table" and res.erro) or "Não foi possível concluir a compra.", VERMELHO)
		previsualizar()
	end
end)

rSessao.OnClientEvent:Connect(function(acao, dados)
	if acao == "iniciar" and type(dados) == "table" and dados.car then
		if sessao then fechar() end
		abrir(dados)
	elseif acao == "encerrar" then
		fechar()
	elseif acao == "aviso" and type(dados) == "table" then
		avisar(tostring(dados.texto), dados.tipo == "erro" and VERMELHO or TEXTO)
	end
end)

local vpConn
local function vigiarCamera()
	if vpConn then vpConn:Disconnect() end
	local cam = workspace.CurrentCamera
	if cam then vpConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
	layout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(vigiarCamera)
vigiarCamera()
task.spawn(function()
	while true do
		task.wait(1)
		if sessao then atualizarSaldo() end
	end
end)
]]></ProtectedString></Properties></Item>
</Item>
