}

-- Nível mínimo (índice de patente) exigido por cada acesso
Config.Access = {
	Armory = 1,        -- entrar na armaria / retirar equipamento
	Cells = 2,         -- trancar/destrancar celas
	Evidence = 2,      -- sala de evidências
	Lab = 2,           -- laboratório de perícia
	CCTV = 2,          -- sala de monitoramento
	Fleet = 1,         -- solicitar viatura
