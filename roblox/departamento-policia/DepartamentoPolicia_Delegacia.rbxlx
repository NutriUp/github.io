					<Item class="Script" referent="RBX45A4FDCE89C7426D9ABFE3F6C3F3F796">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local TAG = "Recruta"
local ativos = {}

local function jogadorMaisPerto(pos, maxDist)
	local melhor, melhorDist = nil, maxDist
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if h and r and h.Health > 0 then
			local d = (r.Position - pos).Magnitude
			if d < melhorDist then
				melhor, melhorDist = c, d
			end
		end
	end
	return melhor, melhorDist
end

local function iniciar(model)
	if ativos[model] then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then
		warn("[Recrutas] " .. model:GetFullName() .. " sem Humanoid/HumanoidRootPart. Rode o script do Command Bar.")
		return
	end
	ativos[model] = true
	pcall(function() hrp:SetNetworkOwner(nil) end)

	local casa = hrp.Position
	local rng = Random.new()
	local estado = ""
	local function mudar(e)
		if estado ~= e then
			estado = e
			model:SetAttribute("Estado", e)
		end
	end
	local function parar() hum:MoveTo(hrp.Position) end
	local function olharPara(pos)
		hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
	end
	mudar("Parado")

	local vidaAnterior = hum.Health
	local alertaAte = 0
	hum.HealthChanged:Connect(function(v)
		if v < vidaAnterior and v > 0 then
			model:SetAttribute("DanoN", (model:GetAttribute("DanoN") or 0) + 1)
			alertaAte = os.clock() + 4
		end
		vidaAnterior = v
	end)
	hum.Died:Connect(function()
		mudar("Morto")
		task.delay(10, function()
			if model.Parent then model:Destroy() end
		end)
	end)

	task.spawn(function()
		local destino, timeoutDestino = nil, 0
		local proxMov, sentadoAte, saudandoAte, ultimoAtaque = 0, 0, 0, -10
		local saudou = {}

		while model.Parent and hum.Health > 0 do
			local agora = os.clock()
			local modo = model:GetAttribute("Modo") or "Patrulha"
			local raio = model:GetAttribute("Raio") or 18
			local agressivo = model:GetAttribute("Agressivo") == true
			local alvo, dist = jogadorMaisPerto(hrp.Position, agressivo and 40 or 16)
			local alvoHRP = alvo and alvo:FindFirstChild("HumanoidRootPart")

			if agressivo and alvoHRP then
				-- persegue e bate com o cacetete
				local atacando = (agora - ultimoAtaque) < 0.55
				if atacando then
					parar()
				elseif dist > 4.5 then
					hum.WalkSpeed = 15
					hum:MoveTo(alvoHRP.Position)
					mudar("Andando")
				else
					parar()
					olharPara(alvoHRP.Position)
					ultimoAtaque = agora
					mudar("Atacando")
					task.delay(0.25, function()
						local ah = alvo:FindFirstChildOfClass("Humanoid")
						if ah and ah.Health > 0 and hum.Health > 0 and alvoHRP.Parent
							and (alvoHRP.Position - hrp.Position).Magnitude < 7 then
							ah:TakeDamage(model:GetAttribute("Dano") or 10)
						end
					end)
				end
				if not atacando and estado == "Atacando" and (agora - ultimoAtaque) >= 0.55 then
					mudar("Parado")
				end

			elseif agora < alertaAte then
				parar()
				if alvoHRP then olharPara(alvoHRP.Position) end
				mudar("Alerta")

			elseif agora < saudandoAte then
				parar()
				mudar(model:GetAttribute("Saudacao") == "Acenar" and "Acenando" or "Saudando")

			elseif modo == "Sentado" then
				parar()
				mudar("Sentado")

			else
				-- cumprimenta quem chega perto (a cada 40s por jogador)
				if alvo and dist < 14 and (saudou[alvo] or 0) < agora then
					saudou[alvo] = agora + 40
					saudandoAte = agora + 3
					parar()
					olharPara(alvoHRP.Position)
					mudar(model:GetAttribute("Saudacao") == "Acenar" and "Acenando" or "Saudando")

				elseif modo == "Patrulha" then
					if agora < sentadoAte then
						parar()
						mudar("Sentado")
					elseif destino then
						local dx = destino.X - hrp.Position.X
						local dz = destino.Z - hrp.Position.Z
						if math.sqrt(dx * dx + dz * dz) < 3 or agora > timeoutDestino then
							destino = nil
							proxMov = agora + rng:NextNumber(3, 8)
							parar()
							mudar("Parado")
						else
							hum.WalkSpeed = 8
							hum:MoveTo(destino)
							mudar("Andando")
						end
					elseif agora >= proxMov then
						if model:GetAttribute("Descansar") ~= false and rng:NextNumber() < 0.2 then
							sentadoAte = agora + rng:NextNumber(8, 15)
							proxMov = sentadoAte + 2
						else
							local ang = rng:NextNumber(0, math.pi * 2)
							local r = rng:NextNumber(4, raio)
							destino = casa + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
							destino = Vector3.new(destino.X, hrp.Position.Y, destino.Z)
							timeoutDestino = agora + 10
						end
					else
						parar()
						mudar("Parado")
					end

				else -- "Guarda": fica no posto
					parar()
					mudar("Parado")
				end
			end

			task.wait(0.2)
		end
		ativos[model] = nil
	end)
end

-- valores padrão (se faltarem os atributos)
local padrao = { Modo = "Patrulha", Raio = 18, Agressivo = false, Dano = 10, Saudacao = "Continencia", Descansar = true }
for nome, valor in pairs(padrao) do
	if script.Parent:GetAttribute(nome) == nil then script.Parent:SetAttribute(nome, valor) end
end
iniciar(script.Parent)
]]></ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<token name="RunContext">0</token>
							<string name="ScriptGuid">{BE8DBDDD-C454-42F2-8370-A247F5AB3C93}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">RecrutaIA</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX4996F3CAFAFB4EDBA4523032C40D21AA">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local TAG = "Recruta"
local jogador = Players.LocalPlayer
local rigs, vistos = {}, {}

local function junta(j)
	return { j = j, p = j.C0.Position, c0 = j.C0, inv = j.C0:Inverse() }
end

-- gira o membro em torno da junta, usando o espaço do Torso (X direita, Y cima, -Z frente)
local function aplicar(r, R, v)
	r.j.Transform = r.inv * CFrame.new(v or Vector3.zero) * CFrame.new(r.p) * R * CFrame.new(-r.p) * r.c0
end

local function preparar(model)
	if vistos[model] then return end
	vistos[model] = true
	task.spawn(function()
		local hum = model:WaitForChild("Humanoid", 15)
		local torso = model:WaitForChild("Torso", 15)
		local hrp = model:WaitForChild("HumanoidRootPart", 15)
		if not (hum and torso and hrp) then return end
		local function pegar(pai, nome)
			local m = pai:WaitForChild(nome, 15)
			return m and junta(m)
		end
		local r = {
			model = model, hum = hum, torso = torso, hrp = hrp,
			root = pegar(hrp, "RootJoint"), neck = pegar(torso, "Neck"),
			rs = pegar(torso, "Right Shoulder"), ls = pegar(torso, "Left Shoulder"),
			rh = pegar(torso, "Right Hip"), lh = pegar(torso, "Left Hip"),
			estado = model:GetAttribute("Estado") or "Parado",
			t0 = os.clock(), flinch = -10, fase = math.random() * 20, andar = 0,
			baton = model:FindFirstChild("Cacetete") ~= nil, v = {},
		}
		if not (r.root and r.neck and r.rs and r.ls and r.rh and r.lh) then return end
		model:GetAttributeChangedSignal("Estado"):Connect(function()
			r.estado = model:GetAttribute("Estado") or "Parado"
			r.t0 = os.clock()
		end)
		model:GetAttributeChangedSignal("DanoN"):Connect(function()
			r.flinch = os.clock()
		end)
		rigs[model] = r
	end)
end

preparar(script.Parent)

RunService.RenderStepped:Connect(function(dt)
	local agora = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	local meuChar = jogador.Character
	local meuHead = meuChar and meuChar:FindFirstChild("Head")
	local meuHum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
	local vivo = meuHum and meuHum.Health > 0

	for model, r in pairs(rigs) do
		if not model.Parent then
			rigs[model] = nil
			vistos[model] = nil
			continue
		end
		if r.hum.Health <= 0 then continue end
		if camPos and (r.hrp.Position - camPos).Magnitude > 160 then continue end

		local est = r.estado
		local tempo = agora - r.t0
		local fase = agora + r.fase
		local vel = (r.hrp.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude

		-- locomoção + respiração
		r.andar += dt * vel * 1.1
		local w = r.andar
		local amp = math.clamp(vel / 8, 0, 1)
		local resp = math.sin(fase * 1.6) * 0.02 * (1 - amp)
		local bf = r.baton and 0.3 or 1
		local t = {
			rl = math.sin(w) * 0.75 * amp,
			ll = -math.sin(w) * 0.75 * amp,
			rf = -math.sin(w) * 0.55 * amp * bf + (r.baton and 0.25 or 0),
			lf = math.sin(w) * 0.55 * amp,
			ro = 0.08 + resp, lo = 0.08 + resp,
			sit = 0, ny = 0, np = 0,
		}
		local k = 14

		if est == "Sentado" then
			t.sit = 1
			t.rl, t.ll = 1.45, 1.45
			t.rf, t.lf = 0.9, 0.9
			t.ro, t.lo = 0.12, 0.12
		elseif est == "Saudando" then
			t.rf, t.ro = 2.2, 0.45
		elseif est == "Acenando" then
			t.rf = 0.2
			t.ro = 2.6 + math.sin(fase * 9) * 0.25
		elseif est == "Atacando" then
			k = 40
			local u = tempo / 0.5
			if u < 0.3 then
				t.rf = 2.4 * (u / 0.3)
			else
				t.rf = 2.4 + (0.15 - 2.4) * math.min((u - 0.3) / 0.3, 1)
			end
			t.ro, t.lo = 0.2, 0.3
		elseif est == "Alerta" then
			local tremor = math.sin(fase * 30) * 0.03
			t.rf, t.lf = 1.3 + tremor, 1.3 - tremor
			t.ro, t.lo = 0.35, 0.35
		end

		-- olhar: segue o jogador local de perto, senão olha em volta
		local ny = math.sin(fase * 0.35) * 0.35
		local np = math.sin(fase * 0.5) * 0.05
		if meuHead and vivo then
			local d = r.torso.CFrame:PointToObjectSpace(meuHead.Position)
			if d.Magnitude < 22 then
				local yaw = math.atan2(-d.X, -d.Z)
				if math.abs(yaw) < 2.0 then
					local h = math.sqrt(d.X * d.X + d.Z * d.Z)
					ny = math.clamp(yaw, -1.1, 1.1)
					np = math.clamp(math.atan2(d.Y - 1.0, h), -0.5, 0.5)
				end
			end
		end
		t.ny, t.np = ny, np

		-- reação ao levar dano (sobressalto)
		if agora - r.flinch < 0.35 then
			k = 40
			t.np = 0.5
			t.rf, t.lf = 0.6, 0.6
			t.ro, t.lo = 0.9, 0.9
		end

		-- suavização
		local a = 1 - math.exp(-k * dt)
		local v = r.v
		for nome, alvo in pairs(t) do
			v[nome] = (v[nome] or alvo) + (alvo - (v[nome] or alvo)) * a
		end

		aplicar(r.root, CFrame.identity, Vector3.new(0, -1.5 * v.sit, 0))
		aplicar(r.neck, CFrame.Angles(0, v.ny, 0) * CFrame.Angles(v.np, 0, 0))
		aplicar(r.rs, CFrame.Angles(0, 0, v.ro) * CFrame.Angles(v.rf, 0, 0))
		aplicar(r.ls, CFrame.Angles(0, 0, -v.lo) * CFrame.Angles(v.lf, 0, 0))
		aplicar(r.rh, CFrame.Angles(v.rl, 0, 0))
		aplicar(r.lh, CFrame.Angles(v.ll, 0, 0))
	end
end)
]]></ProtectedString>
