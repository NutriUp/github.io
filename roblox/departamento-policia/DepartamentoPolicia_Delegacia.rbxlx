mgTitle.ZIndex = 41
local mgClue = label(mg, "", 13, YELLOW, Enum.Font.GothamBold, UDim2.new(0, 16, 0, 34), UDim2.new(1, -32, 0, 34))
mgClue.TextWrapped = true
mgClue.TextYAlignment = Enum.TextYAlignment.Top
mgClue.ZIndex = 41
