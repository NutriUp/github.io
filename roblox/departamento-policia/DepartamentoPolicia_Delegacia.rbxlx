ent="RBX46FEC5A26D8D4E37AF98276FDF543451"><Properties><string name="Name">PosteCamera</string><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-600</X><Y>9.15</Y><Z>-30</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><bool name="CastShadow">true</bool><Color3uint8 name="Color3uint8">4280427562</Color3uint8><bool name="Locked">false</bool><token name="Material">1088</token><float name="Reflectance">0</float><Vector3 name="size"><X>0.7</X><Y>16.7</Y><Z>0.7</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX213FD029632545F7AF9AB1C53E7B1900"><Properties><string name="Name">LenteCamera</string><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-520.8002</X><Y>17.08561</Y><Z>-190.71446</Z><R00>0.66602</R00><R01>-0.26879</R01><R02>0.69583</R02><R10>0</R10><R11>0.93282</R11><R12>0.36034</R12><R20>-0.74594</R20><R21>-0.23999</R21><R22>0.62127</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4294917170</Color3uint8><bool name="Locked">false</bool><token name="Material">288</token><float name="Reflectance">0</float><Vector3 name="size"><X>0.6</X><Y>0.6</Y><Z>0.2</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX1932F09A89F24A64B5143A23710A1A5D"><Properties><string name="Name">PosteCamera</string><token name="shape">1</token><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>-520</X><Y>9.15</Y><Z>-190</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><bool name="CastShadow">true</bool><Color3uint8 name="Color3uint8">4280427562</Color3uint8><bool name="Locked">false</bool><token name="Material">1088</token><float name="Reflectance">0</float><Vector3 name="size"><X>0.7</X><Y>16.7</Y><Z>0.7</Z></Vector3><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0</float></Properties></Item></Item>
<Item class="Folder" referent="RBXFEE862A5903E4F79894F09F3B80C39A5"><Properties><string name="Name">Delegacia</string></Properties><Item class="Script" referent="RBX1D359C04E50144D89CF57BFC96CD4192"><Properties><string name="Name">Core</string><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[-- DELEGACIA • Núcleo. Cria os remotes, inicia todos os sistemas e missões e instala o HUD em cada jogador.
-- Estrutura: DepartamentoPolicia/{ ...modelo original..., DelegaciaObjects, Delegacia/{ Core, Modules, MissionDefs, Client } }
-- Para adicionar uma missão: crie um ModuleScript em Delegacia/MissionDefs (copie _Template). Para um sistema novo:
-- crie em Modules/Systems e acrescente o nome em "order" abaixo.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local delegacia = script.Parent                 -- pasta Delegacia
local area = delegacia.Parent                   -- modelo DepartamentoPolicia
local objects = area:WaitForChild("DelegaciaObjects")
local modules = delegacia:WaitForChild("Modules")

local Config = require(modules.Config)
local Bus = require(modules.Bus)
local State = require(modules.State)
local Util = require(modules.Util)

-- pasta para tudo que for criado em jogo (NPCs, provas, holofotes, projéteis)
local runtime = workspace:FindFirstChild("DelegaciaRuntime")
if not runtime then
	runtime = Instance.new("Folder")
	runtime.Name = "DelegaciaRuntime"
	runtime.Parent = workspace
end

-- Remotes
local remotes = RS:FindFirstChild("DelegaciaRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "DelegaciaRemotes"
	remotes.Parent = RS
end
local function remote(name)
	local r = remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotes
	end
	return r
end

-- centro e raio do complexo (o modelo inteiro)
local center, extent = Vector3.new(0, 0, 0), Vector3.new(300, 100, 300)
do
	local ok, cf, size = pcall(function() return area:GetBoundingBox() end)
	if ok then
		center, extent = cf.Position, size
	end
end
local radius = math.max(extent.X, extent.Z) / 2 + Config.Hud.ExtraRadius

local ctx = {
	Delegacia = delegacia, Area = area, Objects = objects, Runtime = runtime,
	Config = Config, Bus = Bus, State = State, Util = Util,
	Remotes = {
		Notify = remote("Notify"), Radio = remote("Radio"), Shake = remote("Shake"), Popup = remote("Popup"), Flash = remote("Flash"),
		Subtitle = remote("Subtitle"), Dialog = remote("Dialog"), DialogReply = remote("DialogReply"),
		Minigame = remote("Minigame"), MinigameResult = remote("MinigameResult"),
		CCTV = remote("CCTV"), CCTVExit = remote("CCTVExit"), ToolAction = remote("ToolAction"),
	},
	Systems = {}, Center = center, Radius = radius,
}
Util.Init(ctx)

State.Set("DelegaciaCenter", center)
State.Set("DelegaciaRadius", radius)
State.Set("Power", "on")
State.Set("Alarm", false)
State.Set("Lockdown", false)

-- marcadores invisíveis em jogo (continuam visíveis no Studio para você mover)
local HIDE = {
	"^Cell_%d+$", "^Check_%d+$", "^Scene_%d+$", "^Hide_%d+$", "^Exit_%d+$", "^Ambush_%d+$", "^Bomb_%d+$", "^Tower_%d+$",
	"^Patrol_%d+$", "^Vehicle_Spawn_%d+$", "^RangeTarget_%d+$", "^Interrog_Suspect$", "^TransferPoint$", "^Crisis_",
}
for _, o in ipairs(objects:GetChildren()) do
	if o:IsA("BasePart") then
		for _, pat in ipairs(HIDE) do
			if o.Name:match(pat) then
				o.Transparency = 1
				o.CanCollide = false
				o.CanQuery = false
				o.CanTouch = false
				break
			end
		end
	end
end

-- Sistemas (ordem importa para Init)
local order = {
	"Radio", "Signs", "Alarm", "Power", "Rank", "Duty", "Dialog", "Minigame", "Npc", "Suspects", "Tools", "Armory", "Doors",
	"Custody", "Evidence", "Forensics", "Dispatch", "CCTV", "Towers", "Fleet", "Range", "Officers",
}
local folder = modules.Systems
for _, name in ipairs(order) do
	local ms = folder:FindFirstChild(name)
	if ms then
		local ok, mod = pcall(require, ms)
		if ok then ctx.Systems[name] = mod else warn("[Delegacia] falha ao carregar " .. name .. ": " .. tostring(mod)) end
	else
		warn("[Delegacia] módulo ausente: " .. name)
	end
end

local Missions = require(modules.Missions)
ctx.Systems.Missions = Missions

for _, name in ipairs(order) do
	local mod = ctx.Systems[name]
	if mod and mod.Init then
		local ok, err = pcall(mod.Init, ctx)
		if not ok then warn("[Delegacia] erro em " .. name .. ".Init: " .. tostring(err)) end
	end
end
local okm, errm = pcall(Missions.Init, ctx)
if not okm then warn("[Delegacia] erro em Missions.Init: " .. tostring(errm)) end

-- HUD do cliente
local template = delegacia.Client:FindFirstChild("DelegaciaHUD")
local function install(player)
	task.spawn(function()
		Util.Stat(player)
		local pg = player:WaitForChild("PlayerGui", 30)
		if not pg or pg:FindFirstChild("DelegaciaHUD") or not template then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "DelegaciaHUD"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 7
		template:Clone().Parent = gui
		gui.Parent = pg
	end)
end
Players.PlayerAdded:Connect(install)
for _, p in ipairs(Players:GetPlayers()) do install(p) end

print("[Delegacia] ativa: " .. #Missions.List() .. " missões • patentes, ponto, armaria, custódia, perícia, câmeras, holofotes, frota, estande e oficiais NPC")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX72713038582040CA94DA908098B78248"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBXA977B3303BF64C2F8632078BF58BA9AB"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- DELEGACIA • Configuração central. Ajuste tudo aqui sem mexer nos sistemas.
-- Todos os valores abaixo são lidos em tempo de execução pelos módulos.
local Config = {}

-- ===== Diretor de missões =====
Config.Director = {
	AutoStart = true,      -- o Despacho sorteia chamadas sozinho
	RequireDuty = true,    -- só sorteia se houver policial em serviço (ponto batido)
	FirstDelay = 60,       -- segundos até a 1a chamada
	MinGap = 60,           -- intervalo mínimo entre chamadas
	MaxGap = 150,          -- intervalo máximo entre chamadas
	OfferCount = 3,        -- quantas chamadas o terminal do Despacho oferece de uma vez
}

-- ===== Economia =====
Config.Economy = {
	Stat = "Dinheiro",     -- nome do valor em leaderstats (mesmo do Posto / Oil Rig)
	Paycheck = 70,         -- salário base por contracheque
	PaycheckEvery = 240,   -- segundos entre contracheques (só em serviço)
	EvidenceBounty = 18,   -- pago por evidência depositada
	BookingFee = { 90, 220 }, -- recompensa por fichar um preso (faixa)
}

-- ===== Patentes (carreira) =====
-- XP mínimo, bônus nas recompensas, multiplicador de salário e o que a Armaria libera.
Config.Ranks = {
	{ Name = "Recruta",    XP = 0,    Reward = 0.00, Salary = 1.00, Armory = { "cassetete", "algemas", "radio", "lanterna", "distintivo" } },
	{ Name = "Soldado",    XP = 90,   Reward = 0.05, Salary = 1.15, Armory = { "taser", "kit_evidencia" } },
	{ Name = "Cabo",       XP = 220,  Reward = 0.09, Salary = 1.30, Armory = { "pistola", "kit_digitais" } },
	{ Name = "Sargento",   XP = 440,  Reward = 0.13, Salary = 1.50, Armory = { "binoculos", "colete" } },
	{ Name = "Subtenente", XP = 760,  Reward = 0.17, Salary = 1.70, Armory = { "ariete" } },
