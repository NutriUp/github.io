}

-- ===== Equipamentos =====
Config.Weapons = {
	Baton = { Damage = 12, Cooldown = 0.55, Range = 7.5 },
	Taser = { Range = 45, Cone = 22, Stun = 6.5, Cooldown = 3.5, Cartridges = 3 },
	Pistol = { Damage = 24, Mag = 12, Reserve = 48, Reload = 1.5, Cooldown = 0.2, Range = 260, Spread = 0.012 },
	Cuffs = { Range = 9, Hold = 1.6 },
