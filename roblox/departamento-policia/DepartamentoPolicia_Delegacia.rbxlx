-- ===== atualização dos painéis =====
local function fmtTime(s) return string.format("%d:%02d", math.floor(s / 60), math.floor(s % 60)) end

local function refreshSys()
	local on = player:GetAttribute("EmServico") == true
	dutyL.Text = on and "EM SERVIÇO" or "FORA"
	dutyL.TextColor3 = on and GREEN or YELLOW
	local pw = state:GetAttribute("Power") or "on"
	if pw == "on" then powerL.Text, powerL.TextColor3 = "ONLINE", GREEN
	elseif pw == "emergency" then powerL.Text, powerL.TextColor3 = "GERADOR", YELLOW
	else powerL.Text, powerL.TextColor3 = "FALHA", RED end
	TweenService:Create(dark, TweenInfo.new(0.5), { BackgroundTransparency = pw == "off" and 0.4 or (pw == "emergency" and 0.7 or 1) }):Play()
	local al = state:GetAttribute("Alarm") == true
	local silent = state:GetAttribute("AlarmSilent") == true
	alarmL.Text = al and (silent and "SILENCIOSO" or "ATIVO") or "NORMAL"
	alarmL.TextColor3 = al and RED or GREEN
	local lk = state:GetAttribute("Lockdown") == true
	lockL.Text = lk and "TOTAL" or "LIBERADO"
	lockL.TextColor3 = lk and RED or GREEN
	local open = state:GetAttribute("CellsOpen") or 0
	local total = state:GetAttribute("CellsTotal") or 0
	cellsL.Text = open > 0 and (open .. "/" .. total .. " ABERTAS") or (total .. " FECHADAS")
	cellsL.TextColor3 = open > 0 and YELLOW or GREEN
	local n = state:GetAttribute("OnDutyCount") or 0
	teamL.Text = n .. " EM SERVIÇO"
	teamL.TextColor3 = n > 0 and GREEN or GREY
end

local function refreshMission()
	local id = state:GetAttribute("MissionId")
	if not id or id == "" then card.Visible = false return end
	card.Visible = true
	mCat.Text = string.upper(state:GetAttribute("MissionCategory") or "OCORRÊNCIA")
	mTitle.Text = state:GetAttribute("MissionTitle") or ""
	mDesc.Text = state:GetAttribute("MissionDesc") or ""
	mStep.Text = state:GetAttribute("MissionStep") or ""
	local g = math.max(state:GetAttribute("MissionGoal") or 1, 1)
	local pr = state:GetAttribute("MissionProgress") or 0
	mProg.Text = string.format("%d%%  •  +R$ %d", math.floor(pr / g * 100), state:GetAttribute("MissionReward") or 0)
	TweenService:Create(mFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(pr / g, 0, 1), 1) }):Play()
end

local function refreshRank()
	local name = player:GetAttribute("DpRankName") or "Recruta"
	local xp = player:GetAttribute("DpXP") or 0
	local from = player:GetAttribute("DpXPFrom") or 0
	local to = player:GetAttribute("DpXPTo") or 1
	repTitle.Text = string.upper(name)
	local k = 1
	if to > from then k = math.clamp((xp - from) / (to - from), 0, 1) end
	TweenService:Create(repFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(k, 1) }):Play()
	repInfo.Text = to > from and string.format("%d / %d XP", xp, to) or "Patente máxima"
	local c = player:GetAttribute("DpConduct") or 100
	conductL.Text = "CONDUTA " .. math.floor(c) .. "%"
	conductL.TextColor3 = c < 60 and RED or (c < 85 and YELLOW or GREY)
end

local function refreshChips()
	local info = player:GetAttribute("DpToolInfo") or ""
	toolChip.Visible = info ~= ""
	toolText.Text = info
	local n = player:GetAttribute("DpEvid") or 0
	evidChip.Visible = n > 0
	evidText.Text = "PROVAS COLETADAS: " .. n .. "  (leve ao cofre)"
end

for _, k in ipairs({ "Power", "Alarm", "AlarmSilent", "Lockdown", "CellsOpen", "CellsTotal", "OnDutyCount" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshSys)
end
for _, k in ipairs({ "MissionId", "MissionTitle", "MissionDesc", "MissionStep", "MissionProgress", "MissionGoal", "MissionReward", "MissionCategory" }) do
	state:GetAttributeChangedSignal(k):Connect(refreshMission)
end
for _, k in ipairs({ "DpRankName", "DpXP", "DpXPFrom", "DpXPTo", "DpConduct" }) do
	player:GetAttributeChangedSignal(k):Connect(refreshRank)
end
for _, k in ipairs({ "DpToolInfo", "DpEvid" }) do
	player:GetAttributeChangedSignal(k):Connect(refreshChips)
end
player:GetAttributeChangedSignal("EmServico"):Connect(refreshSys)
refreshSys() refreshMission() refreshRank() refreshChips()

-- zoom dos binóculos
local normalFov = 70
player:GetAttributeChangedSignal("DelegaciaZoom"):Connect(function()
	local cam = workspace.CurrentCamera
	if player:GetAttribute("DpCCTV") then return end
	if player:GetAttribute("DelegaciaZoom") then
		normalFov = cam.FieldOfView
		TweenService:Create(cam, TweenInfo.new(0.35), { FieldOfView = 18 }):Play()
	else
		TweenService:Create(cam, TweenInfo.new(0.35), { FieldOfView = normalFov }):Play()
	end
end)

remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
remotes:WaitForChild("Radio").OnClientEvent:Connect(say)
remotes:WaitForChild("Popup").OnClientEvent:Connect(popup)
remotes:WaitForChild("Flash").OnClientEvent:Connect(function(duration, color)
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.25
	TweenService:Create(flash, TweenInfo.new(duration or 0.3), { BackgroundTransparency = 1 }):Play()
end)

-- tremor de câmera
local shakeEnd, shakePower = 0, 0
remotes:WaitForChild("Shake").OnClientEvent:Connect(function(intensity, duration, pos)
	local scale = 1
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if pos and hrp then
		scale = math.clamp(1 - (hrp.Position - pos).Magnitude / 200, 0.1, 1)
	end
	shakePower = math.max(shakePower, intensity * scale)
	shakeEnd = math.max(shakeEnd, os.clock() + duration)
end)
RunService:BindToRenderStep("DelegaciaShake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeEnd - os.clock()
	if left > 0 and not player:GetAttribute("DpCCTV") then
		local k = math.clamp(left / 1.5, 0, 1) * shakePower
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			* CFrame.Angles(0, 0, math.rad((math.random() - 0.5) * k * 2))
	else
		shakePower = 0
	end
end)

-- relógio, alarme, marcadores e visibilidade por distância
local blink = 0
task.spawn(function()
	while true do
		task.wait(0.25)
		local ends = state:GetAttribute("MissionEndsAt") or 0
		if card.Visible and ends > 0 then
			local left = math.max(0, ends - workspace:GetServerTimeNow())
			mTime.Text = fmtTime(left)
			mTime.TextColor3 = left < 20 and RED or YELLOW
		else
			mTime.Text = ""
		end
		blink += 1
		local alarm = state:GetAttribute("Alarm") == true and state:GetAttribute("AlarmSilent") ~= true
		local target = (alarm and blink % 2 == 0) and 0 or 1
		TweenService:Create(vignette, TweenInfo.new(0.22), { BackgroundTransparency = target }):Play()

		local center = state:GetAttribute("DelegaciaCenter")
		local radius = state:GetAttribute("DelegaciaRadius") or 300
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local near = center ~= nil and hrp ~= nil and (hrp.Position - center).Magnitude <= radius
		root.Visible = near or player:GetAttribute("EmServico") == true

		if hrp then
			for _, g in ipairs(CollectionService:GetTagged("DelegaciaMarker")) do
				local part = g.Parent
				local d = g:FindFirstChild("Dist")
				if part and part:IsA("BasePart") and d then
					d.Text = string.format("%d m", math.floor((part.Position - hrp.Position).Magnitude))
				end
			end
		end
	end
end)

-- recarregar a pistola com R
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.R then
		local info = player:GetAttribute("DpToolInfo") or ""
		if info:sub(1, 7) == "PISTOLA" then remotes.ToolAction:FireServer("reload") end
	end
end)

