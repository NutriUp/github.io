}

-- ===== Suspeitos (NPCs criminosos) =====
Config.Suspects = {
	WalkSpeed = 13, RunSpeed = 19,
	SurrenderHP = 0.25,             -- abaixo desta fração de vida o hostil se rende
	EscortSpeed = 12,
	EscortLeash = 55,               -- distância máxima do policial antes de soltar o escoltado
	CuffHold = 1.6,
	SearchHold = 2.2,               -- revistar um preso algemado
}

-- ===== Custódia (celas, ficha e carceragem) =====
Config.Custody = {
	BookingHold = 3.0,              -- segundos no balcão de identificação
	HoldSeconds = 240,              -- tempo até o preso ser liberado/transferido
	AmbientPrisoners = 2,           -- presos de ambiente quando o servidor inicia
	LockedAtStart = true,
	Chatter = {
		"Eu quero falar com meu advogado!", "Isso é um erro, vocês pegaram o cara errado.",
		"Quanto tempo vai durar isso?", "Ei, policial! Tem água aí?", "Eu não fiz nada...",
		"Essa cela está um gelo.", "Tô com fome!", "Vocês não têm provas.",
	},
}

-- ===== Câmeras / Torres =====
Config.CCTV = { MinRank = 2, SwitchKeys = true }
Config.Towers = {
	Enabled = true,
	SweepRadius = 70,               -- raio do giro do holofote no chão
	SweepSeconds = 9,               -- tempo de uma volta
	Range = 140,
	TrackCivilians = false,         -- true: holofote persegue jogadores fora de serviço no perímetro
	Color = Color3.fromRGB(255, 244, 214),
	GroundY = 2.1,                  -- altura do chão onde o holofote varre
}
Config.Power = { EmergencyRatio = 3 } -- no modo gerador, 1 a cada N luzes fica acesa

-- ===== Frota =====
Config.Fleet = {
	CarName = "FEDERAL CAR",        -- nome dos modelos de viatura existentes
	Cooldown = 15,
	UnoccupiedReturn = 420,         -- segundos vazia e longe do dono antes de voltar à garagem
}

-- ===== Estande de tiro =====
Config.Range = {
	Duration = 45,
	Targets = 8,
	PopMin = 1.0, PopMax = 2.0,
	PointsPerHit = 10,
	PassScore = 60,                 -- nota mínima na prova de tiro
	Payout = 4,                     -- R$ por ponto (treino livre)
	XPPerHit = 1,
}

-- ===== Oficiais NPC (patrulha e apoio) =====
Config.Officers = {
	Enabled = true,
	Count = 3,
	WalkSpeed = 9, RunSpeed = 17,
	RespawnSeconds = 25,
	IdleMin = 5, IdleMax = 14,
	Lines = {
		"Tudo tranquilo por aqui.", "Cobrindo o perímetro.", "Central, setor limpo.",
		"Se precisar de apoio, é só chamar no rádio.", "Boa tarde, equipe.",
		"Olho aberto, pessoal.",
	},
}

-- ===== Missões (parâmetros específicos) =====
Config.Missions = {
	Patrol = { Duration = 190, Reward = 260 },
	CrimeScene = { Duration = 330, Reward = 620 },
	Interrogation = { Duration = 300, Reward = 700 },
	MostWanted = { Duration = 280 },
	PrisonBreak = { Duration = 160, Reward = 600 },
	Riot = { Duration = 200, Reward = 780 },
	Bomb = { Duration = 190, Reward = 880, Blast = 24 },
	Hack = { Duration = 210, Reward = 700 },
	Blackout = { Duration = 170, Reward = 540 },
	Hostage = { Duration = 220, Reward = 980 },
	Transfer = { Duration = 240, Reward = 820 },
	Perimeter = { Duration = 200, Reward = 640 },
