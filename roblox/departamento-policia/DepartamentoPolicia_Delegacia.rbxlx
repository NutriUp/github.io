		<Item class="Script" referent="RBX4D5ED45EABD1450A9E5ED30F765FB407">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	PortasELuzes  (Script dentro da pasta DepartamentoPolicia)

	PORTAS:  cada modelo "Door" (com a folha "Door") ganha um ProximityPrompt (tecla E).
	         A folha gira em torno da dobradica, para longe de quem abriu, e fecha sozinha
	         depois de PortaFechaAuto segundos (se ninguem estiver na passagem).
	LUZES:   todas as luzes (SurfaceLight / PointLight / SpotLight) sao agrupadas em zonas
	         (LuzRaioZona). Cada zona ganha um interruptor invisivel (ProximityPrompt, tecla E)
	         a altura do peito: "Apagar luz" / "Ligar luz".

	Tudo se ajusta na tabela CFG. O estado de cada zona fica no atributo LuzLigada do interruptor.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local CFG = {
	Tecla = Enum.KeyCode.E,
	PortaAngulo = 90,
	PortaTempo = 0.55,
	PortaFechaAuto = 8,     -- segundos; 0 = nunca fecha sozinha
	PortaDistancia = 7,
	LuzRaioZona = 14,       -- studs: luzes dentro deste raio formam uma zona
	LuzDistancia = 14,
	LuzesApagadasNoInicio = false,
}

local SSS = game:GetService("ServerScriptService")
local root = (script.Parent == SSS or script.Parent == workspace) and workspace or script.Parent

local function flat(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end

local function playerNear(pos, dist)
	for _, pl in ipairs(Players:GetPlayers()) do
		local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - pos).Magnitude < dist then return true end
	end
	return false
end

------------------------------------------------------------------------
-- PORTAS
------------------------------------------------------------------------
local tweenInfo = TweenInfo.new(CFG.PortaTempo, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function doorGeometry(leaf)
	local cf, sz = leaf.CFrame, leaf.Size
	local list = {
		{ v = cf.RightVector, s = sz.X },
		{ v = cf.UpVector, s = sz.Y },
		{ v = cf.LookVector, s = sz.Z },
	}
	table.sort(list, function(a, b) return math.abs(a.v.Y) > math.abs(b.v.Y) end) -- [1] = eixo vertical
	local a, b = list[2], list[3]
	if b.s > a.s then a, b = b, a end -- a = largura da folha, b = espessura
	local long = Vector3.new(a.v.X, 0, a.v.Z).Unit
	local thin = Vector3.new(b.v.X, 0, b.v.Z).Unit
	return long, a.s, thin
end

local function closeDoor(d) end -- definido abaixo

local function setDoor(d, open, playerPos)
	if d.Busy then return end
	d.Busy = true
	local angle = 0
	if open then
		local side = ((playerPos or d.Leaf.Position) - d.Leaf.Position):Dot(d.Thin) >= 0 and 1 or -1
		angle = math.rad(CFG.PortaAngulo)
		for _, a in ipairs({ math.rad(CFG.PortaAngulo), -math.rad(CFG.PortaAngulo) }) do
			local nu = CFrame.Angles(0, a, 0):VectorToWorldSpace(d.U)
			if nu:Dot(d.Thin) * side < 0 then angle = a break end -- ponta da folha vai para o lado oposto ao jogador
		end
	end
	local rot = CFrame.new(d.Hinge) * CFrame.Angles(0, angle, 0) * CFrame.new(-d.Hinge)
	for part, original in pairs(d.Parts) do
		TweenService:Create(part, tweenInfo, { CFrame = rot * original }):Play()
	end
	d.Open = open
	d.Prompt.ActionText = open and "Fechar" or "Abrir"
	task.delay(CFG.PortaTempo + 0.05, function() d.Busy = false end)
end

function closeDoor(d)
	setDoor(d, false)
end

local function autoClose(d, token)
	if CFG.PortaFechaAuto <= 0 then return end
	task.delay(CFG.PortaFechaAuto, function()
		while d.Open and d.Token == token do
			if playerNear(d.Leaf.Position, 5) then
				task.wait(1.5)
			else
				closeDoor(d)
				break
			end
		end
	end)
end

local function setupDoor(model, leaf)
	local long, longSize, thin = doorGeometry(leaf)
	local parts = { [leaf] = leaf.CFrame }
	local sz = leaf.Size
	local handleSum, handleN = 0, 0
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= leaf and not p.CanCollide then
			local rel = leaf.CFrame:PointToObjectSpace(p.Position)
			if math.abs(rel.X) <= sz.X / 2 + 0.8 and math.abs(rel.Y) <= sz.Y / 2 + 0.8 and math.abs(rel.Z) <= sz.Z / 2 + 0.8 then
				parts[p] = p.CFrame
				handleSum += (p.Position - leaf.Position):Dot(long)
				handleN += 1
			end
		end
	end
	local hOff = handleN > 0 and handleSum / handleN or 1
	if math.abs(hOff) < 0.2 then hOff = 1 end
	local hingeSign = hOff > 0 and -1 or 1 -- dobradica no lado oposto aos puxadores
	local hinge = leaf.Position + long * hingeSign * (longSize / 2)
	local u = Vector3.new(leaf.Position.X - hinge.X, 0, leaf.Position.Z - hinge.Z).Unit

	for _, old in ipairs(leaf:GetChildren()) do
		if old:IsA("ProximityPrompt") and old.Name == "PromptPorta" then old:Destroy() end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PromptPorta"
	prompt.ObjectText = "Porta"
	prompt.ActionText = "Abrir"
	prompt.KeyboardKeyCode = CFG.Tecla
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CFG.PortaDistancia
	prompt.RequiresLineOfSight = false
	prompt.Parent = leaf

	local d = { Model = model, Leaf = leaf, Parts = parts, Hinge = hinge, U = u, Thin = thin, Prompt = prompt, Open = false, Busy = false, Token = 0 }
	prompt.Triggered:Connect(function(player)
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if d.Open then
			d.Token += 1
			closeDoor(d)
		else
			d.Token += 1
			setDoor(d, true, r and r.Position)
			autoClose(d, d.Token)
		end
	end)
	return d
end

local doorCount = 0
for _, m in ipairs(root:GetDescendants()) do
	if m:IsA("Model") and m.Name == "Door" then
		local leaf = m:FindFirstChild("Door")
		if leaf and leaf:IsA("BasePart") then
			local ok, err = pcall(setupDoor, m, leaf)
			if ok then doorCount += 1 else warn("[PortasELuzes] erro numa porta: " .. tostring(err)) end
		end
	end
end

------------------------------------------------------------------------
-- LUZES
------------------------------------------------------------------------
local lights = {}
do
	local n = 0
	for _, inst in ipairs(root:GetDescendants()) do
		n += 1
		if n % 4000 == 0 then task.wait() end
		if inst:IsA("Light") and inst.Parent and inst.Parent:IsA("BasePart") then
			lights[#lights + 1] = { Light = inst, Part = inst.Parent, Material = inst.Parent.Material, Color = inst.Parent.Color }
		end
	end
end

local switchFolder = root:FindFirstChild("InterruptoresLuz")
if switchFolder then switchFolder:ClearAllChildren() else
	switchFolder = Instance.new("Folder")
	switchFolder.Name = "InterruptoresLuz"
	switchFolder.Parent = root
end

local function setZone(zone, on)
	zone.On = on
	zone.Node:SetAttribute("LuzLigada", on)
	zone.Prompt.ActionText = on and "Apagar luz" or "Ligar luz"
	for _, l in ipairs(zone.Lights) do
		l.Light.Enabled = on
		if on then
			l.Part.Material = l.Material
			l.Part.Color = l.Color
		else
			if l.Material == Enum.Material.Neon then l.Part.Material = Enum.Material.SmoothPlastic end
			l.Part.Color = l.Color:Lerp(Color3.new(0, 0, 0), 0.55)
		end
	end
end

local zones = {}
do
	local free = {}
	for _, l in ipairs(lights) do free[#free + 1] = l end
	while #free > 0 do
		local seed = table.remove(free, 1)
		local group, rest = { seed }, {}
		for _, l in ipairs(free) do
			if flat(l.Part.Position, seed.Part.Position) <= CFG.LuzRaioZona
				and math.abs(l.Part.Position.Y - seed.Part.Position.Y) <= 8 then
				group[#group + 1] = l
			else
				rest[#rest + 1] = l
			end
		end
		free = rest

		local sx, sz, minY = 0, 0, math.huge
		for _, l in ipairs(group) do
			sx += l.Part.Position.X
			sz += l.Part.Position.Z
			minY = math.min(minY, l.Part.Position.Y)
		end
		local cx, cz = sx / #group, sz / #group
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { switchFolder }
		local res = workspace:Raycast(Vector3.new(cx, minY - 0.5, cz), Vector3.new(0, -25, 0), params)
		local y = res and (res.Position.Y + 4.5) or (minY - 5.5)
		y = math.clamp(y, minY - 8, minY - 2)

		local node = Instance.new("Part")
		node.Name = "InterruptorLuz"
		node.Size = Vector3.new(1, 1, 1)
		node.Transparency = 1
		node.Anchored = true
		node.CanCollide, node.CanQuery, node.CanTouch = false, false, false
		node.Position = Vector3.new(cx, y, cz)
		node.Parent = switchFolder

		local prompt = Instance.new("ProximityPrompt")
		prompt.ObjectText = "Luzes"
		prompt.ActionText = "Apagar luz"
		prompt.KeyboardKeyCode = CFG.Tecla
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = CFG.LuzDistancia
		prompt.RequiresLineOfSight = false
		prompt.Parent = node

		local zone = { Lights = group, Node = node, Prompt = prompt, On = true }
		zones[#zones + 1] = zone
		prompt.Triggered:Connect(function() setZone(zone, not zone.On) end)
		if CFG.LuzesApagadasNoInicio then setZone(zone, false) else node:SetAttribute("LuzLigada", true) end
	end
end

print(string.format("[PortasELuzes] portas ativas: %d | luzes: %d em %d interruptores", doorCount, #lights, #zones))
]]></ProtectedString>
