					</Item>
					<Item class="Script" referent="RBX5529AA283EF94837A4C3C83837AFB730">
						<Properties>
							<ProtectedString name="Source"><![CDATA[-- SirenServer: só o motorista sentado controla sirene e barra de luz
local seat = script.Parent
local car = seat.Parent
local event = seat:WaitForChild("SirenEvent")
local TONES = { Wail = "Wail", Yelp = "Yelp", Priority = "Priority", Parad = "Parada" }

local function getBar()
	local body = car:FindFirstChild("Body")
	return body and body:FindFirstChild("lightbar1")
end

local function isDriver(player)
	local occ = seat.Occupant
	return occ ~= nil and player.Character ~= nil and occ.Parent == player.Character
end

local function stopTones(mid, except)
	for _, n in ipairs({ "Wail", "Yelp", "Priority", "Parada" }) do
		local s = mid:FindFirstChild(n)
		if s and s:IsA("Sound") and n ~= except then s:Stop() end
	end
end

local function beep(mid)
	local b = mid:FindFirstChild("Beep")
	if b and b:IsA("Sound") then b:Play() end
end

event.OnServerEvent:Connect(function(player, action, state)
	if typeof(action) ~= "string" or not isDriver(player) then return end
	local bar = getBar()
	local mid = bar and bar:FindFirstChild("middle")
	if not mid then return end

	if action == "Lightbar" then
		local on = bar:FindFirstChild("on")
		if on and on:IsA("BoolValue") then on.Value = not on.Value end
		beep(mid)
	elseif action == "Horn" then
		local horn = mid:FindFirstChild("Airhorn")
		if horn and horn:IsA("Sound") then
			if state == true then horn:Play() else horn:Stop() end
		end
	elseif TONES[action] then
		local s = mid:FindFirstChild(TONES[action])
		if not s or not s:IsA("Sound") then return end
		beep(mid)
		if s.IsPlaying then
			s:Stop()
		else
			stopTones(mid, TONES[action])
			s:Play()
		end
	end
end)

seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	if seat.Occupant ~= nil then return end
	local bar = getBar()
	if not bar then return end
	local on = bar:FindFirstChild("on")
	if on and on:IsA("BoolValue") then on.Value = false end
	local mid = bar:FindFirstChild("middle")
	if mid then
		stopTones(mid)
		local horn = mid:FindFirstChild("Airhorn")
		if horn and horn:IsA("Sound") then horn:Stop() end
	end
end)
]]></ProtectedString>
