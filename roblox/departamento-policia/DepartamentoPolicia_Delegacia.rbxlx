							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="Hat" referent="RBXA6F7A6BAB73344619469638D457134E9">
						<Properties>
							<CoordinateFrame name="AttachmentPoint">
								<X>0</X>
								<Y>-0.0900000036</Y>
								<Z>0</Z>
								<R00>1</R00>
								<R01>0</R01>
								<R02>0</R02>
								<R10>0</R10>
								<R11>1</R11>
