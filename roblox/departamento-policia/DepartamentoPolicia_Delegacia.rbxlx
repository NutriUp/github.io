}

-- ===== Recompensas base =====
Config.Rewards = { Cuff = 12, Book = 20, Evidence = 10, Assist = 8 }

-- ===== Sons (cole IDs como "rbxassetid://123"). Vazio = sem som =====
Config.Sounds = {
	Alarm = "", Siren = "", Radio = "", Complete = "", Fail = "", Cuff = "", Taser = "", Shot = "",
	Reload = "", Baton = "", Door = "", Camera = "", Beep = "", Explosion = "", Keypad = "", Purchase = "",
	Lockdown = "", Generator = "", Bark = "", Mugshot = "", Paycheck = "",
}

-- ===== HUD =====
Config.Hud = { ExtraRadius = 140 }

-- ===== Dicas aleatórias que o DESPACHO solta no rádio =====
Config.Tips = {
	"Bata o ponto para entrar em serviço e liberar a armaria.",
	"Quanto maior a patente, melhor o equipamento e o bônus nas missões.",
	"Bateu em suspeito rendido? Isso custa pontos de conduta.",
