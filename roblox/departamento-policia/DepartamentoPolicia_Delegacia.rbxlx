end

script.Parent.OnServerEvent:Connect(function(plr,car,func,...)
	local ownCar = script.Parent.Parent
	if car ~= ownCar then return end
	local _seat = ownCar:FindFirstChild("DriveSeat")
	local _occ = _seat and _seat.Occupant
	if not _occ or _occ.Parent ~= plr.Character then return end
	if func=='create' then
