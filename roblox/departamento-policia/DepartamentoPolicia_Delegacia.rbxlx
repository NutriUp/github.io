	Last = { "Moura", "Cardoso", "Batista", "Nunes", "Lacerda", "Peixoto", "Brandão", "Siqueira", "Tavares", "Fontes" },
	Nick = { "Sombra", "Gato", "Faísca", "Corvo", "Mosca", "Víbora", "Cobra", "Trovão", "Fantasma", "Dado" },
