						<Item class="LocalScript" referent="RBXBD85C400033A4DDB902E659E4B766BF4">
							<Properties>
								<ProtectedString name="Source"><![CDATA[-- SirenClient: botões do painel -> servidor (FE)
local gui = script.Parent
local seat = gui:WaitForChild("SeatRef").Value
local event = seat:WaitForChild("SirenEvent")
local control = gui:WaitForChild("Control")

local tones = { Lightbar = "Lightbar", Prior = "Priority", Wail = "Wail", Yelp = "Yelp", Parad = "Parad" }
for buttonName, action in pairs(tones) do
	local b = control:FindFirstChild(buttonName)
	if b and b:IsA("GuiButton") then
		b.MouseButton1Click:Connect(function() event:FireServer(action) end)
	end
end

local horn = control:FindFirstChild("Part")
if horn and horn:IsA("GuiButton") then
	horn.MouseButton1Down:Connect(function() event:FireServer("Horn", true) end)
	horn.MouseButton1Up:Connect(function() event:FireServer("Horn", false) end)
end
]]></ProtectedString>
