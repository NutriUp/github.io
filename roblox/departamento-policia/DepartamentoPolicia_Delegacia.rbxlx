mgClose.Position = UDim2.new(1, -48, 0, 8)
mgClose.ZIndex = 45
local mgToken, mgKind, mgGen = nil, nil, 0
local mgRetry
local mgLock = false

local function mgClear()
	for _, c in ipairs(mgBody:GetChildren()) do c:Destroy() end
	mgRetry = nil
end

local function mgHide()
	mg.Visible = false
	mgToken = nil
	mgKind = nil
	mgClear()
end

local function mgSubmit(answer)
	if mgToken and not mgLock then
		mgLock = true
		remotes.MinigameResult:FireServer(mgToken, answer)
		task.delay(0.3, function() mgLock = false end)
	end
end

mgClose.Activated:Connect(function()
	if mgToken then remotes.MinigameResult:FireServer(mgToken, "cancel") end
end)

-- padrão de digital desenhado a partir de uma semente (mesma semente = mesmo desenho)
local function drawPrint(parent, seed)
	local rng = Random.new(seed)
	local rings = rng:NextInteger(5, 8)
	for i = 1, rings do
		local s = i / rings
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5 + (rng:NextNumber() - 0.5) * 0.08, 0.5 + (rng:NextNumber() - 0.5) * 0.08)
		ring.Size = UDim2.fromScale(s * 0.92, s * 0.92 * (0.72 + rng:NextNumber() * 0.28))
		ring.Rotation = rng:NextInteger(-40, 40)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 43
		ring.Parent = parent
		corner(ring, 999)
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Color = Color3.fromRGB(150, 210, 255)
		st.Parent = ring
	end
	for _ = 1, 6 do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromOffset(6, 6)
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.fromScale(0.2 + rng:NextNumber() * 0.6, 0.2 + rng:NextNumber() * 0.6)
		dot.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
		dot.BorderSizePixel = 0
		dot.ZIndex = 44
		dot.Parent = parent
		corner(dot, 3)
	end
end

local WIRE = {
	Vermelho = Color3.fromRGB(225, 55, 55), Azul = Color3.fromRGB(60, 120, 235), Verde = Color3.fromRGB(70, 205, 105),
	Amarelo = Color3.fromRGB(245, 215, 60), Branco = Color3.fromRGB(240, 240, 240), Preto = Color3.fromRGB(40, 40, 46),
}
local PAD = { Color3.fromRGB(225, 55, 55), Color3.fromRGB(60, 120, 235), Color3.fromRGB(70, 205, 105), Color3.fromRGB(245, 215, 60) }

local builders = {}

builders.keypad = function(p)
	mgClue.Text = (p.hint ~= "" and p.hint or "Digite o código.") .. "   Tentativas: " .. p.attempts
	local entered = ""
	local display = label(mgBody, "", 30, GREEN, Enum.Font.Code, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 44), Enum.TextXAlignment.Center)
	display.ZIndex = 42
	display.BackgroundTransparency = 0
	display.BackgroundColor3 = Color3.fromRGB(14, 22, 20)
	corner(display, 8)
	local function show() display.Text = entered .. string.rep("•", p.digits - #entered) end
	show()
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0.5, -120, 0, 54)
	grid.Size = UDim2.new(0, 240, 0, 200)
	grid.ZIndex = 42
	grid.Parent = mgBody
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(74, 44)
	gl.CellPadding = UDim2.fromOffset(9, 8)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "OK" }
	for i, k in ipairs(keys) do
		local b = button(grid, k, UDim2.fromOffset(74, 44), k == "OK" and Color3.fromRGB(26, 90, 50) or (k == "C" and Color3.fromRGB(90, 30, 30) or nil))
		b.LayoutOrder = i
		b.ZIndex = 43
		b.Activated:Connect(function()
			if k == "C" then entered = ""
			elseif k == "OK" then
				if #entered == p.digits then mgSubmit(entered) end
			elseif #entered < p.digits then entered ..= k end
			show()
		end)
	end
	mgRetry = function(left)
		entered = ""
		show()
		mgClue.Text = "CÓDIGO ERRADO! Tentativas restantes: " .. left
		mgClue.TextColor3 = RED
	end
end

builders.wires = function(p)
	mgClue.Text = p.clue
	local n = #p.colors
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 42
	holder.Parent = mgBody
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 12)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Parent = holder
	for i, name in ipairs(p.colors) do
		local b = Instance.new("TextButton")
		b.Text = ""
		b.AutoButtonColor = false
		b.Size = UDim2.new(0.82, 0, 0, 24)
		b.BackgroundColor3 = WIRE[name] or Color3.new(1, 1, 1)
		b.BorderSizePixel = 0
		b.ZIndex = 43
		b.Parent = holder
		corner(b, 12)
		stroke(b, Color3.new(0, 0, 0), 2)
		b.Activated:Connect(function()
			b.BackgroundTransparency = 0.7
			mgSubmit(i)
		end)
	end
end

builders.sequence = function(p)
	mgClue.Text = "Memorize a sequência..."
	local pads = {}
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.AnchorPoint = Vector2.new(0.5, 0)
	grid.Position = UDim2.new(0.5, 0, 0, 0)
	grid.Size = UDim2.new(0, 260, 0, 260)
	grid.ZIndex = 42
	grid.Parent = mgBody
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(124, 124)
	gl.CellPadding = UDim2.fromOffset(10, 10)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	local acceptInput = false
	local input = {}
	local token = mgToken
	local function lit(i, on) pads[i].BackgroundTransparency = on and 0 or 0.65 end
	for i = 1, 4 do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.Text = ""
		b.AutoButtonColor = false
		b.BackgroundColor3 = PAD[i]
		b.BackgroundTransparency = 0.65
		b.BorderSizePixel = 0
		b.ZIndex = 43
		b.Parent = grid
		corner(b, 14)
		pads[i] = b
		b.Activated:Connect(function()
			if not acceptInput then return end
			table.insert(input, i)
			lit(i, true)
			task.delay(0.15, function() if pads[i].Parent then lit(i, false) end end)
			if #input >= #p.seq then
				acceptInput = false
				mgSubmit(input)
			end
		end)
	end
	task.spawn(function()
		task.wait(0.9)
		for _, s in ipairs(p.seq) do
			if mgToken ~= token then return end
			lit(s, true)
			task.wait(0.55)
			lit(s, false)
			task.wait(0.25)
		end
		if mgToken ~= token then return end
		mgClue.Text = "Agora repita a sequência!"
		acceptInput = true
	end)
end

builders.fingerprint = function(p)
	mgClue.Text = "Encontre a digital igual à amostra."
	local sample = Instance.new("Frame")
	sample.Position = UDim2.new(0, 0, 0, 0)
	sample.Size = UDim2.new(0, 150, 0, 190)
	sample.BackgroundColor3 = Color3.fromRGB(14, 20, 34)
	sample.ZIndex = 42
	sample.Parent = mgBody
	corner(sample, 10) stroke(sample, YELLOW, 2)
	drawPrint(sample, p.target)
	label(sample, "AMOSTRA", 11, YELLOW, Enum.Font.GothamBold, UDim2.new(0, 6, 1, -18), UDim2.new(1, -12, 0, 14), Enum.TextXAlignment.Center).ZIndex = 45
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0, 168, 0, 0)
	grid.Size = UDim2.new(1, -168, 1, 0)
	grid.ZIndex = 42
	grid.Parent = mgBody
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(100, 120)
	gl.CellPadding = UDim2.fromOffset(8, 8)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	for i, seed in ipairs(p.candidates) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.Text = ""
		b.AutoButtonColor = true
		b.BackgroundColor3 = Color3.fromRGB(14, 20, 34)
		b.BorderSizePixel = 0
		b.ZIndex = 42
		b.Parent = grid
		corner(b, 8) stroke(b, BLUE, 1)
		drawPrint(b, seed)
		local num = label(b, tostring(i), 11, GREY, Enum.Font.GothamBold, UDim2.new(0, 4, 0, 2), UDim2.new(0, 14, 0, 14))
		num.ZIndex = 46
		b.Activated:Connect(function() mgSubmit(i) end)
	end
end

remotes:WaitForChild("Minigame").OnClientEvent:Connect(function(action, token, a, b)
	if action == "start" then
		mgClear()
		mgGen += 1
		mgToken = token
		mgKind = a.kind
		mgTitle.Text = a.title ~= "" and a.title or string.upper(a.kind)
		mgClue.TextColor3 = YELLOW
		mgClue.Text = ""
		mg.Visible = true
		local build = builders[a.kind]
		if build then build(a) end
		mgTimer.Size = UDim2.fromScale(1, 1)
		TweenService:Create(mgTimer, TweenInfo.new(a.timeout or 60, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
	elseif action == "retry" then
		if token == mgToken and mgRetry then mgRetry(a) end
	elseif action == "end" then
		if token ~= mgToken then return end
		local ok, msg = a, b
		mgClue.Text = ok and "SUCESSO!" or (msg ~= "" and msg or "FALHOU!")
		mgClue.TextColor3 = ok and GREEN or RED
		local mine = mgGen
		task.delay(0.9, function()
			if mgGen == mine then mgHide() end
		end)
		mgToken = nil
	end
end)

-- ===== CÂMERAS DE SEGURANÇA =====
local cc = Instance.new("Frame")
cc.Size = UDim2.fromScale(1, 1)
cc.BackgroundTransparency = 1
cc.Visible = false
cc.ZIndex = 20
cc.Parent = gui
local function blackBar(top)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0, top and 0 or 1)
	f.Position = UDim2.fromScale(0, top and 0 or 1)
	f.Size = UDim2.new(1, 0, 0, 70)
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.BackgroundTransparency = 0.25
	f.BorderSizePixel = 0
	f.ZIndex = 21
	f.Parent = cc
	return f
end
local topBar, botBar = blackBar(true), blackBar(false)
local camName = label(topBar, "CAM 01", 22, GREEN, Enum.Font.Code, UDim2.new(0, 24, 0, 22), UDim2.new(0.4, 0, 0, 30))
camName.ZIndex = 22
local camRec = label(topBar, "● REC", 20, RED, Enum.Font.Code, UDim2.new(1, -140, 0, 22), UDim2.new(0, 110, 0, 30), Enum.TextXAlignment.Right)
camRec.ZIndex = 22
local camTime = label(botBar, "", 18, GREEN, Enum.Font.Code, UDim2.new(0, 24, 0, 20), UDim2.new(0.4, 0, 0, 28))
camTime.ZIndex = 22
local camHelp = label(botBar, "A / D trocar câmera   •   E ou BACKSPACE sair", 15, GREY, Enum.Font.Code, UDim2.new(0.4, 0, 0, 20), UDim2.new(0.6, -24, 0, 28), Enum.TextXAlignment.Right)
camHelp.ZIndex = 22
local scan = Instance.new("Frame")
scan.Size = UDim2.fromScale(1, 1)
scan.BackgroundColor3 = Color3.fromRGB(40, 255, 120)
scan.BackgroundTransparency = 0.94
scan.BorderSizePixel = 0
scan.ZIndex = 20
scan.Parent = cc
local boxes = {}

local cctv = { active = false, cams = {}, idx = 1 }
local savedFov = 70

local function cctvExit(notify)
	if not cctv.active then return end
	cctv.active = false
	RunService:UnbindFromRenderStep("DelegaciaCCTV")
	cc.Visible = false
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = savedFov
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
	for _, b in ipairs(boxes) do b.Visible = false end
	if notify then remotes.CCTVExit:FireServer() end
end

local function cctvLabel()
	camName.Text = cctv.cams[cctv.idx] and cctv.cams[cctv.idx].Name or "CAM"
end

local function cctvOpen(list)
	if cctv.active or #list == 0 then return end
	cctv.cams = list
	cctv.idx = 1
	cctv.active = true
	local cam = workspace.CurrentCamera
	savedFov = cam.FieldOfView
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 62
	cc.Visible = true
	cctvLabel()
	RunService:BindToRenderStep("DelegaciaCCTV", Enum.RenderPriority.Camera.Value + 2, function()
		if not cctv.active then return end
		local c = cctv.cams[cctv.idx]
		local t = os.clock()
		cam.CFrame = c.CFrame * CFrame.Angles(0, math.sin(t * 0.35) * 0.22, 0)
		camTime.Text = os.date("%d/%m/%Y  %H:%M:%S")
		camRec.TextTransparency = (math.floor(t * 2) % 2 == 0) and 0 or 1
		-- caixas de alvo para peças marcadas pelo servidor
		local targets = CollectionService:GetTagged("DpCamTarget")
		for i, part in ipairs(targets) do
			local b = boxes[i]
			if not b then
				b = Instance.new("Frame")
				b.BackgroundTransparency = 1
				b.ZIndex = 23
				b.Parent = cc
				stroke(b, RED, 2).Transparency = 0
				local tag = label(b, "ALVO", 13, RED, Enum.Font.Code, UDim2.new(0, 0, 1, 2), UDim2.new(1, 0, 0, 16), Enum.TextXAlignment.Center)
				tag.ZIndex = 24
				boxes[i] = b
			end
			local v, on = cam:WorldToViewportPoint(part.Position)
			if on and v.Z > 0 and v.Z < 400 then
				local size = math.clamp(2600 / v.Z, 40, 180)
				b.Position = UDim2.fromOffset(v.X - size / 2, v.Y - size / 2)
				b.Size = UDim2.fromOffset(size, size)
				b.Visible = true
			else
				b.Visible = false
			end
		end
		for i = #targets + 1, #boxes do boxes[i].Visible = false end
	end)
end

remotes:WaitForChild("CCTV").OnClientEvent:Connect(function(action, list)
	if action == "open" then
		cctvOpen(list)
	elseif action == "close" then
		cctvExit(false)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	-- diálogo: teclas 1-4
	if dlgToken and not processed then
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= dlgCount then dlgPick(n) return end
	end
	if not cctv.active then return end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.D or kc == Enum.KeyCode.Right then
		cctv.idx = cctv.idx % #cctv.cams + 1
		cctvLabel()
	elseif kc == Enum.KeyCode.A or kc == Enum.KeyCode.Left then
		cctv.idx = (cctv.idx - 2) % #cctv.cams + 1
		cctvLabel()
	elseif kc == Enum.KeyCode.E or kc == Enum.KeyCode.Backspace then
		cctvExit(true)
	end
end)

player.CharacterRemoving:Connect(function()
	if cctv.active then cctvExit(false) end
	if dlgToken then dlgClose() end
	if mgToken then mgHide() end
end)
