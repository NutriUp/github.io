							<Item class="Script" referent="RBXF63B5264B9784D8191687E669E953B19">
								<Properties>
									<ProtectedString name="Source"><![CDATA[veh = script.Parent
while true do
wait(0)
if script.Parent.on.Value == true then
	
	veh.TL1.Transparency = 0
	veh.TL2.Transparency = 1
	wait(0.3)
	
	veh.TL1.Transparency = 1
	veh.TL2.Transparency = 0
	wait(0.3)
	
else
	veh.TL1.Transparency = 1
	veh.TL2.Transparency = 1
end
end]]></ProtectedString>
