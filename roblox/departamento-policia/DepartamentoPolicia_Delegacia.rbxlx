									<Item class="Script" referent="RBX42A974F50E7B48B989FB2E6F3E04D9B7">
										<Properties>
											<ProtectedString name="Source"><![CDATA[local car = script.Parent.Parent
local F = {}

F.UpdateSmoke = function(rl,rr)
	rl = math.clamp(tonumber(rl) or 0, 0, 100)
	rr = math.clamp(tonumber(rr) or 0, 0, 100)
	car.Wheels.RL.Smoke.Rate = rl
	car.Wheels.RR.Smoke.Rate = rr
	car.Wheels.RL.SQ.Volume = rl/50
	car.Wheels.RR.SQ.Volume = rr/50
end

script.Parent.OnServerEvent:connect(function(pl,Fnc,...)
	local _seat = car:FindFirstChild("DriveSeat")
	local _occ = _seat and _seat.Occupant
	if not _occ or _occ.Parent ~= pl.Character then return end
	if type(Fnc) ~= "string" or not F[Fnc] then return end
	F[Fnc](...)
end)

car.DriveSeat.ChildRemoved:connect(function(child)
	if child.Name=="SeatWeld" then
		car.Wheels.RL.SQ:Stop()
		car.Wheels.RR.SQ:Stop()
		car.Wheels.RL.Smoke.Rate=0
		car.Wheels.RR.Smoke.Rate=0
	end
end)

for i,v in pairs(car.Wheels:GetChildren()) do
	if v.Name=="RL" or v.Name=="RR" or v.Name=="R" then
		local sq = script.Parent.SQ:Clone()
		sq.Parent=v
		local sm = script.Parent.Smoke:Clone()
		sm.Parent=v
	end
end]]></ProtectedString>
