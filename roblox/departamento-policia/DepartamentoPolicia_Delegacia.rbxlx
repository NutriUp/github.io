						<Item class="Script" referent="RBX89921E27B54F46509FD4C0A06E3E8839">
							<Properties>
								<ProtectedString name="Source"><![CDATA[-- Pickup (limpo): entrega o painel de sirene ao motorista
local Players = game:GetService("Players")
local seat = script.Parent
local car = seat.Parent
local originalName = car.Name

local function playerFromWeld(weld)
	local part1 = weld:IsA("Weld") and weld.Part1
	if not part1 then return nil end
	return Players:GetPlayerFromCharacter(part1.Parent)
end

local function play(name)
	local s = seat:FindFirstChild(name)
	if s and s:IsA("Sound") then s:Play() end
end

seat.ChildAdded:Connect(function(child)
	if child.Name ~= "SeatWeld" then return end
	local player
	for _ = 1, 20 do
		player = playerFromWeld(child)
		if player then break end
		task.wait()
	end
	if not player then return end
	local template = seat:FindFirstChild("SirenControl")
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not template or not playerGui then return end

	local carName = player.Name .. "'s Car"
	car.Name = carName
	template.Control.CarName.Value = carName

	local old = playerGui:FindFirstChild("SirenControl")
	if old then old:Destroy() end
	local gui = template:Clone()
	local seatRef = Instance.new("ObjectValue")
	seatRef.Name = "SeatRef"
	seatRef.Value = seat
	seatRef.Parent = gui
	gui.Parent = playerGui

	play("Startup")
end)

seat.ChildRemoved:Connect(function(child)
	if child.Name ~= "SeatWeld" then return end
	car.Name = originalName
	local template = seat:FindFirstChild("SirenControl")
	if template then template.Control.CarName.Value = originalName end
	for _, p in ipairs(Players:GetPlayers()) do
		local pg = p:FindFirstChildOfClass("PlayerGui")
		local g = pg and pg:FindFirstChild("SirenControl")
		if g and g:FindFirstChild("SeatRef") and g.SeatRef.Value == seat then g:Destroy() end
	end
end)
]]></ProtectedString>
