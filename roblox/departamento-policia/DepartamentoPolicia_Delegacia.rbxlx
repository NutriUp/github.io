-- ===== DIÁLOGO COM ESCOLHAS =====
local dlg = Instance.new("Frame")
dlg.AnchorPoint = Vector2.new(0.5, 1)
dlg.Position = UDim2.new(0.5, 0, 1, -96)
dlg.Size = UDim2.new(0, 580, 0, 0)
dlg.AutomaticSize = Enum.AutomaticSize.Y
dlg.BackgroundColor3 = PANEL
dlg.BackgroundTransparency = 0.1
dlg.Visible = false
dlg.ZIndex = 30
dlg.Parent = gui
corner(dlg, 12) stroke(dlg, BLUE, 2)
local dlgLayout = Instance.new("UIListLayout")
dlgLayout.Padding = UDim.new(0, 6)
dlgLayout.SortOrder = Enum.SortOrder.LayoutOrder
dlgLayout.Parent = dlg
local dlgPad = Instance.new("UIPadding")
dlgPad.PaddingLeft = UDim.new(0, 14) dlgPad.PaddingRight = UDim.new(0, 14)
dlgPad.PaddingTop = UDim.new(0, 10) dlgPad.PaddingBottom = UDim.new(0, 12)
dlgPad.Parent = dlg
local dlgSpeaker = label(dlg, "", 14, BLUE, Enum.Font.GothamBlack, nil, UDim2.new(1, 0, 0, 18))
dlgSpeaker.LayoutOrder = 1
dlgSpeaker.ZIndex = 31
local dlgText = label(dlg, "", 15, Color3.new(1, 1, 1), Enum.Font.GothamMedium, nil, UDim2.new(1, 0, 0, 0))
dlgText.LayoutOrder = 2
dlgText.AutomaticSize = Enum.AutomaticSize.Y
dlgText.TextWrapped = true
dlgText.ZIndex = 31
local dlgOptions = Instance.new("Frame")
dlgOptions.LayoutOrder = 3
dlgOptions.BackgroundTransparency = 1
dlgOptions.Size = UDim2.new(1, 0, 0, 0)
dlgOptions.AutomaticSize = Enum.AutomaticSize.Y
dlgOptions.ZIndex = 31
dlgOptions.Parent = dlg
local dlgOptLayout = Instance.new("UIListLayout")
dlgOptLayout.Padding = UDim.new(0, 5)
dlgOptLayout.Parent = dlgOptions
local dlgTimer = bar(dlg, UDim2.new(), UDim2.new(1, 0, 0, 5), BLUE)
dlgTimer.Parent.LayoutOrder = 4
local dlgToken, dlgCount, dlgGen = nil, 0, 0

local function dlgClose()
	dlg.Visible = false
	dlgToken = nil
	for _, c in ipairs(dlgOptions:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
end

local function dlgPick(i)
	if not dlgToken then return end
	local token = dlgToken
	dlgClose()
	remotes.DialogReply:FireServer(token, i)
end

remotes:WaitForChild("Dialog").OnClientEvent:Connect(function(token, speaker, text, options, timeout)
	dlgClose()
	dlgGen += 1
	local mine = dlgGen
	dlgToken = token
	dlgCount = #options
	dlgSpeaker.Text = string.upper(speaker or "")
	dlgText.Text = text or ""
	for i, opt in ipairs(options) do
		local b = button(dlgOptions, i .. ".  " .. opt, UDim2.new(1, 0, 0, 0), Color3.fromRGB(24, 34, 56))
		b.AutomaticSize = Enum.AutomaticSize.Y
		b.TextWrapped = true
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.ZIndex = 32
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 10) pad.PaddingRight = UDim.new(0, 10)
		pad.PaddingTop = UDim.new(0, 7) pad.PaddingBottom = UDim.new(0, 7)
		pad.Parent = b
		b.Activated:Connect(function() dlgPick(i) end)
	end
	dlgTimer.Size = UDim2.fromScale(1, 1)
	TweenService:Create(dlgTimer, TweenInfo.new(timeout or 30, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
	dlg.Visible = true
	task.delay((timeout or 30) + 0.5, function()
		if dlgGen == mine and dlgToken == token then dlgClose() end
	end)
end)

