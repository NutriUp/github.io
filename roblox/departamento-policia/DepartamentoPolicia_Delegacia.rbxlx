wait(0)
if script.Parent.on.Value == true then
	
	for i = 1,#grp1 do
	grp1[i].Lighto.Enabled = true
	end
	
	wait (0.01)
	
	for i = 1,#grp1 do
	grp1[i].Lighto.Enabled = false
	end
	
	wait (0.01)
	
	
	for i = 1,#grp2 do
	grp2[i].Lighto.Enabled = true
	end
	
	wait (0.07)
	
	for i = 1,#grp2 do
	grp2[i].Lighto.Enabled = false
	end
	
	wait (0.07)
	
else
	for i = 1,#grp1 do
	grp1[i].Lighto.Enabled = false
	end
	for i = 1,#grp2 do
	grp2[i].Lighto.Enabled = false
	end
end
end]]></ProtectedString>
